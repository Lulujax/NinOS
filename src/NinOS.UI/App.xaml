<Application x:Class="NinOS.UI.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:sys="clr-namespace:System;assembly=mscorlib"
             xmlns:converters="clr-namespace:NinOS.UI.Converters"
             xmlns:common="clr-namespace:NinOS.UI.Common">
    <Application.Resources>
        <converters:StringToVisibilityConverter x:Key="StringToVisibilityConverter" />
        <converters:BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />
        <converters:InverseBooleanToVisibilityConverter x:Key="InverseBooleanToVisibilityConverter" />
        <converters:IntEqualsToVisibilityConverter x:Key="IntEqualsToVisibilityConverter" />

        <!--
            La barra horizontal aparece solo cuando la tabla realmente la necesita.
            Con "Auto" no se dibuja si todo entra, y si una columna se hace mas ancha
            de lo que entra, aparece en vez de cortar el texto.
        -->
        <Style TargetType="DataGrid">
            <Setter Property="CanUserReorderColumns" Value="False"/>
            <Setter Property="CanUserResizeColumns" Value="False"/>
            <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Auto"/>
        </Style>

        <!--
            Escala tipografica de la aplicacion.

            Para que el usuario decida el tamano de la letra y no haya que tocar Windows,
            todo el texto nuevo usa estos recursos en vez de un numero fijo:

                <TextBlock FontSize="{DynamicResource AppFontSize}" />

            Son DynamicResource (y no StaticResource) a proposito: asi, cuando mas adelante
            el usuario elija "Grande" o "Muy grande" en Ajustes, cambiar el valor del recurso
            alcanza para que toda la app cambie de tamaño en vivo.

            Regla de migracion: no se tocan las vistas viejas en un sweep masivo. Cada vista
            que se vaya tocando por otro motivo, se va convirtiendo de a poco. Ver
            docs/accesibilidad.md.

            Ojo al migrar: hoy el tamano mas usado en la app es 11 (94 veces) y 12.5 (61
            veces), asi que pasar a estos valores agranda el texto. Es el objetivo, pero hay
            que revisar que la vista siga entrando sin cortes ni scrolls nuevos.
        -->
        <sys:Double x:Key="AppFontSizeSmall">12</sys:Double>
        <sys:Double x:Key="AppFontSize">14</sys:Double>
        <sys:Double x:Key="AppFontSizeLarge">16</sys:Double>
        <sys:Double x:Key="AppFontSizeTitle">20</sys:Double>

        <!-- Estilo de los botones flecha para desplazamiento horizontal de pestañas -->
        <Style x:Key="TabScrollRepeatButtonStyle" TargetType="RepeatButton">
            <Setter Property="Width" Value="22"/>
            <Setter Property="Height" Value="24"/>
            <Setter Property="FontSize" Value="10"/>
            <Setter Property="Foreground" Value="#4A5568"/>
            <Setter Property="Background" Value="#EDF2F7"/>
            <Setter Property="BorderBrush" Value="#CBD5E0"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Margin" Value="2,0"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Interval" Value="60"/>
            <Setter Property="Delay" Value="250"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RepeatButton">
                        <Border x:Name="bd" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="3">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#E2E8F0"/>
                                <Setter TargetName="bd" Property="BorderBrush" Value="#718096"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#CBD5E0"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="bd" Property="Opacity" Value="0.35"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!--
            TabControl Global con altura fija y desplazamiento horizontal.
            Reemplaza el TabPanel nativo de WPF por un contenedor de una sola fila
            con ScrollViewer y botones flechas cuando las pestañas no entran en pantalla.
        -->
        <Style TargetType="{x:Type TabControl}">
            <Setter Property="common:ScrollableTabHelper.IsScrollable" Value="True"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="#D0D4DC"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type TabControl}">
                        <Grid KeyboardNavigation.TabNavigation="Local">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>

                            <!-- BARRA DE PESTAÑAS (Fila única con scroll) -->
                            <Grid Grid.Row="0" Margin="0,0,0,-1" Panel.ZIndex="1">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <RepeatButton x:Name="PART_ButtonScrollLeft"
                                              Grid.Column="0"
                                              Style="{StaticResource TabScrollRepeatButtonStyle}"
                                              Content="&#x25C0;"
                                              ToolTip="Desplazar pestañas a la izquierda"
                                              Visibility="Collapsed"/>

                                <ScrollViewer x:Name="PART_ScrollViewer"
                                              Grid.Column="1"
                                              HorizontalScrollBarVisibility="Hidden"
                                              VerticalScrollBarVisibility="Disabled"
                                              CanContentScroll="False"
                                              Focusable="False">
                                    <StackPanel Orientation="Horizontal" IsItemsHost="True"/>
                                </ScrollViewer>

                                <RepeatButton x:Name="PART_ButtonScrollRight"
                                              Grid.Column="2"
                                              Style="{StaticResource TabScrollRepeatButtonStyle}"
                                              Content="&#x25B6;"
                                              ToolTip="Desplazar pestañas a la derecha"
                                              Visibility="Collapsed"/>
                            </Grid>

                            <!-- ÁREA DE CONTENIDO DE LA PESTAÑA SELECCIONADA -->
                            <Border Grid.Row="1"
                                    Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}">
                                <ContentPresenter x:Name="PART_SelectedContentHost"
                                                  ContentSource="SelectedContent"
                                                  Margin="{TemplateBinding Padding}"
                                                  SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}"/>
                            </Border>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

    </Application.Resources>
</Application>