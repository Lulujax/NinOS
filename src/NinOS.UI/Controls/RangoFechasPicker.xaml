<UserControl x:Class="NinOS.UI.Controls.RangoFechasPicker"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="Transparent">
    <StackPanel x:Name="Contenedor" Orientation="Horizontal" VerticalAlignment="Center">
        <StackPanel x:Name="FilaDesde" Orientation="Horizontal" VerticalAlignment="Center">
            <TextBlock Text="Desde:" VerticalAlignment="Center" Margin="0,0,4,0"/>
            <Grid Width="150" Height="25">
                <DatePicker x:Name="DesdePicker" Height="25"
                            SelectedDateChanged="OnFechaCambiada"
                            DateValidationError="OnFechaInvalida"
                            GotFocus="OnCampoEnFoco"
                            LostFocus="OnCampoSinFoco"/>
                <Border x:Name="DesdeMarcador" Background="White" IsHitTestVisible="False"
                        Margin="1,1,22,1" HorizontalAlignment="Stretch">
                    <TextBlock Text="Desde el inicio" Foreground="#8A96A0" FontStyle="Italic"
                               VerticalAlignment="Center" Margin="5,0,0,0"/>
                </Border>
                <Button x:Name="DesdeLimpiar" Content="✕" Width="18" Height="18" HorizontalAlignment="Right"
                        VerticalAlignment="Center" Margin="0,0,24,0" Padding="0" FontSize="9"
                        Background="Transparent" BorderThickness="0" Cursor="Hand"
                        ToolTip="Quitar la fecha Desde (sin límite)" Click="OnLimpiarDesde"/>
            </Grid>
        </StackPanel>

        <StackPanel x:Name="FilaHasta" Orientation="Horizontal" VerticalAlignment="Center">
            <TextBlock Text="Hasta:" VerticalAlignment="Center" Margin="0,0,4,0"/>
            <Grid Width="150" Height="25">
                <DatePicker x:Name="HastaPicker" Height="25"
                            SelectedDateChanged="OnFechaCambiada"
                            DateValidationError="OnFechaInvalida"
                            GotFocus="OnCampoEnFoco"
                            LostFocus="OnCampoSinFoco"/>
                <Border x:Name="HastaMarcador" Background="White" IsHitTestVisible="False"
                        Margin="1,1,22,1" HorizontalAlignment="Stretch">
                    <TextBlock Text="Hasta hoy" Foreground="#8A96A0" FontStyle="Italic"
                               VerticalAlignment="Center" Margin="5,0,0,0"/>
                </Border>
                <Button x:Name="HastaLimpiar" Content="✕" Width="18" Height="18" HorizontalAlignment="Right"
                        VerticalAlignment="Center" Margin="0,0,24,0" Padding="0" FontSize="9"
                        Background="Transparent" BorderThickness="0" Cursor="Hand"
                        ToolTip="Quitar la fecha Hasta (sin límite)" Click="OnLimpiarHasta"/>
            </Grid>
        </StackPanel>
    </StackPanel>
</UserControl>
