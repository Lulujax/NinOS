<Window x:Class="NinOS.UI.Views.AddProductWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Producto" Width="600"
        WindowStartupLocation="CenterOwner" Background="#F5F5F5"
        ResizeMode="CanResizeWithGrip" FontSize="12" MinHeight="360" MinWidth="560">
    <Window.Style>
        <Style TargetType="Window">
            <Setter Property="Height" Value="480"/>
            <Style.Triggers>
                <!-- El apartado de ajuste de stock agrega filas: la ventana crece con el.
                     Si no cabe en la pantalla, el codigo de atras la recorta al area de
                     trabajo y el ScrollViewer se encarga del resto. -->
                <DataTrigger Binding="{Binding is_stock_addition_mode}" Value="True">
                    <Setter Property="Height" Value="620"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </Window.Style>

    <Grid Margin="14">
        <Grid.RowDefinitions>
            <!-- Todo el formulario va dentro del scroll: en pantallas bajas se puede
                 llegar a cada campo en vez de quedar recortado. -->
            <RowDefinition Height="*"/>
            <!-- Error y botones quedan fijos abajo, siempre visibles. -->
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <ScrollViewer Grid.Row="0" VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled"
                      Padding="0,0,6,0" Focusable="False">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- TITULO: la ventana siempre es Nuevo/Editar Producto; el apartado de stock
                     lleva su propio encabezado mas abajo. -->
                <TextBlock Grid.Row="0" FontSize="14" FontWeight="Bold" Foreground="#C62828" Margin="0,0,0,10">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Text" Value="Nuevo Producto"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding is_editing_product}" Value="True">
                                    <Setter Property="Text" Value="Editar Producto"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>

                <!-- CODIGO -->
                <Grid Grid.Row="1" Margin="0,0,0,6">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="170"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" VerticalAlignment="Center">
                        <TextBlock.Style>
                            <!-- BasedOn obligatorio: sin el, el TextBlock se queda sin el estilo del tema. -->
                            <Style TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
                                <Setter Property="Text" Value="Codigo:"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding code_is_locked}" Value="True">
                                        <Setter Property="Foreground" Value="#757575"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                    <StackPanel Grid.Column="1">
                        <TextBox x:Name="CodeBox" Height="26" FontSize="11" VerticalContentAlignment="Center"
                                 Padding="4,0" MaxLength="20"
                                 Text="{Binding new_code, UpdateSourceTrigger=PropertyChanged}"
                                 IsReadOnly="{Binding code_is_locked}">
                            <TextBox.Style>
                                <!-- BasedOn obligatorio: sin el, el TextBox pierde borde y fondo del tema. -->
                                <Style TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding code_is_locked}" Value="True">
                                            <Setter Property="Background" Value="#EEEEEE"/>
                                            <Setter Property="Foreground" Value="#616161"/>
                                            <Setter Property="ToolTip" Value="El codigo no se puede cambiar mientras el apartado de stock esta abierto."/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBox.Style>
                        </TextBox>

                        <!-- Aviso de cambio de marca: el codigo que le tocaria en la marca destino -->
                        <TextBlock Text="{Binding brand_change_warning_display}" FontSize="10" Foreground="#C62828"
                                   Margin="2,3,0,0" TextWrapping="Wrap"
                                   Visibility="{Binding has_pending_brand_change, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                    </StackPanel>
                </Grid>

                <!-- NOMBRE -->
                <Grid Grid.Row="2" Margin="0,0,0,6">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="170"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" VerticalAlignment="Center">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding name_is_locked}" Value="True">
                                        <Setter Property="Foreground" Value="#757575"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                        <Run Text="Nombre:"/><Run Text=" *" Foreground="Red"/>
                    </TextBlock>
                    <TextBox x:Name="NameBox" Grid.Column="1" Height="26" FontSize="11" VerticalContentAlignment="Center"
                             Padding="4,0" MaxLength="150"
                             Text="{Binding new_name, UpdateSourceTrigger=PropertyChanged}"
                             IsReadOnly="{Binding name_is_locked}">
                        <TextBox.Style>
                            <Style TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding name_is_locked}" Value="True">
                                        <Setter Property="Background" Value="#EEEEEE"/>
                                        <Setter Property="Foreground" Value="#616161"/>
                                        <Setter Property="ToolTip" Value="El nombre no se puede cambiar mientras el apartado de stock esta abierto."/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBox.Style>
                    </TextBox>
                </Grid>

                <!-- CATEGORIA -->
                <Grid Grid.Row="3" Margin="0,0,0,6">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="170"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" VerticalAlignment="Center"><Run Text="Categoria:"/><Run Text=" *" Foreground="Red"/></TextBlock>
                    <ComboBox x:Name="CategoryCombo" Grid.Column="1" Height="26" FontSize="11" Width="240"
                              HorizontalAlignment="Left" HorizontalContentAlignment="Left"
                              ItemsSource="{Binding category_options}"
                              SelectedItem="{Binding new_category, UpdateSourceTrigger=PropertyChanged}"
                              IsEnabled="{Binding can_edit_category}">
                        <ComboBox.ToolTip>
                            <TextBlock Text="Marca o linea a la que pertenece el producto. Al cambiarla en un producto que ya existe, el sistema le reasigna el codigo de la marca nueva."/>
                        </ComboBox.ToolTip>
                    </ComboBox>
                </Grid>

                <!-- STOCK: fila propia y a todo el ancho. Antes compartia fila con el precio y los
                     botones no entraban en la columna que quedaba. -->
                <Grid Grid.Row="4" Margin="0,0,0,6">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="170"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock VerticalAlignment="Center">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
                                    <Setter Property="Text" Value="Cantidad inicial:"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding is_editing_product}" Value="True">
                                            <Setter Property="Text" Value="Stock actual:"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                        <!-- El asterisco solo en producto nuevo: al editar el stock no se escribe. -->
                        <TextBlock VerticalAlignment="Center" Foreground="Red" Text=" *"
                                   Visibility="{Binding show_initial_quantity_box, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                    </StackPanel>

                    <!-- Producto nuevo: la cantidad inicial se escribe a mano. -->
                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center"
                                Visibility="{Binding show_initial_quantity_box, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <TextBox x:Name="QuantityBox" Height="26" FontSize="11" VerticalContentAlignment="Center"
                                 Padding="4,0" MaxLength="6" Width="120" PreviewTextInput="OnQuantityPreview"
                                 Text="{Binding new_quantity, UpdateSourceTrigger=PropertyChanged}"/>
                        <TextBlock VerticalAlignment="Center" Margin="8,0,0,0" FontSize="10" Foreground="#757575"
                                   TextWrapping="Wrap" MaxWidth="230"
                                   Text="Existencias con las que arranca el producto."/>
                    </StackPanel>

                    <!-- Producto existente: el stock es de solo lectura y solo se mueve con
                         Agregar/Quitar. Los botones quedan siempre visibles para poder cambiar de
                         direccion sin cerrar el apartado y perder lo tecleado. -->
                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center"
                                Visibility="{Binding is_editing_product, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <Border Background="#EEEEEE" CornerRadius="3" Height="26" Padding="8,0" MinWidth="70">
                            <TextBlock Text="{Binding new_quantity}" FontWeight="Bold" FontSize="12"
                                       VerticalAlignment="Center" Foreground="#424242"/>
                        </Border>

                        <Button x:Name="AddStockButton" Content="Agregar Stock" Height="26" Padding="10,0" Margin="10,0,0,0"
                                BorderThickness="0" Cursor="Hand" FontSize="11" FontWeight="SemiBold"
                                Command="{Binding open_stock_section_command}" CommandParameter="add"
                                ToolTip="Suma existencias al producto y lo registra en el kardex">
                            <Button.Style>
                                <Style TargetType="Button">
                                    <Setter Property="Background" Value="#FF8F00"/>
                                    <Setter Property="Foreground" Value="White"/>
                                    <Style.Triggers>
                                        <!-- Direccion activa: se marca para que se vea cual esta en curso. -->
                                        <MultiDataTrigger>
                                            <MultiDataTrigger.Conditions>
                                                <Condition Binding="{Binding is_stock_addition_mode}" Value="True"/>
                                                <Condition Binding="{Binding is_stock_removal_mode}" Value="False"/>
                                            </MultiDataTrigger.Conditions>
                                            <Setter Property="Background" Value="#E65100"/>
                                            <Setter Property="BorderThickness" Value="2"/>
                                            <Setter Property="BorderBrush" Value="#3E2723"/>
                                        </MultiDataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                        </Button>

                        <Button x:Name="RemoveStockButton" Content="Quitar Stock" Height="26" Padding="10,0" Margin="6,0,0,0"
                                BorderThickness="0" Cursor="Hand" FontSize="11" FontWeight="SemiBold"
                                Command="{Binding open_stock_section_command}" CommandParameter="remove"
                                ToolTip="Resta existencias al producto y lo registra en el kardex">
                            <Button.Style>
                                <Style TargetType="Button">
                                    <Setter Property="Background" Value="#D32F2F"/>
                                    <Setter Property="Foreground" Value="White"/>
                                    <Style.Triggers>
                                        <MultiDataTrigger>
                                            <MultiDataTrigger.Conditions>
                                                <Condition Binding="{Binding is_stock_addition_mode}" Value="True"/>
                                                <Condition Binding="{Binding is_stock_removal_mode}" Value="True"/>
                                            </MultiDataTrigger.Conditions>
                                            <Setter Property="Background" Value="#B71C1C"/>
                                            <Setter Property="BorderThickness" Value="2"/>
                                            <Setter Property="BorderBrush" Value="#3E2723"/>
                                        </MultiDataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                        </Button>
                    </StackPanel>
                </Grid>

                <!-- PRECIO -->
                <Grid Grid.Row="5" Margin="0,0,0,6">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="170"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="{Binding price_field_label, FallbackValue='Precio ($):'}" VerticalAlignment="Center"/>
                        <TextBlock Text=" *" Foreground="Red" VerticalAlignment="Center"/>
                    </StackPanel>
                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBox x:Name="PriceBox" Height="26" FontSize="11" VerticalContentAlignment="Center"
                                 Padding="4,0" MaxLength="10" Width="120" HorizontalAlignment="Left"
                                 PreviewTextInput="OnPricePreview"
                                 Text="{Binding new_price, UpdateSourceTrigger=PropertyChanged}"/>
                        <TextBlock VerticalAlignment="Center" Margin="8,0,0,0" FontSize="10" Foreground="#757575"
                                   TextWrapping="Wrap" MaxWidth="250"
                                   Text="{Binding price_field_hint}"
                                   Visibility="{Binding is_custom_list_selected, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                    </StackPanel>
                </Grid>

                <!-- APARTADO DE AJUSTE DE STOCK (se despliega con Agregar/Quitar Stock) -->
                <Border Grid.Row="6" Margin="0,4,0,6" Background="#FAFAFA" BorderBrush="#E0E0E0" BorderThickness="1"
                        CornerRadius="4" Padding="12,10"
                        Visibility="{Binding is_stock_addition_mode, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <StackPanel>
                        <!-- Encabezado del apartado -->
                        <Grid Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" FontSize="12.5" FontWeight="Bold" VerticalAlignment="Center">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Text" Value="Agregar Stock"/>
                                        <Setter Property="Foreground" Value="#E65100"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding is_stock_removal_mode}" Value="True">
                                                <Setter Property="Text" Value="Quitar Stock"/>
                                                <Setter Property="Foreground" Value="#C62828"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>

                            <!-- Cerrar el apartado. Con plantilla propia: sin ella WPF dibuja el
                                 boton con su caja gris por defecto y desentona con el resto. -->
                            <Button Grid.Column="1" Width="22" Height="22" Cursor="Hand" Focusable="False"
                                    Command="{Binding close_stock_section_command}"
                                    ToolTip="Cerrar el apartado de stock (Esc)">
                                <Button.Template>
                                    <ControlTemplate TargetType="Button">
                                        <Border x:Name="bd" Background="Transparent" CornerRadius="3">
                                            <TextBlock Text="&#x2715;" FontSize="10" Foreground="#757575"
                                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="bd" Property="Background" Value="#E0E0E0"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Button.Template>
                            </Button>
                        </Grid>

                        <Grid Margin="0,0,0,6">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="157"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" VerticalAlignment="Center" Text="Stock actual:"/>
                            <TextBlock Grid.Column="1" VerticalAlignment="Center" FontWeight="Bold"
                                       Text="{Binding stock_addition_current_quantity}"/>
                        </Grid>

                        <Grid Margin="0,0,0,6">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="157"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" VerticalAlignment="Center">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
                                        <Setter Property="Text" Value="Cantidad a agregar:"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding is_stock_removal_mode}" Value="True">
                                                <Setter Property="Text" Value="Cantidad a quitar:"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBox x:Name="StockMoveBox" Height="26" FontSize="11" VerticalContentAlignment="Center"
                                         Padding="4,0" MaxLength="6" Width="120"
                                         PreviewTextInput="OnQuantityPreview"
                                         Text="{Binding stock_addition_quantity, UpdateSourceTrigger=PropertyChanged}"/>
                                <TextBlock VerticalAlignment="Center" Margin="8,0,0,0" FontSize="10" Foreground="#C62828"
                                           TextWrapping="Wrap" MaxWidth="230"
                                           Visibility="{Binding stock_addition_exceeds_stock, Converter={StaticResource BooleanToVisibilityConverter}}"
                                           Text="No hay suficiente stock para quitar esa cantidad."/>
                            </StackPanel>
                        </Grid>

                        <Grid Margin="0,0,0,6">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="157"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" VerticalAlignment="Center" Text="Total resultante:"/>
                            <TextBlock Grid.Column="1" VerticalAlignment="Center" FontWeight="Bold" FontSize="13"
                                       Text="{Binding stock_addition_total_display}">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Foreground" Value="#2E7D32"/>
                                        <Style.Triggers>
                                            <!-- Si el ajuste no es posible no se pinta un total en verde. -->
                                            <DataTrigger Binding="{Binding stock_addition_exceeds_stock}" Value="True">
                                                <Setter Property="Foreground" Value="#9E9E9E"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </Grid>

                        <!-- Motivo del ajuste: etiqueta a la izquierda, como el resto de los
                             campos, y el combo en la misma columna que las cajas de arriba. -->
                        <Grid Margin="0,0,0,6">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="157"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" VerticalAlignment="Center"><Run Text="Motivo del ajuste:"/><Run Text=" *" Foreground="Red"/></TextBlock>
                            <ComboBox Grid.Column="1" Height="26" FontSize="11" Width="300" HorizontalAlignment="Left"
                                      HorizontalContentAlignment="Left"
                                      ItemsSource="{Binding adjustment_reason_display_options}"
                                      SelectedIndex="{Binding adjustment_reason_index, UpdateSourceTrigger=PropertyChanged}"
                                      ToolTip="Queda registrado en el historial del producto como entrada o salida de inventario"/>
                        </Grid>
                    </StackPanel>
                </Border>

                <TextBlock Grid.Row="7" FontSize="9.5" Foreground="#757575" Margin="2,0,0,0" TextWrapping="Wrap"
                           Text="El codigo se puede escribir a mano, pero debe respetar el estandar de la marca (prefijo + 5 digitos). Si cambias la marca de un producto que ya existe, el sistema le asigna el codigo siguiente de la marca nueva."/>
            </Grid>
        </ScrollViewer>

        <Border Grid.Row="1" Background="#FDECEA" CornerRadius="3" Padding="10,6" Margin="0,6,0,0"
                Visibility="{Binding ErrorMessage, Converter={StaticResource StringToVisibilityConverter}}">
            <TextBlock Text="{Binding ErrorMessage}" FontSize="11" Foreground="#C62828" TextWrapping="Wrap"/>
        </Border>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
            <Button Content="Guardar" Height="30" Padding="18,0" Margin="0,0,8,0"
                    Background="#2E7D32" Foreground="White" BorderThickness="0" Cursor="Hand"
                    FontWeight="SemiBold" Command="{Binding save_product_command}"/>
            <Button Content="Cancelar" Height="30" Padding="18,0" Click="OnCancelClick"
                    Background="#E0E0E0" Foreground="#424242" BorderThickness="1" BorderBrush="#BDBDBD"
                    Cursor="Hand"/>
        </StackPanel>
    </Grid>
</Window>
