<Window x:Class="NinOS.UI.Views.AddProductWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Producto" Height="470" Width="600"
        WindowStartupLocation="CenterOwner" Background="#F5F5F5"
        ResizeMode="NoResize" FontSize="12" MinHeight="450" MinWidth="560">
    <Grid Margin="14">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- TITULO -->
        <TextBlock Grid.Row="0" FontSize="14" FontWeight="Bold" Foreground="#C62828" Margin="0,0,0,10">
            <TextBlock.Style>
                <Style TargetType="TextBlock">
                    <Setter Property="Text" Value="Nuevo Producto"/>
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding is_editing_product}" Value="True">
                            <Setter Property="Text" Value="Editar Producto"/>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </TextBlock.Style>
        </TextBlock>

        <!-- CODIGO -->
        <Grid Grid.Row="1" Margin="0,0,0,6">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="170"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0" VerticalAlignment="Center"><Run Text="Codigo:"/><Run Text=" *" Foreground="Red"/></TextBlock>
            <TextBox x:Name="CodeBox" Grid.Column="1" Height="26" FontSize="11" VerticalContentAlignment="Center"
                     Padding="4,0" MaxLength="20"
                     Text="{Binding new_code, UpdateSourceTrigger=PropertyChanged}"
                     ToolTip="Codigo del producto en el inventario"/>
        </Grid>

        <!-- NOMBRE -->
        <Grid Grid.Row="2" Margin="0,0,0,6">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="170"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0" VerticalAlignment="Center"><Run Text="Nombre:"/><Run Text=" *" Foreground="Red"/></TextBlock>
            <TextBox x:Name="NameBox" Grid.Column="1" Height="26" FontSize="11" VerticalContentAlignment="Center"
                     Padding="4,0" MaxLength="150"
                     Text="{Binding new_name, UpdateSourceTrigger=PropertyChanged}"/>
        </Grid>

        <!-- CATEGORIA -->
        <Grid Grid.Row="3" Margin="0,0,0,6">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="170"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0" VerticalAlignment="Center"><Run Text="Categoria:"/><Run Text=" *" Foreground="Red"/></TextBlock>
            <ComboBox x:Name="CategoryCombo" Grid.Column="1" Height="26" FontSize="11" Width="240"
                      HorizontalAlignment="Left" HorizontalContentAlignment="Left"
                      ItemsSource="{Binding category_options}"
                      SelectedItem="{Binding new_category, UpdateSourceTrigger=PropertyChanged}"
                      IsEnabled="{Binding can_edit_category}"
                      ToolTip="Marca o linea a la que pertenece el producto"/>
        </Grid>

        <!-- CANTIDAD Y PRECIO -->
        <Grid Grid.Row="4" Margin="0,0,0,6">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="170"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="110"/>
                <ColumnDefinition Width="150"/>
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0" VerticalAlignment="Center"><Run Text="Cantidad:"/><Run Text=" *" Foreground="Red"/></TextBlock>
            <TextBox x:Name="QuantityBox" Grid.Column="1" Height="26" FontSize="11" VerticalContentAlignment="Center"
                     Padding="4,0" MaxLength="6" Margin="0,0,10,0" PreviewTextInput="OnQuantityPreview"
                     Text="{Binding new_quantity, UpdateSourceTrigger=PropertyChanged}"/>
            <TextBlock Grid.Column="2" VerticalAlignment="Center" HorizontalAlignment="Right" Margin="0,0,8,0">
                <Run Text="Precio ($):"/><Run Text=" *" Foreground="Red"/>
            </TextBlock>
            <TextBox x:Name="PriceBox" Grid.Column="3" Height="26" FontSize="11" VerticalContentAlignment="Center"
                     Padding="4,0" MaxLength="10" PreviewTextInput="OnPricePreview"
                     Text="{Binding new_price, UpdateSourceTrigger=PropertyChanged}"/>
        </Grid>

        <TextBlock Grid.Row="5" FontSize="9.5" Foreground="#757575" Margin="2,0,0,0" TextWrapping="Wrap"
                   Text="En la pestana Todos se puede cambiar la categoria. En las demas queda fija segun la pestana donde esta el producto."/>

        <Border Grid.Row="6" Background="#FDECEA" CornerRadius="3" Padding="10,6" Margin="0,6,0,0"
                Visibility="{Binding ErrorMessage, Converter={StaticResource StringToVisibilityConverter}}">
            <TextBlock Text="{Binding ErrorMessage}" FontSize="11" Foreground="#C62828" TextWrapping="Wrap"/>
        </Border>

        <StackPanel Grid.Row="7" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
            <Button Content="Guardar" Height="30" Padding="18,0" Margin="0,0,8,0"
                    Background="#2E7D32" Foreground="White" BorderThickness="0" Cursor="Hand"
                    FontWeight="SemiBold" Command="{Binding save_product_command}"/>
            <Button Content="Cancelar" Height="30" Padding="18,0" Click="OnCancelClick"
                    Background="#E0E0E0" Foreground="#424242" BorderThickness="1" BorderBrush="#BDBDBD"
                    Cursor="Hand"/>
        </StackPanel>
    </Grid>
</Window>
