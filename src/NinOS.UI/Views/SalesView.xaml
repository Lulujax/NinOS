<UserControl x:Class="NinOS.UI.Views.SalesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d" Background="White">
    <UserControl.Resources>
        <Style x:Key="CompactDataGrid" TargetType="DataGrid">
            <Setter Property="AutoGenerateColumns" Value="False"/>
            <Setter Property="IsReadOnly" Value="True"/>
            <Setter Property="GridLinesVisibility" Value="Horizontal"/>
            <Setter Property="HeadersVisibility" Value="Column"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush" Value="#E0E0E0"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="RowHeaderWidth" Value="0"/>
            <Setter Property="CanUserAddRows" Value="False"/>
            <Setter Property="CanUserDeleteRows" Value="False"/>
            <Setter Property="SelectionMode" Value="Single"/>
            <Setter Property="EnableRowVirtualization" Value="True"/>
            <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Auto"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="MinRowHeight" Value="20"/>
        </Style>
        <Style x:Key="CellText" TargetType="TextBlock">
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
        </Style>
        <Style x:Key="CellTextCenter" TargetType="TextBlock" BasedOn="{StaticResource CellText}">
            <Setter Property="HorizontalAlignment" Value="Center"/>
            <Setter Property="TextAlignment" Value="Center"/>
        </Style>
        <Style x:Key="CellTextWrap" TargetType="TextBlock" BasedOn="{StaticResource CellText}">
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="TextTrimming" Value="None"/>
        </Style>
        <Style x:Key="BlueComboBox" TargetType="ComboBox">
            <Setter Property="Height" Value="26"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid>
                            <ToggleButton x:Name="ToggleButton" Focusable="False" ClickMode="Press"
                                          IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}">
                                <ToggleButton.Template>
                                    <ControlTemplate TargetType="ToggleButton">
                                        <Border x:Name="bd" Background="#00897B" BorderBrush="#00695C"
                                                BorderThickness="1" CornerRadius="3" Padding="8,0">
                                            <ContentPresenter/>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="bd" Property="Background" Value="#26A69A"/>
                                            </Trigger>
                                            <Trigger Property="IsChecked" Value="True">
                                                <Setter TargetName="bd" Property="Background" Value="#00695C"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </ToggleButton.Template>
                            </ToggleButton>
                            <ContentPresenter x:Name="ContentSite" Margin="8,0,20,0" VerticalAlignment="Center"
                                              HorizontalAlignment="Center" IsHitTestVisible="False"
                                              Content="{TemplateBinding SelectionBoxItem}"
                                              ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"/>
                            <Path x:Name="Arrow" Data="M 0 0 L 8 0 L 4 5 Z" Fill="White"
                                  HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,8,0" IsHitTestVisible="False"/>
                            <Popup IsOpen="{TemplateBinding IsDropDownOpen}" Placement="Bottom" AllowsTransparency="True"
                                   Focusable="False" PopupAnimation="Slide">
                                <Border MinWidth="{Binding ActualWidth, ElementName=ContentSite}"
                                        MaxHeight="{TemplateBinding MaxDropDownHeight}"
                                        Background="White" BorderBrush="#00695C" BorderThickness="1" CornerRadius="3">
                                    <ScrollViewer>
                                        <ItemsPresenter/>
                                    </ScrollViewer>
                                </Border>
                            </Popup>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>
    <Grid Margin="6">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- FILA 0: HEADER - titulo + busqueda + mes + filtro -->
        <WrapPanel Grid.Row="0" Margin="0,0,0,6">
            <TextBlock Text="VENTAS" FontSize="16.5" FontWeight="Bold"
                       Foreground="#00897B" VerticalAlignment="Center" Margin="0,0,12,6"/>

            <!-- Busqueda -->
            <Grid Width="260" Margin="0,0,8,6" VerticalAlignment="Center">
                <Border Background="White" CornerRadius="4" BorderBrush="#E0E0E0" BorderThickness="1">
                    <Grid>
                        <TextBlock Text="&#x1F50D;" Margin="8,0,0,0" VerticalAlignment="Center" FontSize="13.5" Foreground="#9E9E9E"/>
                        <TextBox x:Name="txt_search" Margin="26,2,22,2" BorderThickness="0" Background="Transparent"
                                 VerticalContentAlignment="Center" FontSize="12.5"
                                 Text="{Binding search_query, UpdateSourceTrigger=PropertyChanged}"
                                 TextChanged="txt_search_TextChanged"/>
                        <Button x:Name="btn_clear_search" Content="&#x2715;" Margin="0,0,4,0"
                                HorizontalAlignment="Right" Width="20" Height="20"
                                Cursor="Hand" Visibility="Collapsed" Click="btn_clear_search_Click">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border Background="Transparent" Padding="2">
                                        <TextBlock Text="{TemplateBinding Content}" FontSize="10.5" Foreground="#9E9E9E"
                                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>
                    </Grid>
                </Border>
            </Grid>

            <!-- Mes + Filtro -->
                <ComboBox x:Name="cmb_month" Margin="0,0,8,6" MinWidth="110" VerticalAlignment="Center"
                          ItemsSource="{Binding pending_months}"
                          SelectedItem="{Binding selected_month}"
                          FontSize="12.5" Height="26"
                          HorizontalContentAlignment="Center"/>

                <Button Content="Reporte Mes" Background="#1B3A2D" Foreground="White"
                        Margin="0,0,0,6" VerticalAlignment="Center"
                        FontWeight="SemiBold" Padding="10,4" BorderThickness="0" Cursor="Hand"
                        Command="{Binding month_report_command}" FontSize="12.5">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="bd" Background="{TemplateBinding Background}" CornerRadius="4" Padding="{TemplateBinding Padding}">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="bd" Property="Background" Value="#2E5A46"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Button.Template>
                </Button>
        </WrapPanel>

        <!-- FILA 1: TABS DE VENDEDORAS -->
        <TabControl Grid.Row="2" SelectedIndex="{Binding selected_tab_index, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,4">

            <TabItem>
                <TabItem.Header>
                    <TextBlock Text="Todos" FontWeight="SemiBold" FontSize="12.5"/>
                </TabItem.Header>
                <DataGrid Style="{StaticResource CompactDataGrid}" ItemsSource="{Binding all_notes}"
                          PreviewMouseDoubleClick="DataGrid_PreviewMouseDoubleClick">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="NRO" Binding="{Binding note_number}" Width="70"
                          ElementStyle="{StaticResource CellTextCenter}"/>
                        <DataGridTextColumn Header="VENDEDOR" Binding="{Binding seller_name}" Width="75"
                          ElementStyle="{StaticResource CellTextCenter}"/>
                        <DataGridTextColumn Header="CLIENTE" Binding="{Binding customer_name}" Width="*"
                          ElementStyle="{StaticResource CellTextWrap}"/>
                        <DataGridTextColumn Header="TOTAL" Binding="{Binding total_amount_usd, StringFormat=F2}" Width="80"
                          ElementStyle="{StaticResource CellTextCenter}"/>
                        <DataGridTextColumn Header="ESTADO" Binding="{Binding status}" Width="80">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="HorizontalAlignment" Value="Center"/>
                                    <Setter Property="FontWeight" Value="Bold"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding status}" Value="Pagada">
                                            <Setter Property="Foreground" Value="#2E7D32"/>
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding status}" Value="Pendiente">
                                            <Setter Property="Foreground" Value="#F57C00"/>
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding status}" Value="Anulada">
                                            <Setter Property="Foreground" Value="#9E9E9E"/>
                                            <Setter Property="FontStyle" Value="Italic"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>
                        <DataGridTextColumn Header="FECHA" Binding="{Binding creation_date, StringFormat=dd/MM/yy}" Width="70"
                          ElementStyle="{StaticResource CellTextCenter}"/>
                        <DataGridTemplateColumn Header="OBSERVACION" Width="170">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Grid>
                                        <TextBlock Text="{Binding sales_observations}" ToolTip="{Binding sales_observations}" TextWrapping="Wrap"
                                                   TextTrimming="CharacterEllipsis" VerticalAlignment="Center" Cursor="Hand">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding is_editing_observations}" Value="True">
                                                            <Setter Property="Visibility" Value="Collapsed"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                        <TextBox Text="{Binding sales_observations, UpdateSourceTrigger=PropertyChanged}" MaxLength="500"
                                                 TextWrapping="Wrap" VerticalAlignment="Center" Background="#FFFDE7"
                                                 KeyDown="ObsTextBox_KeyDown" LostKeyboardFocus="ObsTextBox_LostKeyboardFocus">
                                            <TextBox.Style>
                                                <Style TargetType="TextBox">
                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding is_editing_observations}" Value="True">
                                                            <Setter Property="Visibility" Value="Visible"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBox.Style>
                                        </TextBox>
                                    </Grid>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTemplateColumn Header="ACCIONES" Width="140">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                        <Button Content="Vista Previa" FontSize="11.5" Padding="6,2" Margin="0,0,4,0" Cursor="Hand"
                                                Background="#F5F5F5" BorderThickness="1" BorderBrush="#E0E0E0" Foreground="#424242"
