<UserControl x:Class="NinOS.UI.Views.SalesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d" Background="White">
    <UserControl.Resources>
        <Style x:Key="CompactDataGrid" TargetType="DataGrid">
            <Setter Property="AutoGenerateColumns" Value="False"/>
            <Setter Property="IsReadOnly" Value="True"/>
            <Setter Property="GridLinesVisibility" Value="Horizontal"/>
            <Setter Property="HeadersVisibility" Value="Column"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush" Value="#E0E0E0"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="RowHeaderWidth" Value="0"/>
            <Setter Property="CanUserAddRows" Value="False"/>
            <Setter Property="CanUserDeleteRows" Value="False"/>
            <Setter Property="CanUserReorderColumns" Value="False"/>
            <Setter Property="CanUserResizeColumns" Value="False"/>
            <Setter Property="SelectionMode" Value="Single"/>
            <Setter Property="EnableRowVirtualization" Value="True"/>
            <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Auto"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="MinRowHeight" Value="20"/>
        </Style>
        <Style x:Key="CellText" TargetType="TextBlock">
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
        </Style>
        <Style x:Key="CellTextCenter" TargetType="TextBlock" BasedOn="{StaticResource CellText}">
            <Setter Property="HorizontalAlignment" Value="Center"/>
            <Setter Property="TextAlignment" Value="Center"/>
        </Style>
        <Style x:Key="CellTextWrap" TargetType="TextBlock" BasedOn="{StaticResource CellText}">
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="TextTrimming" Value="None"/>
            <Setter Property="VerticalAlignment" Value="Top"/>
        </Style>
        <Style x:Key="BlueComboBox" TargetType="ComboBox">
            <Setter Property="Height" Value="26"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid>
                            <ToggleButton x:Name="ToggleButton" Focusable="False" ClickMode="Press"
                                          IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}">
                                <ToggleButton.Template>
                                    <ControlTemplate TargetType="ToggleButton">
                                        <Border x:Name="bd" Background="#00897B" BorderBrush="#00695C"
                                                BorderThickness="1" CornerRadius="3" Padding="8,0">
                                            <ContentPresenter/>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="bd" Property="Background" Value="#26A69A"/>
                                            </Trigger>
                                            <Trigger Property="IsChecked" Value="True">
                                                <Setter TargetName="bd" Property="Background" Value="#00695C"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </ToggleButton.Template>
                            </ToggleButton>
                            <ContentPresenter x:Name="ContentSite" Margin="8,0,20,0" VerticalAlignment="Center"
                                              HorizontalAlignment="Center" IsHitTestVisible="False"
                                              Content="{TemplateBinding SelectionBoxItem}"
                                              ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"/>
                            <Path x:Name="Arrow" Data="M 0 0 L 8 0 L 4 5 Z" Fill="White"
                                  HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,8,0" IsHitTestVisible="False"/>
                            <Popup IsOpen="{TemplateBinding IsDropDownOpen}" Placement="Bottom" AllowsTransparency="True"
                                   Focusable="False" PopupAnimation="Slide">
                                <Border MinWidth="{Binding ActualWidth, ElementName=ContentSite}"
                                        MaxHeight="{TemplateBinding MaxDropDownHeight}"
                                        Background="White" BorderBrush="#00695C" BorderThickness="1" CornerRadius="3">
                                    <ScrollViewer>
                                        <ItemsPresenter/>
                                    </ScrollViewer>
                                </Border>
                            </Popup>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>
    <Grid Margin="6">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- FILA 0: HEADER - titulo + busqueda + mes + filtro -->
        <WrapPanel Grid.Row="0" Margin="0,0,0,6">
            <TextBlock Text="VENTAS" FontSize="16.5" FontWeight="Bold"
                       Foreground="#00897B" VerticalAlignment="Center" Margin="0,0,12,6"/>

            <!-- Busqueda -->
            <Grid Width="260" Margin="0,0,8,6" VerticalAlignment="Center">
                <Border Background="White" CornerRadius="4" BorderBrush="#E0E0E0" BorderThickness="1">
                    <Grid>
                        <TextBlock Text="&#x1F50D;" Margin="8,0,0,0" VerticalAlignment="Center" FontSize="13.5" Foreground="#9E9E9E"/>
                        <TextBox x:Name="txt_search" Margin="26,2,22,2" BorderThickness="0" Background="Transparent"
                                 VerticalContentAlignment="Center" FontSize="12.5"
                                 Text="{Binding search_query, UpdateSourceTrigger=PropertyChanged}"
                                 TextChanged="txt_search_TextChanged"/>
                        <Button x:Name="btn_clear_search" Content="&#x2715;" Margin="0,0,4,0"
                                HorizontalAlignment="Right" Width="20" Height="20"
                                Cursor="Hand" Visibility="Collapsed" Click="btn_clear_search_Click">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border Background="Transparent" Padding="2">
                                        <TextBlock Text="{TemplateBinding Content}" FontSize="10.5" Foreground="#9E9E9E"
                                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>
                    </Grid>
                </Border>
            </Grid>

            <!-- Mes + Filtro -->
                <TextBlock VerticalAlignment="Center" FontSize="12.5" FontWeight="SemiBold" Margin="0,0,6,6"><Run Text="Mes:"/><Run Text="*" Foreground="#F44336"/></TextBlock>
                <ComboBox x:Name="cmb_month" Margin="0,0,8,6" MinWidth="110" VerticalAlignment="Center"
                          ItemsSource="{Binding pending_months}"
                          SelectedItem="{Binding selected_month}"
                          FontSize="12.5" Height="26"
                          HorizontalContentAlignment="Center"/>

                <TextBlock VerticalAlignment="Center" FontSize="12.5" FontWeight="SemiBold" Margin="0,0,6,6"><Run Text="Zona:"/></TextBlock>
                <ComboBox x:Name="cmb_zone" Margin="0,0,8,6" MinWidth="110" VerticalAlignment="Center"
                          ItemsSource="{Binding zone_options}"
                          SelectedItem="{Binding selected_zone, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                          FontSize="12.5" Height="26"
                          HorizontalContentAlignment="Center"/>

                <Button x:Name="btn_reporte" Content="Reporte" Background="#1B3A2D" Foreground="White"
                        Margin="0,0,0,6" VerticalAlignment="Center"
                        FontWeight="SemiBold" Padding="10,4" BorderThickness="0" Cursor="Hand"
                        FontSize="12.5" ToolTip="Reporte de ventas del mes"
                        Click="on_reporte_click">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="bd" Background="{TemplateBinding Background}" CornerRadius="4" Padding="{TemplateBinding Padding}">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="bd" Property="Background" Value="#2E5A46"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Button.Template>
                </Button>
        </WrapPanel>

        <!-- POPUP: CONFIGURADOR DE REPORTE DE VENTAS -->
        <Popup x:Name="popup_reporte"
               PlacementTarget="{Binding ElementName=btn_reporte}"
               Placement="Bottom"
               StaysOpen="False"
               AllowsTransparency="True"
               PopupAnimation="Fade">
            <Border x:Name="panel_reporte"
                    Background="White" BorderBrush="#C9D3C7" BorderThickness="1" CornerRadius="5"
                    Padding="14,12" Width="380">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="12" Direction="270" ShadowDepth="4" Opacity="0.18" Color="#000000"/>
                </Border.Effect>
                <StackPanel>
                    <!-- Titulo en su propia linea: antes los botones "Seleccionar todo" iban en el
                         mismo Grid y se montaban encima del texto al estrecharse el panel. -->
                    <TextBlock Text="CONFIGURAR REPORTE DE VENTAS" FontSize="11.5" FontWeight="Bold"
                               Foreground="#00897B"/>
                    <TextBlock Text="Personalice las opciones que desea incluir en el PDF."
                               FontSize="9.5" Foreground="#7A8A80" TextWrapping="Wrap" Margin="0,2,0,6"/>

                    <!-- Los botones van arriba del ScrollViewer, asi quedan fijos y visibles sin
                         tener que bajar hasta el final para llegar a ellos. -->
                    <Border Background="#F7FAF8" BorderBrush="#E0E8E3" BorderThickness="1"
                            CornerRadius="4" Padding="8,5" Margin="0,0,0,8">
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                            <Button Content="Seleccionar todo" Background="Transparent" Foreground="#00897B"
                                    FontWeight="SemiBold" FontSize="10.5" BorderThickness="0" Cursor="Hand"
                                    Margin="0,0,10,0"
                                    ToolTip="Marca todos los vendedores y zonas."
                                    Command="{Binding select_all_report_options_command}"/>
                            <Button Content="Quitar todo" Background="Transparent" Foreground="#C62828"
                                    FontWeight="SemiBold" FontSize="10.5" BorderThickness="0" Cursor="Hand"
                                    ToolTip="Desmarca todos los vendedores y zonas."
                                    Command="{Binding clear_all_report_options_command}"/>
                        </StackPanel>
                    </Border>

                    <ScrollViewer MaxHeight="400" VerticalScrollBarVisibility="Auto">
                        <StackPanel Margin="0,0,4,0">
                            <!-- SECCION 1: TIPO DE NOTA (primero los desplegables) -->
                            <Border Background="#F7FAF8" BorderBrush="#E0E8E3" BorderThickness="1" CornerRadius="4" Padding="8,6" Margin="0,0,0,8">
                                <StackPanel>
                                    <TextBlock Text="TIPO DE NOTA" FontSize="9.5" FontWeight="Bold" Foreground="#1B3A2D" Margin="0,0,0,4"/>
                                    <ComboBox ItemsSource="{Binding report_type_options}"
                                              SelectedItem="{Binding selected_report_type, Mode=TwoWay}"
                                              FontSize="11.5" Height="25" Cursor="Hand"/>
                                </StackPanel>
                            </Border>

                            <!-- SECCION 2: AGRUPAR EN -->
                            <Border Background="#F7FAF8" BorderBrush="#E0E8E3" BorderThickness="1" CornerRadius="4" Padding="8,6" Margin="0,0,0,8">
                                <StackPanel>
                                    <TextBlock Text="AGRUPAR EN (páginas del PDF)" FontSize="9.5" FontWeight="Bold" Foreground="#1B3A2D" Margin="0,0,0,4"/>
                                    <ComboBox ItemsSource="{Binding report_group_options}"
                                              SelectedItem="{Binding selected_report_group, Mode=TwoWay}"
                                              FontSize="11.5" Height="25" Cursor="Hand"/>
                                    <TextBlock Text="Por Vendedor: una página por vendedor, con la meta de ese vendedor. Por Zona: una página por zona."
                                               FontSize="9" Foreground="#7A8A80" TextWrapping="Wrap" Margin="0,3,0,0"/>
                                </StackPanel>
                            </Border>

                            <!-- SECCION 3: CHECKLISTS DE VENDEDORES Y ZONAS -->
                            <Border Background="#F7FAF8" BorderBrush="#E0E8E3" BorderThickness="1" CornerRadius="4" Padding="8,6" Margin="0,0,0,8">
<StackPanel>
                                    <TextBlock Text="Las listas de vendedores y zonas son el filtro: desmarque lo que no quiera en el reporte."
                                               FontSize="9.5" Foreground="#55665C" TextWrapping="Wrap" Margin="0,0,0,6"/>

                                    <StackPanel>
                                        <Grid Margin="0,0,0,4">
                                            <TextBlock Text="VENDEDORES" FontSize="9.5" FontWeight="Bold" Foreground="#1B3A2D" VerticalAlignment="Center"/>
                                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                                <CheckBox Content="Todos" IsChecked="{Binding all_report_sellers_selected, Mode=TwoWay}"
                                                          FontSize="10.5" FontWeight="SemiBold" Foreground="#333333" Margin="0,0,8,0" Cursor="Hand"/>
                                                <Button Content="Quitar" Background="Transparent" Foreground="#C62828"
                                                        FontWeight="SemiBold" FontSize="10.5" BorderThickness="0" Cursor="Hand"
                                                        Command="{Binding clear_report_sellers_command}"/>
                                            </StackPanel>
                                        </Grid>
                                        <ItemsControl ItemsSource="{Binding report_seller_options}">
                                            <ItemsControl.ItemsPanel>
                                                <ItemsPanelTemplate>
                                                    <WrapPanel/>
                                                </ItemsPanelTemplate>
                                            </ItemsControl.ItemsPanel>
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <CheckBox Content="{Binding display_name}" IsChecked="{Binding is_checked, Mode=TwoWay}"
                                                              FontSize="11" Foreground="#333333" Width="105" Margin="2,2,4,2" Cursor="Hand"/>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </StackPanel>

                                    <StackPanel Margin="0,6,0,0">
                                        <Grid Margin="0,0,0,4">
                                            <TextBlock Text="ZONAS" FontSize="9.5" FontWeight="Bold" Foreground="#1B3A2D" VerticalAlignment="Center"/>
                                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                                <CheckBox Content="Todas" IsChecked="{Binding all_report_zones_selected, Mode=TwoWay}"
                                                          FontSize="10.5" FontWeight="SemiBold" Foreground="#333333" Margin="0,0,8,0" Cursor="Hand"/>
                                                <Button Content="Quitar" Background="Transparent" Foreground="#C62828"
                                                        FontWeight="SemiBold" FontSize="10.5" BorderThickness="0" Cursor="Hand"
                                                        Command="{Binding clear_report_zones_command}"/>
                                            </StackPanel>
                                        </Grid>
                                        <ItemsControl ItemsSource="{Binding report_zone_options}">
                                            <ItemsControl.ItemsPanel>
                                                <ItemsPanelTemplate>
                                                    <WrapPanel/>
                                                </ItemsPanelTemplate>
                                            </ItemsControl.ItemsPanel>
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <CheckBox Content="{Binding display_name}" IsChecked="{Binding is_checked, Mode=TwoWay}"
                                                              FontSize="11" Foreground="#333333" Width="105" Margin="2,2,4,2" Cursor="Hand"/>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </StackPanel>
                                </StackPanel>
                            </Border>

                            <!-- SECCION 4: OPCIONES ADICIONALES (va al final, despues de los
                                 desplegables y de las checklists) -->
                            <Border Background="#F9FBF9" BorderBrush="#E0E8E3" BorderThickness="1" CornerRadius="4" Padding="8,6" Margin="0,0,0,6">
                                <StackPanel>
                                    <TextBlock Text="OPCIONES DEL REPORTE" FontSize="9" FontWeight="Bold" Foreground="#55665C" Margin="0,0,0,4"/>

                                    <!-- En "Por Zona" la meta no tiene sentido: las metas son por vendedor -->
                                    <StackPanel>
                                        <StackPanel.Style>
                                            <Style TargetType="StackPanel">
                                                <Setter Property="Visibility" Value="Visible"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding selected_report_group}" Value="Por Zona">
                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </StackPanel.Style>
                                        <CheckBox Content="Incluir bloque de Meta de Ventas"
                                                  IsChecked="{Binding report_include_goal, Mode=TwoWay}"
                                                  FontSize="11" Foreground="#333333" Margin="0,2,0,4" Cursor="Hand"/>
                                    </StackPanel>

                                    <TextBlock Text="La meta se imprime por vendedor o total del mes. No aparece si el reporte agrupa por zona o si filtra zonas / tipos de nota."
                                               FontSize="9" Foreground="#7A8A80" TextWrapping="Wrap" Margin="2,0,0,4"/>

                                    <CheckBox Content="Incluir cobranza (Abonado y Saldo)"
                                              IsChecked="{Binding report_include_collections, Mode=TwoWay}"
                                              FontSize="11" Foreground="#333333" Margin="0,0,0,4" Cursor="Hand"/>
                                    <CheckBox Content="Incluir anuladas / devueltas"
                                              IsChecked="{Binding report_include_voided_and_returned, Mode=TwoWay}"
                                              FontSize="11" Foreground="#333333" Margin="0,0,0,2" Cursor="Hand"
                                              ToolTip="Se muestran marcadas en color y aparte del total: las anuladas y las devueltas nunca suman al subtotal ni al total."/>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>

                    <Button Content="Descargar PDF"
                            Background="#1B3A2D" Foreground="White" FontWeight="Bold"
                            FontSize="12.5" Height="32" BorderThickness="0" Cursor="Hand"
                            Margin="0,8,0,0" Click="on_descargar_sales_report_click">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border x:Name="bd" Background="{TemplateBinding Background}" CornerRadius="4">
                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="bd" Property="Background" Value="#2E5A46"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>
                </StackPanel>
            </Border>
        </Popup>

        <!-- FILA 1: TABS DE VENDEDORAS -->
        <TabControl Grid.Row="2" ItemsSource="{Binding seller_tabs}" SelectedItem="{Binding selected_tab, Mode=TwoWay}" Margin="0,0,0,4">
            <TabControl.ItemTemplate>
                <DataTemplate>
                    <TextBlock Text="{Binding Header}" FontWeight="SemiBold" FontSize="12.5"/>
                </DataTemplate>
            </TabControl.ItemTemplate>
            <TabControl.ContentTemplate>
                <DataTemplate>
                    <DataGrid Style="{StaticResource CompactDataGrid}" ItemsSource="{Binding Items}"
                              PreviewMouseDoubleClick="DataGrid_PreviewMouseDoubleClick">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="NRO" Binding="{Binding note_number}" Width="70"
                          ElementStyle="{StaticResource CellTextCenter}"/>
                        <DataGridTextColumn Header="VENDEDOR" Binding="{Binding seller_name}" Width="75"
                          ElementStyle="{StaticResource CellTextCenter}"/>
                        <DataGridTextColumn Header="CLIENTE" Binding="{Binding customer_name}" Width="*" MinWidth="170"
                          ElementStyle="{StaticResource CellTextWrap}"/>
                        <DataGridTextColumn Header="ZONA" Binding="{Binding zone_name}" Width="90"
                          ElementStyle="{StaticResource CellTextCenter}"/>
                        <DataGridTextColumn Header="TOTAL" Binding="{Binding total_amount_usd, StringFormat=F2}" Width="80"
                          ElementStyle="{StaticResource CellTextCenter}"/>
                        <DataGridTextColumn Header="ESTADO" Binding="{Binding status}" Width="80">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="HorizontalAlignment" Value="Center"/>
                                    <Setter Property="FontWeight" Value="Bold"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding status}" Value="Pagada">
                                            <Setter Property="Foreground" Value="#2E7D32"/>
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding status}" Value="Pendiente">
                                            <Setter Property="Foreground" Value="#F57C00"/>
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding status}" Value="Anulada">
                                            <Setter Property="Foreground" Value="#9E9E9E"/>
                                            <Setter Property="FontStyle" Value="Italic"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>
                        <DataGridTextColumn Header="FECHA" Binding="{Binding creation_date, StringFormat=dd/MM/yy}" Width="70"
                          ElementStyle="{StaticResource CellTextCenter}"/>
                        <DataGridTextColumn Header="DESPACHO" Binding="{Binding dispatch_date, StringFormat=dd/MM/yy}" Width="80"
                          ElementStyle="{StaticResource CellTextCenter}"/>
                        <DataGridTextColumn Header="TIPO DE NOTA" Binding="{Binding note_type_display}" Width="110"/>
                        <DataGridTemplateColumn Header="OBSERVACION" Width="170">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Grid>
                                        <TextBlock Text="{Binding sales_observations_display}" ToolTip="{Binding sales_observations_display}" TextWrapping="Wrap"
                                                   TextTrimming="CharacterEllipsis" VerticalAlignment="Center" Cursor="Hand">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding is_editing_observations}" Value="True">
                                                            <Setter Property="Visibility" Value="Collapsed"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                        <TextBox Text="{Binding sales_observations, UpdateSourceTrigger=PropertyChanged}" MaxLength="500"
                                                 TextWrapping="Wrap" VerticalAlignment="Center" Background="#FFFDE7"
                                                 KeyDown="ObsTextBox_KeyDown" LostKeyboardFocus="ObsTextBox_LostKeyboardFocus">
                                            <TextBox.Style>
                                                <Style TargetType="TextBox">
                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding is_editing_observations}" Value="True">
                                                            <Setter Property="Visibility" Value="Visible"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBox.Style>
                                        </TextBox>
                                    </Grid>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTemplateColumn Header="ACCIONES" Width="140">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                        <Button Content="Vista Previa" FontSize="11.5" Padding="6,2" Margin="0,0,4,0" Cursor="Hand"
                                                Background="#F5F5F5" BorderThickness="1" BorderBrush="#E0E0E0" Foreground="#424242"
                                                Command="{Binding DataContext.preview_note_command, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                CommandParameter="{Binding}"/>
                                        <Button Content="PDF" FontSize="11.5" Padding="6,2" Cursor="Hand"
                                                Background="#F5F5F5" BorderThickness="1" BorderBrush="#E0E0E0" Foreground="#424242"
                                                Command="{Binding DataContext.print_pdf_command, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                CommandParameter="{Binding}"/>
                                    </StackPanel>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>
            </DataTemplate>
        </TabControl.ContentTemplate>
        </TabControl>

        <!-- FILA 3: FOOTER - total + meta + progreso -->
        <Border Grid.Row="3" Background="#00897B" Padding="12,7" CornerRadius="0,0,4,4">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Fila 1: total venta + meta -->
                <Grid Grid.Row="0" Margin="0,0,0,6">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="TOTAL VENTA:" Foreground="#B2DFDB" FontSize="13" VerticalAlignment="Center"/>
                        <TextBlock Text="{Binding total_sales_usd, StringFormat=F2}" Foreground="White" FontSize="15"
                                   FontWeight="Bold" VerticalAlignment="Center" Margin="5,0,0,0"/>
                    </StackPanel>

                    <!-- Meta (editable) -->
                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="{Binding goal_label_display}" Foreground="#B2DFDB" FontSize="12.5" VerticalAlignment="Center"/>
                        <TextBlock Text="*" Foreground="#F44336" FontSize="12.5" FontWeight="Bold" Margin="1,0,0,0" VerticalAlignment="Center"/>
                        <TextBlock Foreground="White" FontSize="13" FontWeight="SemiBold"
                                   VerticalAlignment="Center" Margin="5,0,0,0">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Text" Value="{Binding sales_goal_usd, StringFormat=F2}"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding sales_goal_usd}" Value="{x:Null}">
                                            <Setter Property="Text" Value="Sin meta"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>

                        <!-- Botones define/edita -->
                        <Button Margin="10,0,0,0" Padding="8,3" BorderThickness="0" Cursor="Hand"
                                FontSize="11.5" Foreground="White" Background="#1B3A2D" FontWeight="SemiBold"
                                Command="{Binding edit_goal_command}">
                            <Button.Style>
                                <Style TargetType="Button">
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="Button">
                                                <Border x:Name="bd" Background="{TemplateBinding Background}" CornerRadius="3" Padding="{TemplateBinding Padding}">
                                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                </Border>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter TargetName="bd" Property="Background" Value="#2E5A46"/>
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                    <Setter Property="Content" Value="Editar meta"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding is_editing_goal}" Value="True">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding is_month_selected}" Value="False">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding sales_goal_usd}" Value="{x:Null}">
                                            <Setter Property="Content" Value="Definir meta"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                        </Button>

                        <!-- Editor de meta -->
                        <StackPanel Orientation="Horizontal">
                            <StackPanel.Style>
                                <Style TargetType="StackPanel">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding is_editing_goal}" Value="True">
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding is_month_selected}" Value="False">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </StackPanel.Style>
                            <TextBox x:Name="txt_goal" Text="{Binding goal_edit_text, UpdateSourceTrigger=PropertyChanged}"
                                     Width="90" Height="24" Margin="10,0,0,0" FontSize="12.5"
                                     VerticalContentAlignment="Center" Background="White"
                                     KeyDown="GoalTextBox_KeyDown"/>
                            <Button Content="Guardar" Margin="5,0,0,0" Padding="8,2" BorderThickness="0" Cursor="Hand"
                                    FontSize="11.5" Foreground="White" Background="#2E7D32" FontWeight="SemiBold"
                                    Command="{Binding save_goal_command}">
                                <Button.Template>
                                    <ControlTemplate TargetType="Button">
                                        <Border x:Name="bd" Background="{TemplateBinding Background}" CornerRadius="3" Padding="{TemplateBinding Padding}">
                                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="bd" Property="Background" Value="#388E3C"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Button.Template>
                            </Button>
                            <Button Content="Cancelar" Margin="4,0,0,0" Padding="6,2" BorderThickness="0" Cursor="Hand"
                                    FontSize="11.5" Foreground="#ECEFF1" Background="#546E7A" FontWeight="SemiBold"
                                    Command="{Binding cancel_goal_edit_command}">
                                <Button.Template>
                                    <ControlTemplate TargetType="Button">
                                        <Border x:Name="bd" Background="{TemplateBinding Background}" CornerRadius="3" Padding="{TemplateBinding Padding}">
                                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="bd" Property="Background" Value="#607D8B"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Button.Template>
                            </Button>
                        </StackPanel>
                    </StackPanel>
                </Grid>

                <!-- Fila 2: barra de progreso + estado -->
                <Grid Grid.Row="1">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <ProgressBar Grid.Column="0" Height="10" Value="{Binding goal_progress_percent, Mode=OneWay}"
                                 Maximum="100" Background="#0D5A4B" Foreground="#FFD54F">
                        <ProgressBar.Style>
                            <Style TargetType="ProgressBar">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding sales_goal_usd}" Value="{x:Null}">
                                        <Setter Property="Foreground" Value="#FFFFFF"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </ProgressBar.Style>
                    </ProgressBar>

                    <TextBlock Grid.Column="1" Text="{Binding goal_status_text}" FontSize="11.5"
                               Foreground="#E0F2F1" VerticalAlignment="Center" Margin="10,0,0,0" TextAlignment="Right"/>
                </Grid>
            </Grid>
        </Border>
    </Grid>
</UserControl>
