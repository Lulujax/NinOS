<Window x:Class="NinOS.UI.Views.ProVentaHistoryWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Relacion Pro Venta - Notas y Pagos" Height="660" Width="860"
        WindowStartupLocation="CenterOwner" Background="White" FontSize="12"
        ResizeMode="CanResizeWithGrip">
    <Window.Resources>
        <Style x:Key="CenterCell" TargetType="TextBlock">
            <Setter Property="TextAlignment" Value="Center"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
        <Style x:Key="ProVentaHeader" TargetType="DataGridColumnHeader">
            <Setter Property="Background" Value="#1565C0"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
        </Style>
    </Window.Resources>

    <Grid Margin="14">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="DETALLE DE LA RELACION" FontSize="16" FontWeight="Bold"
                   Foreground="#1565C0" HorizontalAlignment="Center"/>

        <Border Grid.Row="1" Background="#E3F2FD" CornerRadius="3" Padding="8" Margin="0,8,0,8">
            <TextBlock x:Name="RelationInfoText" FontSize="11" Foreground="#1565C0" TextWrapping="Wrap"/>
        </Border>

        <TextBlock Grid.Row="2" Text="NOTAS DE LA RELACION" FontSize="12" FontWeight="Bold"
                   Foreground="#1565C0" Margin="0,0,0,4"/>

        <DataGrid Grid.Row="3" x:Name="NotesGrid" AutoGenerateColumns="False" IsReadOnly="True"
                  CanUserAddRows="False" GridLinesVisibility="All"
                  HorizontalGridLinesBrush="#BBDEFB" VerticalGridLinesBrush="#BBDEFB"
                  BorderBrush="#1565C0" BorderThickness="1" FontSize="12" RowHeight="28"
                  MaxHeight="230" AlternatingRowBackground="#F1F8FF" RowBackground="White"
                  ColumnHeaderStyle="{StaticResource ProVentaHeader}">
            <DataGrid.Columns>
                <DataGridTextColumn Header="NRO NOTA" Binding="{Binding note_number}" Width="120"
                                    ElementStyle="{StaticResource CenterCell}"/>
                <DataGridTextColumn Header="CLIENTE" Binding="{Binding customer_name}" Width="*"/>
                <DataGridTextColumn Header="MONTO" Binding="{Binding amount, StringFormat={}{0:N2}}" Width="130"
                                    ElementStyle="{StaticResource CenterCell}"/>
            </DataGrid.Columns>
        </DataGrid>

        <TextBlock Grid.Row="4" Text="REGISTRO DE PAGOS" FontSize="12" FontWeight="Bold"
                   Foreground="#1565C0" Margin="0,12,0,4"/>

        <DataGrid Grid.Row="5" x:Name="HistoryGrid" AutoGenerateColumns="False" IsReadOnly="True"
                  CanUserAddRows="False" GridLinesVisibility="All"
                  HorizontalGridLinesBrush="#BBDEFB" VerticalGridLinesBrush="#BBDEFB"
                  BorderBrush="#1565C0" BorderThickness="1" FontSize="12" RowHeight="30"
                  AlternatingRowBackground="#F1F8FF" RowBackground="White"
                  ColumnHeaderStyle="{StaticResource ProVentaHeader}">
            <DataGrid.Columns>
                <DataGridTextColumn Header="FECHA DEL PAGO" Binding="{Binding payment_date, StringFormat={}{0:dd/MM/yyyy}}" Width="150"
                                    ElementStyle="{StaticResource CenterCell}"/>
                <DataGridTextColumn Header="MONTO USD" Binding="{Binding amount_usd, StringFormat={}{0:N2}}" Width="130"
                                    ElementStyle="{StaticResource CenterCell}"/>
                <DataGridTextColumn Header="OBSERVACION" Binding="{Binding notes}" Width="*"/>
                <DataGridTemplateColumn Header="ACCION" Width="120">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <Button Content="Editar" Padding="6,2" FontSize="10" Cursor="Hand"
                                    Background="#F5F5F5" BorderThickness="1" BorderBrush="#E0E0E0"
                                    Foreground="#424242" HorizontalAlignment="Center"
                                    Click="EditPayment_Click"/>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
            </DataGrid.Columns>
        </DataGrid>

        <StackPanel Grid.Row="6" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
            <Button Content="Cerrar" Padding="12,5" Background="#E0E0E0" Foreground="#424242"
                    BorderThickness="0" Cursor="Hand" Click="Close_Click" FontSize="11"/>
        </StackPanel>
    </Grid>
</Window>
