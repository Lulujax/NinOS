<UserControl x:Class="NinOS.UI.Views.CreditNotesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d" Background="White">
    <UserControl.Resources>
        <Style x:Key="CompactDataGrid" TargetType="DataGrid">
            <Setter Property="AutoGenerateColumns" Value="False"/>
            <Setter Property="IsReadOnly" Value="True"/>
            <Setter Property="GridLinesVisibility" Value="Horizontal"/>
            <Setter Property="HeadersVisibility" Value="Column"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush" Value="#E0E0E0"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="RowHeaderWidth" Value="0"/>
            <Setter Property="CanUserAddRows" Value="False"/>
            <Setter Property="CanUserDeleteRows" Value="False"/>
            <Setter Property="CanUserReorderColumns" Value="False"/>
            <Setter Property="CanUserResizeColumns" Value="False"/>
            <Setter Property="SelectionMode" Value="Single"/>
            <Setter Property="EnableRowVirtualization" Value="True"/>
            <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="MinRowHeight" Value="22"/>
        </Style>
        <Style x:Key="CellText" TargetType="TextBlock">
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
        </Style>
        <Style x:Key="CellTextCenter" TargetType="TextBlock" BasedOn="{StaticResource CellText}">
            <Setter Property="HorizontalAlignment" Value="Center"/>
            <Setter Property="TextAlignment" Value="Center"/>
        </Style>
        <Style x:Key="CellTextWrap" TargetType="TextBlock" BasedOn="{StaticResource CellText}">
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="TextTrimming" Value="None"/>
        </Style>
        <Style x:Key="CellTextCenterWrap" TargetType="TextBlock" BasedOn="{StaticResource CellTextCenter}">
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="TextTrimming" Value="None"/>
        </Style>
        <Style x:Key="PdfButton" TargetType="Button">
            <Setter Property="Height" Value="22"/>
            <Setter Property="Padding" Value="8,0"/>
            <Setter Property="Margin" Value="2,1"/>
            <Setter Property="FontSize" Value="9.5"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Background" Value="#C62828"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="{TemplateBinding Background}" CornerRadius="3" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#E53935"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="PreviewButton" TargetType="Button">
            <Setter Property="Height" Value="22"/>
            <Setter Property="Padding" Value="8,0"/>
            <Setter Property="Margin" Value="2,1"/>
            <Setter Property="FontSize" Value="9.5"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Background" Value="#1565C0"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="{TemplateBinding Background}" CornerRadius="3" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#1E88E5"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>
    <Grid Margin="6">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- FILA 0: HEADER -->
        <Grid Grid.Row="0" Margin="0,0,0,6">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <TextBlock Grid.Column="0" Text="NOTAS DE CREDITO" FontSize="16.5" FontWeight="Bold"
                       Foreground="#C62828" VerticalAlignment="Center" Margin="0,0,12,0"/>

            <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                <ComboBox x:Name="cmb_month" Margin="0,0,8,0" MinWidth="130"
                          ItemsSource="{Binding credit_note_months}"
                          SelectedItem="{Binding selected_month}"
                          FontSize="12.5" Height="26"
                          HorizontalContentAlignment="Center" ToolTip="Mes"/>
                <Button Content="Nueva Nota de Credito" Background="#C62828" Foreground="White"
                        FontWeight="SemiBold" Padding="12,4" BorderThickness="0" Cursor="Hand"
                        Command="{Binding new_credit_note_command}" FontSize="12.5">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="bd" Background="{TemplateBinding Background}" CornerRadius="4" Padding="{TemplateBinding Padding}">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="bd" Property="Background" Value="#E53935"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Button.Template>
                </Button>
            </StackPanel>
        </Grid>

        <!-- FILA 1: TABS DE VENDEDORES -->
        <TabControl Grid.Row="1" SelectedIndex="{Binding selected_tab_index, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,4">

            <!-- TODOS -->
            <TabItem>
                <TabItem.Header>
                    <TextBlock Text="Todos" FontWeight="SemiBold" FontSize="12.5"/>
                </TabItem.Header>
                <DataGrid Style="{StaticResource CompactDataGrid}"
                          ItemsSource="{Binding notes}" MouseDoubleClick="DataGrid_MouseDoubleClick">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="FECHA" Binding="{Binding delivery_month_label}" Width="95"
                                            ElementStyle="{StaticResource CellTextCenter}"/>
                        <DataGridTextColumn Header="CATEGORIA" Binding="{Binding category}" Width="95"
                                            ElementStyle="{StaticResource CellTextCenter}"/>
                        <DataGridTextColumn Header="TIPO NOTA" Binding="{Binding note_type_name}" Width="95"
                                            ElementStyle="{StaticResource CellTextCenter}"/>
                        <DataGridTextColumn Header="NRO NC" Binding="{Binding note_number}" Width="105"
                                            ElementStyle="{StaticResource CellTextCenter}"/>
                        <DataGridTextColumn Header="NOTA DE ENTREGA" Binding="{Binding source_note_number}" Width="105"
                                            ElementStyle="{StaticResource CellTextCenter}"/>
                        <DataGridTextColumn Header="CLIENTE" Binding="{Binding customer_name}" Width="*"
                                            ElementStyle="{StaticResource CellTextWrap}"/>
                        <DataGridTextColumn Header="VENDEDOR" Binding="{Binding seller_name}" Width="80"
                                            ElementStyle="{StaticResource CellTextCenterWrap}"/>
                        <DataGridTextColumn Header="MONTO" Binding="{Binding total_amount_usd, StringFormat=N2}" Width="85">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock" BasedOn="{StaticResource CellTextCenter}">
                                    <Setter Property="Foreground" Value="#C62828"/>
                                    <Setter Property="FontWeight" Value="Bold"/>
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>
                        <DataGridTemplateColumn Header="ACCIONES" Width="132">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                        <Button Content="Vista Previa" Style="{StaticResource PreviewButton}"
                                                Click="PreviewButton_Click" Tag="{Binding}"/>
                                        <Button Content="PDF" Style="{StaticResource PdfButton}"
                                                Click="PdfButton_Click" Tag="{Binding}"/>
                                    </StackPanel>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>
            </TabItem>

            <!-- SANDRA -->
            <TabItem>
                <TabItem.Header>
                    <TextBlock Text="Sandra" FontWeight="SemiBold" FontSize="12.5"/>
                </TabItem.Header>
                <DataGrid Style="{StaticResource CompactDataGrid}"
                          ItemsSource="{Binding sandra_notes}" MouseDoubleClick="DataGrid_MouseDoubleClick">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="FECHA" Binding="{Binding delivery_month_label}" Width="95"
                                            ElementStyle="{StaticResource CellTextCenter}"/>
                        <DataGridTextColumn Header="CATEGORIA" Binding="{Binding category}" Width="95"
                                            ElementStyle="{StaticResource CellTextCenter}"/>
                        <DataGridTextColumn Header="TIPO NOTA" Binding="{Binding note_type_name}" Width="95"
                                            ElementStyle="{StaticResource CellTextCenter}"/>
                        <DataGridTextColumn Header="NRO NC" Binding="{Binding note_number}" Width="105"
                                            ElementStyle="{StaticResource CellTextCenter}"/>
                        <DataGridTextColumn Header="NOTA DE ENTREGA" Binding="{Binding source_note_number}" Width="105"
                                            ElementStyle="{StaticResource CellTextCenter}"/>
                        <DataGridTextColumn Header="CLIENTE" Binding="{Binding customer_name}" Width="*"
                                            ElementStyle="{StaticResource CellTextWrap}"/>
                        <DataGridTextColumn Header="MONTO" Binding="{Binding total_amount_usd, StringFormat=N2}" Width="85">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock" BasedOn="{StaticResource CellTextCenter}">
                                    <Setter Property="Foreground" Value="#C62828"/>
                                    <Setter Property="FontWeight" Value="Bold"/>
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>
                        <DataGridTemplateColumn Header="ACCIONES" Width="132">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                        <Button Content="Vista Previa" Style="{StaticResource PreviewButton}"
                                                Click="PreviewButton_Click" Tag="{Binding}"/>
                                        <Button Content="PDF" Style="{StaticResource PdfButton}"
                                                Click="PdfButton_Click" Tag="{Binding}"/>
                                    </StackPanel>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>
            </TabItem>

            <!-- ANAIS -->
            <TabItem>
                <TabItem.Header>
                    <TextBlock Text="Anais" FontWeight="SemiBold" FontSize="12.5"/>
                </TabItem.Header>
                <DataGrid Style="{StaticResource CompactDataGrid}"
                          ItemsSource="{Binding anais_notes}" MouseDoubleClick="DataGrid_MouseDoubleClick">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="FECHA" Binding="{Binding delivery_month_label}" Width="95"
                                            ElementStyle="{StaticResource CellTextCenter}"/>
                        <DataGridTextColumn Header="CATEGORIA" Binding="{Binding category}" Width="95"
                                            ElementStyle="{StaticResource CellTextCenter}"/>
                        <DataGridTextColumn Header="TIPO NOTA" Binding="{Binding note_type_name}" Width="95"
                                            ElementStyle="{StaticResource CellTextCenter}"/>
                        <DataGridTextColumn Header="NRO NC" Binding="{Binding note_number}" Width="105"
                                            ElementStyle="{StaticResource CellTextCenter}"/>
                        <DataGridTextColumn Header="NOTA DE ENTREGA" Binding="{Binding source_note_number}" Width="105"
                                            ElementStyle="{StaticResource CellTextCenter}"/>
                        <DataGridTextColumn Header="CLIENTE" Binding="{Binding customer_name}" Width="*"
                                            ElementStyle="{StaticResource CellTextWrap}"/>
                        <DataGridTextColumn Header="MONTO" Binding="{Binding total_amount_usd, StringFormat=N2}" Width="85">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock" BasedOn="{StaticResource CellTextCenter}">
                                    <Setter Property="Foreground" Value="#C62828"/>
                                    <Setter Property="FontWeight" Value="Bold"/>
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>
                        <DataGridTemplateColumn Header="ACCIONES" Width="132">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                        <Button Content="Vista Previa" Style="{StaticResource PreviewButton}"
                                                Click="PreviewButton_Click" Tag="{Binding}"/>
                                        <Button Content="PDF" Style="{StaticResource PdfButton}"
                                                Click="PdfButton_Click" Tag="{Binding}"/>
                                    </StackPanel>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>
            </TabItem>

            <!-- ALEJANDRA -->
            <TabItem>
                <TabItem.Header>
                    <TextBlock Text="Alejandra" FontWeight="SemiBold" FontSize="12.5"/>
                </TabItem.Header>
                <DataGrid Style="{StaticResource CompactDataGrid}"
                          ItemsSource="{Binding alejandra_notes}" MouseDoubleClick="DataGrid_MouseDoubleClick">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="FECHA" Binding="{Binding delivery_month_label}" Width="95"
                                            ElementStyle="{StaticResource CellTextCenter}"/>
                        <DataGridTextColumn Header="CATEGORIA" Binding="{Binding category}" Width="95"
                                            ElementStyle="{StaticResource CellTextCenter}"/>
                        <DataGridTextColumn Header="TIPO NOTA" Binding="{Binding note_type_name}" Width="95"
                                            ElementStyle="{StaticResource CellTextCenter}"/>
                        <DataGridTextColumn Header="NRO NC" Binding="{Binding note_number}" Width="105"
                                            ElementStyle="{StaticResource CellTextCenter}"/>
                        <DataGridTextColumn Header="NOTA DE ENTREGA" Binding="{Binding source_note_number}" Width="105"
                                            ElementStyle="{StaticResource CellTextCenter}"/>
                        <DataGridTextColumn Header="CLIENTE" Binding="{Binding customer_name}" Width="*"
                                            ElementStyle="{StaticResource CellTextWrap}"/>
                        <DataGridTextColumn Header="MONTO" Binding="{Binding total_amount_usd, StringFormat=N2}" Width="85">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock" BasedOn="{StaticResource CellTextCenter}">
                                    <Setter Property="Foreground" Value="#C62828"/>
                                    <Setter Property="FontWeight" Value="Bold"/>
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>
                        <DataGridTemplateColumn Header="ACCIONES" Width="132">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                        <Button Content="Vista Previa" Style="{StaticResource PreviewButton}"
                                                Click="PreviewButton_Click" Tag="{Binding}"/>
                                        <Button Content="PDF" Style="{StaticResource PdfButton}"
                                                Click="PdfButton_Click" Tag="{Binding}"/>
                                    </StackPanel>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>
            </TabItem>

            <!-- JUAN LUIS -->
            <TabItem>
                <TabItem.Header>
                    <TextBlock Text="Juan Luis" FontWeight="SemiBold" FontSize="12.5"/>
                </TabItem.Header>
                <DataGrid Style="{StaticResource CompactDataGrid}"
                          ItemsSource="{Binding juan_luis_notes}" MouseDoubleClick="DataGrid_MouseDoubleClick">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="FECHA" Binding="{Binding delivery_month_label}" Width="95"
                                            ElementStyle="{StaticResource CellTextCenter}"/>
                        <DataGridTextColumn Header="CATEGORIA" Binding="{Binding category}" Width="95"
                                            ElementStyle="{StaticResource CellTextCenter}"/>
                        <DataGridTextColumn Header="TIPO NOTA" Binding="{Binding note_type_name}" Width="95"
                                            ElementStyle="{StaticResource CellTextCenter}"/>
                        <DataGridTextColumn Header="NRO NC" Binding="{Binding note_number}" Width="105"
                                            ElementStyle="{StaticResource CellTextCenter}"/>
                        <DataGridTextColumn Header="NOTA DE ENTREGA" Binding="{Binding source_note_number}" Width="105"
                                            ElementStyle="{StaticResource CellTextCenter}"/>
                        <DataGridTextColumn Header="CLIENTE" Binding="{Binding customer_name}" Width="*"
                                            ElementStyle="{StaticResource CellTextWrap}"/>
                        <DataGridTextColumn Header="MONTO" Binding="{Binding total_amount_usd, StringFormat=N2}" Width="85">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock" BasedOn="{StaticResource CellTextCenter}">
                                    <Setter Property="Foreground" Value="#C62828"/>
                                    <Setter Property="FontWeight" Value="Bold"/>
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>
                        <DataGridTemplateColumn Header="ACCIONES" Width="132">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                        <Button Content="Vista Previa" Style="{StaticResource PreviewButton}"
                                                Click="PreviewButton_Click" Tag="{Binding}"/>
                                        <Button Content="PDF" Style="{StaticResource PdfButton}"
                                                Click="PdfButton_Click" Tag="{Binding}"/>
                                    </StackPanel>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>
            </TabItem>
        </TabControl>

        <!-- FILA 2: FOOTER -->
        <Border Grid.Row="2" Background="#C62828" Padding="10,5" CornerRadius="0,0,4,4">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                <TextBlock Text="TOTAL DEVUELTO: $" Foreground="#FDECEA" FontSize="12.5" VerticalAlignment="Center"/>
                <TextBlock Text="{Binding total_credit_usd, StringFormat=N2}" Foreground="White" FontSize="14.5"
                           FontWeight="Bold" VerticalAlignment="Center" Margin="4,0,0,0"/>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>