<UserControl x:Class="NinOS.UI.Views.CreditNotesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:conv="clr-namespace:NinOS.UI.Converters"
             mc:Ignorable="d" Background="White">
    <UserControl.Resources>
        <conv:BooleanToVisibilityConverter x:Key="BoolToVisible"/>
        <Style x:Key="CompactDataGrid" TargetType="DataGrid">
            <Setter Property="AutoGenerateColumns" Value="False"/>
            <Setter Property="IsReadOnly" Value="True"/>
            <Setter Property="GridLinesVisibility" Value="Horizontal"/>
            <Setter Property="HeadersVisibility" Value="Column"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush" Value="#E0E0E0"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="RowHeaderWidth" Value="0"/>
            <Setter Property="CanUserAddRows" Value="False"/>
            <Setter Property="CanUserDeleteRows" Value="False"/>
            <Setter Property="CanUserReorderColumns" Value="False"/>
            <Setter Property="CanUserResizeColumns" Value="False"/>
            <Setter Property="SelectionMode" Value="Single"/>
            <!-- Virtualizacion activada, igual que Cuentas por Cobrar, Ventas e Inventario: sin
                 esto hay que medir y generar todas las filas y el modulo tarda en abrir. Las
                 celdas de esta vista no usan TextWrapping, asi que la extension se calcula bien. -->
            <Setter Property="EnableRowVirtualization" Value="True"/>
            <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Auto"/>
            <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Auto"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="MinRowHeight" Value="22"/>
        </Style>
        <Style x:Key="CellText" TargetType="TextBlock">
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
        </Style>
        <Style x:Key="CellTextCenter" TargetType="TextBlock" BasedOn="{StaticResource CellText}">
            <Setter Property="HorizontalAlignment" Value="Center"/>
            <Setter Property="TextAlignment" Value="Center"/>
        </Style>
        <Style x:Key="CellTextWrap" TargetType="TextBlock" BasedOn="{StaticResource CellText}">
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="TextTrimming" Value="None"/>
        </Style>
        <Style x:Key="CellTextCenterWrap" TargetType="TextBlock" BasedOn="{StaticResource CellTextCenter}">
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="TextTrimming" Value="None"/>
        </Style>
        <Style x:Key="PdfButton" TargetType="Button">
            <Setter Property="Height" Value="22"/>
            <Setter Property="Padding" Value="8,0"/>
            <Setter Property="Margin" Value="2,1"/>
            <Setter Property="FontSize" Value="9.5"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Background" Value="#C62828"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="{TemplateBinding Background}" CornerRadius="3" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#E53935"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="PreviewButton" TargetType="Button">
            <Setter Property="Height" Value="22"/>
            <Setter Property="Padding" Value="8,0"/>
            <Setter Property="Margin" Value="2,1"/>
            <Setter Property="FontSize" Value="9.5"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Background" Value="#1565C0"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="{TemplateBinding Background}" CornerRadius="3" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#1E88E5"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>
    <Grid Margin="6">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- FILA 0: HEADER -->
        <Grid Grid.Row="0" Margin="0,0,0,6">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <TextBlock Grid.Column="0" Text="NOTAS DE CREDITO" FontSize="16.5" FontWeight="Bold"
                       Foreground="#C62828" VerticalAlignment="Center" Margin="0,0,12,0"/>

            <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                <ComboBox x:Name="cmb_category_filter" Margin="0,0,8,0" MinWidth="125"
                          ItemsSource="{Binding category_filters}"
                          SelectedItem="{Binding selected_category_filter}"
                          FontSize="12.5" Height="26"
                          HorizontalContentAlignment="Center" ToolTip="Filtrar por categorÃ­a"/>
                <ComboBox x:Name="cmb_month" Margin="0,0,8,0" MinWidth="130"
                          ItemsSource="{Binding credit_note_months}"
                          SelectedItem="{Binding selected_month}"
                          FontSize="12.5" Height="26"
                          HorizontalContentAlignment="Center" ToolTip="Mes"/>
                <Button x:Name="btn_reporte" Content="Reporte" Background="#1B3A2D" Foreground="White"
                        FontWeight="SemiBold" Padding="12,4" BorderThickness="0" Cursor="Hand"
                        FontSize="12.5" Margin="0,0,8,0"
                        ToolTip="Reporte de notas de credito"
                        Click="on_reporte_click">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="bd" Background="{TemplateBinding Background}" CornerRadius="4" Padding="{TemplateBinding Padding}">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="bd" Property="Background" Value="#2E5A46"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Button.Template>
                </Button>
                <Button Content="Nueva Nota de Credito" Background="#C62828" Foreground="White"
                        FontWeight="SemiBold" Padding="12,4" BorderThickness="0" Cursor="Hand"
                        Command="{Binding new_credit_note_command}" FontSize="12.5">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="bd" Background="{TemplateBinding Background}" CornerRadius="4" Padding="{TemplateBinding Padding}">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="bd" Property="Background" Value="#E53935"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Button.Template>
                </Button>
            </StackPanel>
        </Grid>

        <!-- MINI MENU DE REPORTE -->
        <Popup x:Name="popup_reporte"
               PlacementTarget="{Binding ElementName=btn_reporte}"
               Placement="Bottom"
               StaysOpen="False"
               AllowsTransparency="True"
               PopupAnimation="Fade">
            <Border x:Name="panel_reporte"
                    Background="White" BorderBrush="#C9D3C7" BorderThickness="1" CornerRadius="4"
                    Padding="12,10" Width="270">
                <StackPanel>
                    <TextBlock Text="REPORTE DE NOTAS DE CREDITO" FontSize="11" FontWeight="Bold"
                               Foreground="#C62828"/>
                    <TextBlock Text="Elija el periodo y la categoria, luego descargue el PDF."
                               FontSize="9" Foreground="#7A8A80" TextWrapping="Wrap" Margin="0,2,0,9"/>

                    <TextBlock Text="PERIODO" FontSize="9" FontWeight="Bold" Foreground="#55665C" Margin="0,0,0,3"/>
                    <CheckBox Content="General (todo el historial)"
                              IsChecked="{Binding is_general, Mode=TwoWay}"
                              FontSize="12" Foreground="#333333" Margin="0,0,0,4" Cursor="Hand"/>
                    <CheckBox Content="Mensual"
                              IsChecked="{Binding is_mensual, Mode=TwoWay}"
                              FontSize="12" Foreground="#333333" Cursor="Hand"/>

                    <StackPanel Margin="20,6,0,0"
                                Visibility="{Binding is_mensual, Converter={StaticResource BoolToVisible}}">
                        <TextBlock Text="MES" FontSize="9" FontWeight="Bold" Foreground="#55665C" Margin="0,0,0,2"/>
                        <ComboBox ItemsSource="{Binding month_options}"
                                  SelectedItem="{Binding selected_month, Mode=TwoWay}"
                                  FontSize="12" Height="25" Cursor="Hand"/>
                    </StackPanel>

                    <TextBlock Text="CATEGORIA" FontSize="9" FontWeight="Bold" Foreground="#55665C" Margin="0,10,0,3"/>
                    <ComboBox ItemsSource="{Binding category_options}"
                              SelectedItem="{Binding selected_category, Mode=TwoWay}"
                              FontSize="12" Height="25" Cursor="Hand"/>

                    <Button Content="Descargar PDF"
                            Background="#1B3A2D" Foreground="White" FontWeight="Bold"
                            FontSize="12.5" Height="30" BorderThickness="0" Cursor="Hand"
                            Margin="0,12,0,0" Click="on_descargar_reporte_click">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border x:Name="bd" Background="{TemplateBinding Background}" CornerRadius="4">
                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="bd" Property="Background" Value="#2E5A46"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>
                </StackPanel>
            </Border>
        </Popup>

        <!-- FILA 1: TABS DE VENDEDORES -->
        <TabControl Grid.Row="1" ItemsSource="{Binding seller_tabs}" SelectedItem="{Binding selected_tab, Mode=TwoWay}" Margin="0,0,0,4">
            <TabControl.ItemTemplate>
                <DataTemplate>
                    <TextBlock Text="{Binding Header}" FontWeight="SemiBold" FontSize="12.5"/>
                </DataTemplate>
            </TabControl.ItemTemplate>
            <TabControl.ContentTemplate>
                <DataTemplate>
                    <DataGrid Style="{StaticResource CompactDataGrid}"
                              ItemsSource="{Binding Items}" MouseDoubleClick="DataGrid_MouseDoubleClick">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="FECHA NC" Binding="{Binding fecha_nc_display}" Width="90"
                                            ElementStyle="{StaticResource CellTextCenter}"/>
                        <DataGridTextColumn Header="CATEGORIA" Binding="{Binding category}" Width="95"
                                            ElementStyle="{StaticResource CellTextCenter}"/>
                        <DataGridTextColumn Header="TIPO NOTA" Binding="{Binding note_type_name}" Width="95"
                                            ElementStyle="{StaticResource CellTextCenter}"/>
                        <DataGridTextColumn Header="NRO NC" Binding="{Binding note_number}" Width="105"
                                            ElementStyle="{StaticResource CellTextCenter}"/>
                        <DataGridTextColumn Header="NOTA DE ENTREGA" Binding="{Binding source_note_number}" Width="105"
                                            ElementStyle="{StaticResource CellTextCenter}"/>
                        <DataGridTextColumn Header="CLIENTE" Binding="{Binding customer_name}" Width="*"
                                            ElementStyle="{StaticResource CellTextWrap}"/>
                        <DataGridTextColumn Header="VENDEDOR" Binding="{Binding seller_name}" Width="80"
                                            ElementStyle="{StaticResource CellTextCenterWrap}"/>
                        <DataGridTextColumn Header="MONTO" Binding="{Binding total_amount_usd, StringFormat=N2}" Width="85">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock" BasedOn="{StaticResource CellTextCenter}">
                                    <Setter Property="Foreground" Value="#C62828"/>
                                    <Setter Property="FontWeight" Value="Bold"/>
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>
                        <DataGridTemplateColumn Header="ACCIONES" Width="132">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                        <Button Content="Vista Previa" Style="{StaticResource PreviewButton}"
                                                Click="PreviewButton_Click" Tag="{Binding}"/>
                                        <Button Content="PDF" Style="{StaticResource PdfButton}"
                                                Click="PdfButton_Click" Tag="{Binding}"/>
                                    </StackPanel>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>
            </DataTemplate>
        </TabControl.ContentTemplate>
        </TabControl>

        <!-- FILA 2: FOOTER -->
        <Border Grid.Row="2" Background="#C62828" Padding="10,5" CornerRadius="0,0,4,4">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                <TextBlock Text="{Binding total_label}" Foreground="#FDECEA" FontSize="12.5" VerticalAlignment="Center"/>
                <TextBlock Text="{Binding total_credit_usd, StringFormat=N2}" Foreground="White" FontSize="14.5"
                           FontWeight="Bold" VerticalAlignment="Center" Margin="4,0,0,0"/>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
