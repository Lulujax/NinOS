<Window x:Class="NinOS.UI.Views.CreditNoteDetailWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Nota de Credito"
        Width="980" Height="520"
        WindowStartupLocation="CenterOwner"
        WindowState="Maximized"
        ResizeMode="CanResizeWithGrip"
        Background="White">
    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- TARJETA DE CABECERA -->
        <Border Grid.Row="0" Background="#F0F6FC" BorderBrush="#C62828" BorderThickness="1"
                CornerRadius="4" Padding="12" Margin="0,0,0,8">
            <StackPanel>
                <!-- Fila 1: Nro NC / Nota original / Cliente / Vendedor -->
                <DockPanel LastChildFill="True">
                    <StackPanel Orientation="Horizontal" DockPanel.Dock="Left">
                        <TextBlock Text="Nro NC:" FontSize="15" FontWeight="Bold" Foreground="#C62828" VerticalAlignment="Center"/>
                        <TextBlock x:Name="TitleText" FontSize="16" FontWeight="Bold" Foreground="#C62828" Margin="6,0,22,0" VerticalAlignment="Center"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" DockPanel.Dock="Left">
                        <TextBlock Text="Nota de entrega:" FontSize="15" FontWeight="Bold" Foreground="#C62828" VerticalAlignment="Center"/>
                        <TextBlock x:Name="SourceText" FontSize="15" Foreground="#424242" Margin="6,0,22,0" VerticalAlignment="Center"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" DockPanel.Dock="Left">
                        <TextBlock Text="Cliente:" FontSize="15" FontWeight="Bold" Foreground="#C62828" VerticalAlignment="Center"/>
                        <TextBlock x:Name="CustomerText" FontSize="15" Foreground="#424242" Margin="6,0,22,0" VerticalAlignment="Center"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" DockPanel.Dock="Left">
                        <TextBlock Text="Vendedor:" FontSize="15" FontWeight="Bold" Foreground="#C62828" VerticalAlignment="Center"/>
                        <TextBlock x:Name="SellerText" FontSize="15" Foreground="#424242" Margin="6,0,0,0" VerticalAlignment="Center"/>
                    </StackPanel>
                </DockPanel>

                <!-- Fila 2: Totales -->
                <Border Background="White" BorderBrush="#E5C8C8" BorderThickness="1" CornerRadius="4" Margin="0,8,0,0" Padding="8,6">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" Orientation="Horizontal" Margin="0,0,30,0">
                            <TextBlock Text="FECHA DE EMISION:" FontSize="14" FontWeight="Bold" Foreground="#424242" VerticalAlignment="Center"/>
                            <TextBlock x:Name="DateText" FontSize="16" FontWeight="Bold" Foreground="#424242" Margin="6,0,0,0" VerticalAlignment="Center"/>
                        </StackPanel>
                        <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="0,0,30,0">
                            <TextBlock Text="TOTAL DEVUELTO (USD):" FontSize="14" FontWeight="Bold" Foreground="#424242" VerticalAlignment="Center"/>
                            <TextBlock x:Name="TotalText" FontSize="17" FontWeight="Bold" Foreground="#C62828" Margin="6,0,0,0" VerticalAlignment="Center"/>
                        </StackPanel>
                        <StackPanel Grid.Column="2" Orientation="Horizontal">
                            <TextBlock Text="CANTIDAD DEVUELTA:" FontSize="14" FontWeight="Bold" Foreground="#424242" VerticalAlignment="Center"/>
                            <TextBlock x:Name="QuantityText" FontSize="16" FontWeight="Bold" Foreground="#1565C0" Margin="6,0,0,0" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Grid>
                </Border>
            </StackPanel>
        </Border>

        <!-- GRID DE ITEMS DEVUELTOS -->
        <DataGrid Grid.Row="1" x:Name="DetailsGrid" AutoGenerateColumns="False"
                  AlternatingRowBackground="#FFF5F5" RowBackground="White"
                  CanUserAddRows="False" IsReadOnly="True" GridLinesVisibility="Horizontal"
                  HorizontalGridLinesBrush="#EEDCDC"
                  BorderBrush="#E0B4B4" BorderThickness="1" FontSize="14" RowHeight="35"
                  EnableRowVirtualization="True" CanUserResizeColumns="False">
            <DataGrid.Resources>
                <Style TargetType="DataGridColumnHeader">
                    <Setter Property="Background" Value="#C62828"/>
                    <Setter Property="Foreground" Value="White"/>
                    <Setter Property="FontWeight" Value="Bold"/>
                    <Setter Property="FontSize" Value="13"/>
                    <Setter Property="Padding" Value="4,0"/>
                </Style>
            </DataGrid.Resources>
            <DataGrid.Columns>
                <DataGridTextColumn Header="CODIGO" Binding="{Binding code}" Width="150"/>
                <DataGridTextColumn Header="DESCRIPCION" Binding="{Binding name}" Width="*"/>
                <DataGridTextColumn Header="CANTIDAD" Binding="{Binding quantity}" Width="100">
                    <DataGridTextColumn.HeaderStyle>
                        <Style TargetType="DataGridColumnHeader">
                            <Setter Property="HorizontalContentAlignment" Value="Center"/>
                        </Style>
                    </DataGridTextColumn.HeaderStyle>
                    <DataGridTextColumn.ElementStyle>
                        <Style TargetType="TextBlock">
                            <Setter Property="HorizontalAlignment" Value="Center"/>
                            <Setter Property="TextAlignment" Value="Center"/>
                        </Style>
                    </DataGridTextColumn.ElementStyle>
                </DataGridTextColumn>
                <DataGridTextColumn Header="PRECIO U." Binding="{Binding unit_price_usd, StringFormat={}{0:N2}}" Width="110">
                    <DataGridTextColumn.HeaderStyle>
                        <Style TargetType="DataGridColumnHeader">
                            <Setter Property="HorizontalContentAlignment" Value="Center"/>
                        </Style>
                    </DataGridTextColumn.HeaderStyle>
                    <DataGridTextColumn.ElementStyle>
                        <Style TargetType="TextBlock">
                            <Setter Property="HorizontalAlignment" Value="Center"/>
                            <Setter Property="TextAlignment" Value="Center"/>
                        </Style>
                    </DataGridTextColumn.ElementStyle>
                </DataGridTextColumn>
                <DataGridTextColumn Header="SUBTOTAL" Binding="{Binding subtotal_usd, StringFormat={}{0:N2}}" Width="120">
                    <DataGridTextColumn.HeaderStyle>
                        <Style TargetType="DataGridColumnHeader">
                            <Setter Property="HorizontalContentAlignment" Value="Center"/>
                        </Style>
                    </DataGridTextColumn.HeaderStyle>
                    <DataGridTextColumn.ElementStyle>
                        <Style TargetType="TextBlock">
                            <Setter Property="HorizontalAlignment" Value="Center"/>
                            <Setter Property="TextAlignment" Value="Center"/>
                            <Setter Property="FontWeight" Value="SemiBold"/>
                        </Style>
                    </DataGridTextColumn.ElementStyle>
                </DataGridTextColumn>
            </DataGrid.Columns>
        </DataGrid>

        <!-- PANEL DE ACCIONES -->
        <DockPanel Grid.Row="2" Margin="0,8,0,0" LastChildFill="False">
            <Button x:Name="BtnPdf" DockPanel.Dock="Left" Content="Generar PDF"
                    Background="#C62828" Foreground="White" FontWeight="SemiBold" FontSize="14"
                    Padding="10,5" BorderThickness="0" Cursor="Hand" Click="OnPdfClick">
                <Button.Template>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="{TemplateBinding Background}" CornerRadius="4" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#E53935"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="bd" Property="Background" Value="#E0B4B4"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Button.Template>
            </Button>
            <Button DockPanel.Dock="Left" Margin="8,0,0,0" Content="Cerrar" Background="#E0E0E0" Foreground="#424242"
                    FontSize="13" Padding="8,3" BorderThickness="0" Cursor="Hand" IsCancel="True"/>
        </DockPanel>
    </Grid>
</Window>