<Window x:Class="NinOS.UI.Views.PdfPreviewWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
        Title="Vista Previa de Documento" Height="600" Width="980"
        MaxHeight="{Binding Source={x:Static SystemParameters.WorkArea}, Path=Height}"
        MaxWidth="{Binding Source={x:Static SystemParameters.WorkArea}, Path=Width}"
        WindowState="Maximized"
        WindowStartupLocation="CenterScreen"
        Background="#F1F5F9"
        FontFamily="Segoe UI">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="52"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Barra Superior -->
        <Border Grid.Row="0" Background="#1E293B" BorderBrush="#0F172A" BorderThickness="0,0,0,1" Padding="14,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="📄" FontSize="18" Margin="0,0,8,0" VerticalAlignment="Center"/>
                    <TextBlock x:Name="TxtTitle" Text="Vista Previa" FontSize="15" FontWeight="Bold" Foreground="White" VerticalAlignment="Center"/>
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <!-- Botón Imprimir -->
                    <Button x:Name="BtnPrint" Click="BtnPrint_Click" Margin="0,0,8,0"
                            Padding="12,6" Cursor="Hand" Background="#0284C7" Foreground="White"
                            FontWeight="SemiBold" FontSize="12.5" BorderThickness="0">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border x:Name="bd" Background="{TemplateBinding Background}" CornerRadius="4" Padding="{TemplateBinding Padding}">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="🖨️ " FontSize="12"/>
                                        <TextBlock Text="Imprimir"/>
                                    </StackPanel>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="bd" Property="Background" Value="#0369A1"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>

                    <!-- Botón Descargar PDF -->
                    <Button x:Name="BtnDownloadPdf" Click="BtnDownloadPdf_Click" Margin="0,0,8,0"
                            Padding="12,6" Cursor="Hand" Background="#16A34A" Foreground="White"
                            FontWeight="SemiBold" FontSize="12.5" BorderThickness="0">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border x:Name="bd" Background="{TemplateBinding Background}" CornerRadius="4" Padding="{TemplateBinding Padding}">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="📄 " FontSize="12"/>
                                        <TextBlock Text="Descargar PDF"/>
                                    </StackPanel>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="bd" Property="Background" Value="#15803D"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>

                    <!-- Botón Descargar Excel -->
                    <Button x:Name="BtnDownloadExcel" Click="BtnDownloadExcel_Click" Margin="0,0,12,0"
                            Padding="12,6" Cursor="Hand" Background="#10B981" Foreground="White"
                            FontWeight="SemiBold" FontSize="12.5" BorderThickness="0"
                            Visibility="Collapsed">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border x:Name="bd" Background="{TemplateBinding Background}" CornerRadius="4" Padding="{TemplateBinding Padding}">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="📊 " FontSize="12"/>
                                        <TextBlock Text="Descargar Excel"/>
                                    </StackPanel>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="bd" Property="Background" Value="#059669"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>

                    <!-- Botón Cerrar -->
                    <Button Click="BtnClose_Click" IsCancel="True" Padding="12,6" Cursor="Hand"
                            Background="#475569" Foreground="White" FontWeight="SemiBold"
                            FontSize="12.5" BorderThickness="0">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border x:Name="bd" Background="{TemplateBinding Background}" CornerRadius="4" Padding="{TemplateBinding Padding}">
                                    <TextBlock Text="Cerrar"/>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="bd" Property="Background" Value="#334155"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Visor WebView2 -->
        <Grid Grid.Row="1">
            <wv2:WebView2 x:Name="PdfWebView" DefaultBackgroundColor="#F1F5F9"/>

            <!-- Indicador de Carga -->
            <Border x:Name="LoadingOverlay" Background="#F8FAFC" Opacity="0.95" Visibility="Visible">
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                    <ProgressBar IsIndeterminate="True" Width="200" Height="6" Margin="0,0,0,14" Foreground="#0284C7"/>
                    <TextBlock Text="Generando vista previa..." FontSize="14" FontWeight="SemiBold" Foreground="#475569" HorizontalAlignment="Center"/>
                </StackPanel>
            </Border>

            <!-- Panel de Fallback si no está el runtime -->
            <Border x:Name="FallbackOverlay" Background="#FFFBEB" BorderBrush="#FDE68A" BorderThickness="1"
                    CornerRadius="8" Padding="24" MaxWidth="540" MaxHeight="240"
                    HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed">
                <StackPanel HorizontalAlignment="Center">
                    <TextBlock Text="⚠️ Vista previa interna no disponible" FontSize="16" FontWeight="Bold" Foreground="#92400E" Margin="0,0,0,8" TextAlignment="Center"/>
                    <TextBlock Text="El componente Microsoft Edge WebView2 no pudo inicializarse en este equipo. El documento se generó correctamente y puede abrirlo con su visor de PDF predeterminado o enviarlo a imprimir."
                               FontSize="13" Foreground="#78350F" TextWrapping="Wrap" TextAlignment="Center" Margin="0,0,0,18"/>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                        <Button Click="BtnOpenExternal_Click" Content="Abrir con visor predeterminado" Padding="14,8"
                                Background="#D97706" Foreground="White" FontWeight="Bold" FontSize="13" Cursor="Hand" Margin="0,0,10,0"/>
                        <Button Click="BtnClose_Click" Content="Cerrar" Padding="14,8"
                                Background="#E2E8F0" Foreground="#334155" FontWeight="SemiBold" FontSize="13" Cursor="Hand"/>
                    </StackPanel>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</Window>
