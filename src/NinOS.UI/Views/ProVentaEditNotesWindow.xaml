<Window x:Class="NinOS.UI.Views.ProVentaEditNotesWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Editar Descuento y Monto de Notas - Pro Venta"
        Height="620" Width="840"
        MinHeight="550" MinWidth="750"
        WindowStartupLocation="CenterOwner" Background="#F5F5F5"
        ResizeMode="CanResizeWithGrip" FontSize="12">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- 1. Encabezado -->
        <TextBlock Grid.Row="0" Text="Editar Descuento y Monto de Notas" FontSize="16" FontWeight="Bold"
                   Foreground="#1565C0" Margin="0,0,0,6"/>

        <Border Grid.Row="1" Background="#E3F2FD" BorderBrush="#90CAF9" BorderThickness="1" CornerRadius="4"
                Padding="10,6" Margin="0,0,0,12">
            <TextBlock x:Name="RelationInfoText" FontSize="11.5" Foreground="#1565C0" FontWeight="SemiBold" TextWrapping="Wrap"/>
        </Border>

        <!-- 2. Tarjeta del Editor de Nota -->
        <Border Grid.Row="2" Background="White" BorderBrush="#B0BEC5" BorderThickness="1" CornerRadius="4"
                Padding="12" Margin="0,0,0,12">
            <StackPanel>
                <!-- Selector de nota -->
                <Grid Margin="0,0,0,10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="Seleccionar Nota:" FontWeight="Bold" VerticalAlignment="Center" Margin="0,0,10,0"/>
                    <ComboBox Grid.Column="1" x:Name="CmbNotes" DisplayMemberPath="DisplayLabel"
                              SelectionChanged="CmbNotes_SelectionChanged" Height="28" VerticalContentAlignment="Center"/>
                </Grid>

                <!-- Datos de la nota seleccionada -->
                <Grid Margin="0,0,0,12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="1.5*"/>
                        <ColumnDefinition Width="1*"/>
                        <ColumnDefinition Width="1*"/>
                        <ColumnDefinition Width="1.2*"/>
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0" Background="#F8F9FA" BorderBrush="#E0E0E0" BorderThickness="1" CornerRadius="3" Padding="8,4" Margin="0,0,6,0">
                        <StackPanel>
                            <TextBlock Text="CLIENTE" FontSize="9.5" Foreground="#757575" FontWeight="SemiBold"/>
                            <TextBlock x:Name="TxtCustomer" FontWeight="Bold" FontSize="11.5" TextWrapping="Wrap"/>
                        </StackPanel>
                    </Border>

                    <Border Grid.Column="1" Background="#F8F9FA" BorderBrush="#E0E0E0" BorderThickness="1" CornerRadius="3" Padding="8,4" Margin="0,0,6,0">
                        <StackPanel>
                            <TextBlock Text="MONTO BASE (SIN DCTO)" FontSize="9.5" Foreground="#757575" FontWeight="SemiBold"/>
                            <TextBlock x:Name="TxtGrossAmount" FontWeight="Bold" FontSize="12" Foreground="#1565C0"/>
                        </StackPanel>
                    </Border>

                    <Border Grid.Column="2" Background="#F8F9FA" BorderBrush="#E0E0E0" BorderThickness="1" CornerRadius="3" Padding="8,4" Margin="0,0,6,0">
                        <StackPanel>
                            <TextBlock Text="DESCUENTO ACTUAL" FontSize="9.5" Foreground="#757575" FontWeight="SemiBold"/>
                            <TextBlock x:Name="TxtCurrentDiscount" FontWeight="Bold" FontSize="12"/>
                        </StackPanel>
                    </Border>

                    <Border Grid.Column="3" Background="#F8F9FA" BorderBrush="#E0E0E0" BorderThickness="1" CornerRadius="3" Padding="8,4">
                        <StackPanel>
                            <TextBlock Text="MONTO A COBRAR ACTUAL" FontSize="9.5" Foreground="#757575" FontWeight="SemiBold"/>
                            <TextBlock x:Name="TxtCurrentAdjusted" FontWeight="Bold" FontSize="12" Foreground="#2E7D32"/>
                        </StackPanel>
                    </Border>
                </Grid>

                <Separator Background="#E0E0E0" Margin="0,0,0,10"/>

                <!-- Controles interactivos de edición -->
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- Edición de Descuento -->
                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,14,0">
                        <TextBlock Text="Nuevo Descuento:" FontWeight="Bold" VerticalAlignment="Center" Margin="0,0,6,0"/>
                        <TextBox x:Name="TxtDiscount" Width="65" Height="26" FontSize="12" TextAlignment="Center"
                                 VerticalContentAlignment="Center" TextChanged="TxtDiscount_TextChanged"/>
                        <TextBlock Text="%" FontWeight="Bold" VerticalAlignment="Center" Margin="3,0,0,0" Foreground="#555555"/>
                    </StackPanel>

                    <!-- Botones rápidos de descuento -->
                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,18,0">
                        <Button Content="0% (Sin Dcto)" Padding="7,3" Margin="2" FontSize="10.5" Cursor="Hand"
                                Background="#E3F2FD" BorderBrush="#90CAF9" BorderThickness="1" Foreground="#1565C0"
                                FontWeight="SemiBold" Click="QuickDiscount_Click" Tag="0"/>
                        <Button Content="5%" Padding="7,3" Margin="2" FontSize="10.5" Cursor="Hand"
                                Background="#F5F5F5" BorderBrush="#E0E0E0" BorderThickness="1" Foreground="#424242"
                                Click="QuickDiscount_Click" Tag="5"/>
                        <Button Content="10%" Padding="7,3" Margin="2" FontSize="10.5" Cursor="Hand"
                                Background="#F5F5F5" BorderBrush="#E0E0E0" BorderThickness="1" Foreground="#424242"
                                Click="QuickDiscount_Click" Tag="10"/>
                        <Button Content="15%" Padding="7,3" Margin="2" FontSize="10.5" Cursor="Hand"
                                Background="#F5F5F5" BorderBrush="#E0E0E0" BorderThickness="1" Foreground="#424242"
                                Click="QuickDiscount_Click" Tag="15"/>
                    </StackPanel>

                    <!-- Edición de Monto -->
                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,16,0">
                        <TextBlock Text="Nuevo Monto USD:" FontWeight="Bold" VerticalAlignment="Center" Margin="0,0,6,0"/>
                        <TextBox x:Name="TxtAmount" Width="100" Height="26" FontSize="12" TextAlignment="Center"
                                 FontWeight="Bold" Foreground="#1565C0" VerticalContentAlignment="Center"
                                 TextChanged="TxtAmount_TextChanged"/>
                    </StackPanel>

                    <!-- Botón Guardar Cambio -->
                    <Button Grid.Column="3" x:Name="BtnSave" Content="Guardar Cambio" Padding="14,5"
                            Background="#2E7D32" Foreground="White" FontWeight="Bold" FontSize="11.5"
                            BorderThickness="0" Cursor="Hand" Click="BtnSave_Click">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border x:Name="bd" Background="{TemplateBinding Background}" CornerRadius="3"
                                        Padding="{TemplateBinding Padding}">
                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="bd" Property="Background" Value="#388E3C"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>
                </Grid>

                <!-- Mensaje de estado -->
                <TextBlock x:Name="StatusMessage" FontSize="11" FontWeight="SemiBold" Margin="0,8,0,0"
                           Visibility="Collapsed" TextWrapping="Wrap"/>
            </StackPanel>
        </Border>

        <!-- 3. Tabla con todas las notas de la relación -->
        <Border Grid.Row="3" Background="White" BorderBrush="#B0BEC5" BorderThickness="1" CornerRadius="4" Padding="6">
            <DockPanel>
                <TextBlock DockPanel.Dock="Top" Text="Notas de la Relación (Seleccione una fila para editarla):"
                           FontSize="11" Foreground="#555555" Margin="4,2,0,6" FontWeight="SemiBold"/>

                <DataGrid x:Name="NotesGrid" AutoGenerateColumns="False" IsReadOnly="True"
                          SelectionMode="Single" CanUserAddRows="False" CanUserDeleteRows="False"
                          HeadersVisibility="Column" GridLinesVisibility="Horizontal"
                          HorizontalGridLinesBrush="#E0E0E0" Background="White" BorderThickness="0"
                          SelectionChanged="NotesGrid_SelectionChanged">
                    <DataGrid.ColumnHeaderStyle>
                        <Style TargetType="DataGridColumnHeader">
                            <Setter Property="Background" Value="#1565C0"/>
                            <Setter Property="Foreground" Value="White"/>
                            <Setter Property="FontWeight" Value="Bold"/>
                            <Setter Property="FontSize" Value="10.5"/>
                            <Setter Property="Padding" Value="6,4"/>
                            <Setter Property="HorizontalContentAlignment" Value="Center"/>
                        </Style>
                    </DataGrid.ColumnHeaderStyle>
                    <DataGrid.RowStyle>
                        <Style TargetType="DataGridRow">
                            <Style.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter Property="Background" Value="#E3F2FD"/>
                                </Trigger>
                                <Trigger Property="IsSelected" Value="True">
                                    <Setter Property="Background" Value="#BBDEFB"/>
                                    <Setter Property="Foreground" Value="Black"/>
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </DataGrid.RowStyle>
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="NOTA" Binding="{Binding note_number}" Width="1.2*"
                                            ElementStyle="{StaticResource CenterCellStyle}"/>
                        <DataGridTemplateColumn Header="CLIENTE" Width="2.8*">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding customer_name}" Margin="6,3" VerticalAlignment="Center" TextWrapping="Wrap"/>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTextColumn Header="MONTO BASE ($)" Binding="{Binding gross_total_usd, StringFormat=N2}" Width="1.4*"
                                            ElementStyle="{StaticResource CenterCellStyle}"/>
                        <DataGridTextColumn Header="DCTO %" Binding="{Binding discount_percentage_text}" Width="1*"
                                            ElementStyle="{StaticResource CenterCellStyle}"/>
                        <DataGridTextColumn Header="MONTO A COBRAR ($)" Binding="{Binding amount, StringFormat=N2}" Width="1.5*"
                                            ElementStyle="{StaticResource CenterCellStyle}"/>
                        <DataGridTextColumn Header="ESTADO" Binding="{Binding status}" Width="1*"
                                            ElementStyle="{StaticResource CenterCellStyle}"/>
                    </DataGrid.Columns>
                </DataGrid>
            </DockPanel>
        </Border>

        <!-- 4. Resumen y Totalizador de la Relación -->
        <Border Grid.Row="4" Background="#E3F2FD" BorderBrush="#1565C0" BorderThickness="1" CornerRadius="3"
                Padding="10,6" Margin="0,10,0,10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="TOTALES DE LA RELACIÓN:" FontWeight="Bold" Foreground="#1565C0" VerticalAlignment="Center"/>
                <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="0,0,24,0">
                    <TextBlock Text="Total Base (Sin Dcto): " Foreground="#555555" VerticalAlignment="Center"/>
                    <TextBlock x:Name="TxtTotalGross" FontWeight="Bold" Foreground="#1565C0" VerticalAlignment="Center"/>
                </StackPanel>
                <StackPanel Grid.Column="2" Orientation="Horizontal">
                    <TextBlock Text="Total a Cobrar Relación: " Foreground="#555555" VerticalAlignment="Center"/>
                    <TextBlock x:Name="TxtTotalAdjusted" FontWeight="Bold" Foreground="#2E7D32" FontSize="13" VerticalAlignment="Center"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- 5. Barra Inferior con Botón Cerrar -->
        <StackPanel Grid.Row="5" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="Cerrar" Padding="18,6" Background="#757575" Foreground="White"
                    FontWeight="SemiBold" BorderThickness="0" Cursor="Hand" Click="BtnClose_Click">
                <Button.Template>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="{TemplateBinding Background}" CornerRadius="3"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#616161"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Button.Template>
            </Button>
        </StackPanel>
    </Grid>
</Window>
