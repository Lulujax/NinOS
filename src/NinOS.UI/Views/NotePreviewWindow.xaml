<Window x:Class="NinOS.UI.Views.NotePreviewWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Vista Previa - Nota de Entrega"
        Width="760" Height="600"
        MaxHeight="{Binding Source={x:Static SystemParameters.WorkArea}, Path=Height}"
        MaxWidth="{Binding Source={x:Static SystemParameters.WorkArea}, Path=Width}"
        WindowState="Maximized"
        WindowStartupLocation="CenterScreen"
        ResizeMode="CanResizeWithGrip"
        Background="White">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel x:Name="NotePanel" Margin="16" Width="700"/>
        </ScrollViewer>
        <Button Click="OnCancel" Content="✕ Cerrar" 
                HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,12,24,0"
                Padding="10,5" Background="#64748B" Foreground="White" FontWeight="Bold" FontSize="12"
                Cursor="Hand" BorderThickness="0">
            <Button.Template>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="bd" Background="{TemplateBinding Background}" CornerRadius="4" Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="bd" Property="Background" Value="#475569"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Button.Template>
        </Button>
        <Border Grid.Row="1" Background="#F0F4EC" BorderBrush="#B0B0B0" BorderThickness="0,1,0,0" Padding="12">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button x:Name="CancelButton" IsCancel="True" Content="Cancelar" Width="110" Height="36" Margin="0,0,8,0" Background="#888888" Foreground="White" FontWeight="Bold" Cursor="Hand" Click="OnCancel"/>
                <Button x:Name="SaveOnlyButton" Content="Guardar" Width="130" Height="36" Margin="0,0,8,0" Background="#2196F3" Foreground="White" FontWeight="Bold" Cursor="Hand" Click="OnSaveOnly"/>
                <Button x:Name="SavePdfButton" Content="Guardar y PDF" Width="140" Height="36" Margin="0,0,8,0" Background="#4CAF50" Foreground="White" FontWeight="Bold" Cursor="Hand" Click="OnSavePdf"/>
                <Button x:Name="DirectPrintButton" Content="🖨️ Imprimir" Width="120" Height="36" Margin="0,0,8,0" Background="#0284C7" Foreground="White" FontWeight="Bold" Cursor="Hand" Click="OnDirectPrint" Visibility="Collapsed"/>
                <Button x:Name="ExcelButton" Content="📊 Excel" Width="110" Height="36" Background="#16A34A" Foreground="White" FontWeight="Bold" Cursor="Hand" Click="OnExcel" Visibility="Collapsed"/>
            </StackPanel>
        </Border>
    </Grid>
</Window>
