<UserControl x:Class="NinOS.UI.Views.InventoryView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:converters="clr-namespace:NinOS.UI.Converters"
             Background="White">
    <UserControl.Resources>
        <converters:BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />
        <converters:InverseBooleanToVisibilityConverter x:Key="InverseBooleanToVisibilityConverter" />
        <converters:StringToVisibilityConverter x:Key="StringToVisibilityConverter" />
        <Style x:Key="CompactDataGrid" TargetType="DataGrid">
            <Setter Property="AutoGenerateColumns" Value="False"/>
            <Setter Property="IsReadOnly" Value="True"/>
            <Setter Property="GridLinesVisibility" Value="Horizontal"/>
            <Setter Property="HeadersVisibility" Value="Column"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush" Value="#E0E0E0"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="RowHeaderWidth" Value="0"/>
            <Setter Property="CanUserAddRows" Value="False"/>
            <Setter Property="CanUserDeleteRows" Value="False"/>
            <Setter Property="CanUserReorderColumns" Value="False"/>
            <Setter Property="CanUserResizeColumns" Value="False"/>
            <Setter Property="SelectionMode" Value="Single"/>
            <Setter Property="EnableRowVirtualization" Value="True"/>
            <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="MinRowHeight" Value="20"/>
        </Style>
        <Style x:Key="CellText" TargetType="TextBlock">
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
        </Style>
        <Style x:Key="CellTextCenter" TargetType="TextBlock" BasedOn="{StaticResource CellText}">
            <Setter Property="HorizontalAlignment" Value="Center"/>
            <Setter Property="TextAlignment" Value="Center"/>
        </Style>
        <Style x:Key="HeaderActionButton" TargetType="Button">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="12.5"/>
            <Setter Property="Padding" Value="10,4"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="{TemplateBinding Background}" CornerRadius="4"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Opacity" Value="0.85"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="RowEditButton" TargetType="Button">
            <Setter Property="Padding" Value="6,2"/>
            <Setter Property="Margin" Value="1"/>
            <Setter Property="FontSize" Value="10"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="#FFF3E0" CornerRadius="3" Padding="{TemplateBinding Padding}"
                                Margin="{TemplateBinding Margin}" BorderBrush="#FFE0B2" BorderThickness="1">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                                              TextElement.Foreground="#E65100"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#FFE0B2"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <!-- Boton de la barra superior: mismo diseno que el Editar de las filas, pero con tamano de barra -->
        <Style x:Key="HeaderAddButton" TargetType="Button" BasedOn="{StaticResource RowEditButton}">
            <Setter Property="Padding" Value="14,6"/>
            <Setter Property="Margin" Value="0"/>
            <Setter Property="FontSize" Value="12.5"/>
        </Style>
        <Style x:Key="RowDeleteButton" TargetType="Button">
            <Setter Property="Padding" Value="6,2"/>
            <Setter Property="Margin" Value="1"/>
            <Setter Property="FontSize" Value="10"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="#FFEBEE" CornerRadius="3" Padding="{TemplateBinding Padding}"
                                Margin="{TemplateBinding Margin}" BorderBrush="#FFCDD2" BorderThickness="1">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                                              TextElement.Foreground="#C62828"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#FFCDD2"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Border Background="#F4F4F4" CornerRadius="4" Grid.Row="0" Margin="0,0,0,10" Padding="15">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock FontWeight="Bold" Margin="0,0,10,0" Text="Buscar Producto o Combo:" VerticalAlignment="Center"/>
                    <!-- Buscador con lupa (mismo estilo que los demas modulos) -->
                    <Border Background="White" CornerRadius="4" BorderBrush="#E0E0E0" BorderThickness="1">
                        <Grid Width="240">
                            <TextBlock Text="&#x1F50D;" Margin="8,0,0,0" VerticalAlignment="Center" FontSize="13.5" Foreground="#9E9E9E"/>
                            <TextBox Margin="26,2,8,2" BorderThickness="0" Background="Transparent"
                                     VerticalContentAlignment="Center" FontSize="12.5"
                                     Text="{Binding search_query, UpdateSourceTrigger=PropertyChanged}"/>
                        </Grid>
                    </Border>
                    <Button x:Name="btn_price_list" Style="{StaticResource HeaderActionButton}" Background="#1B3A2D"
                        Click="on_generate_price_list_click" Content="Descargar lista de precios"
                        Margin="10,0,0,0"/>
                </StackPanel>

                <ProgressBar Grid.Column="2" Width="100" Height="20" IsIndeterminate="{Binding IsLoading}" Margin="0,0,10,0" VerticalAlignment="Center" Visibility="{Binding IsLoading, Converter={StaticResource BooleanToVisibilityConverter}}"/>

                <Button Grid.Column="3" Style="{StaticResource HeaderAddButton}"
                        Command="{Binding open_add_window_command}" Content="{Binding add_button_text}"/>
            </Grid>
        </Border>

        <Border Grid.Row="1" Background="#FFE6E6" CornerRadius="4" Padding="10" Margin="0,0,0,10" Visibility="{Binding ErrorMessage, Converter={StaticResource StringToVisibilityConverter}}">
            <TextBlock Text="{Binding ErrorMessage}" Foreground="#CC0000" FontWeight="Bold" TextWrapping="Wrap"/>
        </Border>

        <!-- POPUP: seleccion de marcas/categorias para la lista de precios -->
        <Popup x:Name="popup_price_list"
               PlacementTarget="{Binding ElementName=btn_price_list}"
               Placement="Bottom"
               StaysOpen="False"
               AllowsTransparency="True"
               PopupAnimation="Fade">
            <Border Background="White" BorderBrush="#C9D3C7" BorderThickness="1" CornerRadius="4"
                    Padding="12,10" Width="250">
                <StackPanel>
                    <TextBlock Text="LISTA DE PRECIOS" FontSize="11" FontWeight="Bold"
                               Foreground="#1B3A2D"/>
                    <TextBlock Text="Marque las marcas/categorias que quiere incluir en el PDF."
                               FontSize="9" Foreground="#7A8A80" TextWrapping="Wrap" Margin="0,2,0,8"/>

                    <CheckBox Content="Todas a la vez"
                              IsChecked="{Binding all_brands_selected, Mode=TwoWay}"
                              FontSize="12" FontWeight="Bold" Foreground="#333333" Margin="0,0,0,6" Cursor="Hand"/>
                    <Button Content="Quitar todas" Background="Transparent" Foreground="#C62828"
                            FontWeight="SemiBold" FontSize="11" BorderThickness="0" Cursor="Hand"
                            HorizontalAlignment="Left" Margin="0,-4,0,6"
                            Command="{Binding clear_price_list_command}"/>

                    <ItemsControl ItemsSource="{Binding price_list_brand_options}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <CheckBox Content="{Binding name}"
                                          IsChecked="{Binding is_checked, Mode=TwoWay}"
                                          FontSize="12" Foreground="#333333" Margin="4,2,0,2" Cursor="Hand"/>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <Button Content="Descargar PDF"
                            Background="#1B3A2D" Foreground="White" FontWeight="Bold"
                            FontSize="12.5" Height="30" BorderThickness="0" Cursor="Hand"
                            Margin="0,12,0,0" Click="on_download_price_list_click">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border x:Name="bd" Background="{TemplateBinding Background}" CornerRadius="4">
                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="bd" Property="Background" Value="#2E5A46"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>
                </StackPanel>
            </Border>
        </Popup>

        <TabControl Grid.Row="2" SelectedIndex="{Binding selected_tab_index, UpdateSourceTrigger=PropertyChanged}">
            <TabItem Header="Todos">
                <DataGrid Style="{StaticResource CompactDataGrid}" ItemsSource="{Binding todos_list}" MouseDoubleClick="DataGrid_MouseDoubleClick">
                    <DataGrid.Columns>
                        <DataGridTextColumn Binding="{Binding RowNumber}" Header="#" Width="50"/>
                        <DataGridTextColumn Binding="{Binding item_code}" Header="Código" Width="110"/>
                        <DataGridTextColumn Binding="{Binding item_name}" Header="Nombre / Combo" Width="*"
                          ElementStyle="{StaticResource CellText}"/>
                        <DataGridTextColumn Binding="{Binding item_category}" Header="Categoría" Width="120"/>
                        <DataGridTextColumn Binding="{Binding item_quantity}" FontWeight="Bold" Header="Disponibles" Width="90"/>
                        <DataGridTextColumn Binding="{Binding item_price}" Header="Precio ($)" Width="100"/>
                        <DataGridTemplateColumn Header="Acciones" Width="180">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <StackPanel HorizontalAlignment="Center" Orientation="Horizontal">
                                        <StackPanel Orientation="Horizontal" Visibility="{Binding is_promotion, Converter={StaticResource InverseBooleanToVisibilityConverter}}">
                                            <Button Style="{StaticResource RowEditButton}" Command="{Binding DataContext.edit_command, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" Content="Editar"/>
                                            <Button Style="{StaticResource RowDeleteButton}" Command="{Binding DataContext.delete_command, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" Content="Borrar"/>
                                        </StackPanel>
                                        <StackPanel Orientation="Horizontal" Visibility="{Binding is_promotion, Converter={StaticResource BooleanToVisibilityConverter}}">
                                            <Button Style="{StaticResource RowEditButton}" Command="{Binding DataContext.edit_promotion_command, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" Content="Editar"/>
                                            <Button Style="{StaticResource RowDeleteButton}" Command="{Binding DataContext.delete_promotion_command, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" Content="Borrar"/>
                                        </StackPanel>
                                    </StackPanel>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>
            </TabItem>

