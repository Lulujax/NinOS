                        <DataGridTextColumn Binding="{Binding item_code}" Header="Código" Width="90"/>
                        <DataGridTextColumn Binding="{Binding item_name}" Header="Nombre del Combo/Kit" Width="*"
                          ElementStyle="{StaticResource CellText}"/>
                        <DataGridTextColumn Binding="{Binding promo_type_display}" Header="Tipo" Width="70"/>
                        <DataGridTextColumn Binding="{Binding item_quantity}" FontWeight="Bold" Header="Disponibles" Width="90"/>
                        <DataGridTextColumn Binding="{Binding item_price}" Header="Precio ($)" Width="100"/>
                        <DataGridTemplateColumn Header="Acciones" Width="180">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <StackPanel HorizontalAlignment="Center" Orientation="Horizontal">
                                        <Button Style="{StaticResource RowEditButton}" Command="{Binding DataContext.edit_promotion_command, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" Content="Editar"/>
                                        <Button Style="{StaticResource RowDeleteButton}" Command="{Binding DataContext.delete_promotion_command, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" Content="Borrar"/>
                                    </StackPanel>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>
            </TabItem>
        </TabControl>
    </Grid>
</UserControl>