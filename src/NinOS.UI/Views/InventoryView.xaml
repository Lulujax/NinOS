<UserControl x:Class="NinOS.UI.Views.InventoryView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="White">
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="#F4F4F4" Padding="15" Margin="0,0,0,10" CornerRadius="4">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="Buscar Producto:" FontWeight="Bold" VerticalAlignment="Center" Margin="0,0,10,0"/>
                    <TextBox Width="300" Text="{Binding search_query, UpdateSourceTrigger=PropertyChanged}" Padding="6" FontSize="14" />
                </StackPanel>

                <Button Grid.Column="2" Content="+ Añadir Producto" Command="{Binding open_add_window_command}" Padding="20,8" Background="#0078D7" Foreground="White" FontWeight="Bold" Cursor="Hand"/>
            </Grid>
        </Border>

        <TabControl Grid.Row="1" SelectedIndex="{Binding selected_tab_index, UpdateSourceTrigger=PropertyChanged}">
            <!-- Pestaña: Todos -->
            <TabItem Header="Todos">
                <DataGrid ItemsSource="{Binding products_list}" AutoGenerateColumns="False" IsReadOnly="True" AlternatingRowBackground="#F9F9F9" HeadersVisibility="Column" RowHeight="40" Margin="5">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="#" Binding="{Binding id_product}" Width="50" />
                        <DataGridTextColumn Header="Código" Binding="{Binding product_code}" Width="100" />
                        <DataGridTextColumn Header="Nombre" Binding="{Binding name}" Width="*" />
                        <DataGridTextColumn Header="Categoría" Binding="{Binding category}" Width="120" />
                        <DataGridTextColumn Header="Cantidad" Binding="{Binding stock_quantity}" Width="90" />
                        <DataGridTextColumn Header="Precio ($)" Binding="{Binding unit_price_usd}" Width="100" />
                        <DataGridTemplateColumn Header="Acciones" Width="140">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                        <Button Content="Editar" Command="{Binding DataContext.edit_command, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" Margin="0,0,10,0" Padding="10,5" Background="#E0E0E0" Cursor="Hand" />
                                        <Button Content="Borrar" Command="{Binding DataContext.delete_command, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" Padding="10,5" Background="#FFCDD2" Cursor="Hand" />
                                    </StackPanel>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>
            </TabItem>

            <!-- Pestaña: Defile -->
