<Window x:Class="NinOS.UI.Views.SplashWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        WindowStartupLocation="CenterScreen" ShowInTaskbar="False" ResizeMode="NoResize"
        Width="420" Height="440">

    <Border Background="#161A1F" CornerRadius="24">
        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
            <Image Name="LogoImage" Source="/Assets/ninOS_logo.png" Width="200" Height="200" Stretch="Uniform" />

            <TextBlock x:Name="QuoteText" Text="" FontSize="13" FontStyle="Italic" Foreground="#C9D6CF"
                       HorizontalAlignment="Center" Margin="24,18,24,0" TextWrapping="Wrap"
                       TextAlignment="Center" MaxWidth="340" FontWeight="SemiBold" />

            <StackPanel x:Name="LoadingPanel" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,8,0,0">
                <TextBlock Text="Cargando" FontSize="13" Foreground="#9AA4B0"
                           VerticalAlignment="Center" />
                <TextBlock x:Name="DotsText" Text="..." FontSize="13" Foreground="#9AA4B0"
                           VerticalAlignment="Center" Width="28" />
            </StackPanel>

            <StackPanel x:Name="ReadyPanel" Orientation="Horizontal" HorizontalAlignment="Center"
                        Margin="0,8,0,0" Visibility="Collapsed">
                <TextBlock Text="&#x2714;" FontSize="14" Foreground="#4CAF50"
                           VerticalAlignment="Center" />
                <TextBlock Text="¡Todo listo!" FontSize="13" Foreground="#9AA4B0"
                           VerticalAlignment="Center" Margin="6,0,0,0" />
            </StackPanel>

            <Border Width="220" Height="6" CornerRadius="3" Background="#2A3138"
                    HorizontalAlignment="Center" Margin="0,14,0,0" ClipToBounds="True">
                <Rectangle x:Name="ProgressRect" Width="60" Height="6" RadiusX="3" RadiusY="3"
                           Fill="#C9A227" HorizontalAlignment="Left" />
            </Border>
        </StackPanel>
    </Border>
</Window>