<Window x:Class="NinOS.UI.Views.SplashWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        WindowStartupLocation="CenterScreen" ShowInTaskbar="True" ResizeMode="CanMinimize"
        Title="NinOS - Cargando..."
        Icon="/Assets/ninOS_logo.png"
        Width="520" Height="540">

    <Border Background="#161A1F" CornerRadius="24" MouseLeftButtonDown="Border_MouseLeftButtonDown">
        <Grid>
            <!-- Boton Minimizar -->
            <Button HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,14,18,0"
                    Click="MinimizeButton_Click" Background="Transparent" BorderThickness="0"
                    Cursor="Hand" ToolTip="Minimizar">
                <Button.Template>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Width="28" Height="28" CornerRadius="14" Background="Transparent">
                            <TextBlock Text="—" FontSize="13" FontWeight="Bold" Foreground="#8A96A0"
                                       HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,-2,0,0"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#252C34"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Button.Template>
            </Button>

            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                <!-- 300 = 200 original + 50%. Para que el aumento se note de verdad, la ventana
                     tambien crecio (520x520) y la barra de progreso y los textos seorzaron en
                     proporción: el bloque completo queda en ~400 de alto y no se corta nada. -->
                <Image Name="LogoImage" Source="/Assets/ninOS_logo.png" Width="300" Height="300" Stretch="Uniform" />

                <TextBlock x:Name="QuoteText" Text="" FontSize="14.5" FontStyle="Italic" Foreground="#C9D6CF"
                           HorizontalAlignment="Center" Margin="24,16,24,0" TextWrapping="Wrap"
                           TextAlignment="Center" MaxWidth="420" FontWeight="SemiBold" />

                <StackPanel x:Name="LoadingPanel" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,8,0,0">
                    <TextBlock Text="Cargando" FontSize="13" Foreground="#9AA4B0"
                               VerticalAlignment="Center" />
                    <TextBlock x:Name="DotsText" Text="..." FontSize="13" Foreground="#9AA4B0"
                               VerticalAlignment="Center" Width="28" />
                </StackPanel>

                <StackPanel x:Name="ReadyPanel" Orientation="Horizontal" HorizontalAlignment="Center"
                            Margin="0,8,0,0" Visibility="Collapsed">
                    <TextBlock Text="&#x2714;" FontSize="14" Foreground="#4CAF50"
                               VerticalAlignment="Center" />
                    <TextBlock Text="¡Todo listo!" FontSize="13" Foreground="#9AA4B0"
                               VerticalAlignment="Center" Margin="6,0,0,0" />
                </StackPanel>

                <Border Width="280" Height="7" CornerRadius="4" Background="#2A3138"
                        HorizontalAlignment="Center" Margin="0,16,0,0" ClipToBounds="True">
                    <Rectangle x:Name="ProgressRect" Width="76" Height="7" RadiusX="4" RadiusY="4"
                               Fill="#C9A227" HorizontalAlignment="Left" />
                </Border>
            </StackPanel>
        </Grid>
    </Border>
</Window>