<Window x:Class="NinOS.UI.Views.AddPromotionWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Promocion" Height="640" Width="980"
        WindowStartupLocation="CenterOwner" Background="#F5F5F5"
        ResizeMode="CanResizeWithGrip" FontSize="12" MinHeight="560" MinWidth="900">
    <Window.Resources>
        <!-- Mismo lenguaje visual que el boton Editar de las filas del inventario -->
        <Style x:Key="AddProductButton" TargetType="Button">
            <Setter Property="Padding" Value="8,3"/>
            <Setter Property="Margin" Value="3,0"/>
            <Setter Property="FontSize" Value="10.5"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="#FFF3E0" CornerRadius="3"
                                Padding="{TemplateBinding Padding}" Margin="{TemplateBinding Margin}"
                                BorderBrush="#FFE0B2" BorderThickness="1">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                                              TextElement.Foreground="#E65100"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#FFE0B2"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>
    <Grid Margin="14">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- TITULO -->
        <TextBlock Grid.Row="0" FontSize="14" FontWeight="Bold" Foreground="#C62828" Margin="0,0,0,10">
            <TextBlock.Style>
                <Style TargetType="TextBlock">
                    <Setter Property="Text" Value="Nueva Promocion"/>
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding is_editing_promotion}" Value="True">
                            <Setter Property="Text" Value="Editar Promocion"/>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </TextBlock.Style>
        </TextBlock>

        <!-- AVISO AL EDITAR: la tabla de abajo ya trae la composicion guardada -->
        <Border Grid.Row="1" Background="#FFF8E1" BorderBrush="#F0A500" BorderThickness="1"
                CornerRadius="3" Padding="9" Margin="0,0,0,8"
                Visibility="{Binding is_editing_promotion, Converter={StaticResource BooleanToVisibilityConverter}}">
            <TextBlock FontSize="11" Foreground="#8A6D3B" TextWrapping="Wrap"
                       Text="La tabla COMPOSICION ya trae los productos que tiene esta promocion guardados. Quita con la X lo que ya no quieras, cambia las cantidades y guarda."/>
        </Border>

        <!-- TIPO -->
        <Grid Grid.Row="2" Margin="0,0,0,6">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="170"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0" VerticalAlignment="Center"><Run Text="Tipo:"/><Run Text="*" Foreground="Red"/></TextBlock>
            <ComboBox x:Name="TypeCombo" Grid.Column="1" SelectedIndex="{Binding promo_type_index}"
                      Height="26" FontSize="11" Width="280" HorizontalAlignment="Left"
                      HorizontalContentAlignment="Left" ToolTip="Define el codigo y la regla de la promocion">
                <ComboBoxItem Content="Producto Individual en Oferta"/>
                <ComboBoxItem Content="Armar Nuevo Kit"/>
                <ComboBoxItem Content="Armar Nuevo Combo"/>
            </ComboBox>
        </Grid>

        <!-- NOMBRE Y PRECIO -->
        <Grid Grid.Row="3" Margin="0,0,0,8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="170"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="170"/>
                <ColumnDefinition Width="140"/>
            </Grid.ColumnDefinitions>
            <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                <TextBlock Text="Nombre:"/>
                <TextBlock Text=" *" Foreground="Red"
                           Visibility="{Binding promo_type_index, Converter={StaticResource IntEqualsToVisibilityConverter}, ConverterParameter=not:0}"/>
            </StackPanel>
            <TextBox x:Name="NameBox" Grid.Column="1" Height="26" FontSize="11" VerticalContentAlignment="Center"
                     Padding="4,0" Margin="0,0,10,0" MaxLength="120"
                     Text="{Binding new_promo_name, UpdateSourceTrigger=PropertyChanged}"
                     ToolTip="En oferta individual se arma solo con el nombre del producto"/>
            <TextBlock Grid.Column="2" VerticalAlignment="Center" HorizontalAlignment="Right" Margin="0,0,8,0">
                <Run Text="Precio Total ($):"/><Run Text="*" Foreground="Red"/>
            </TextBlock>
            <TextBox x:Name="PriceBox" Grid.Column="3" Height="26" FontSize="11" VerticalContentAlignment="Center"
                     Padding="4,0" MaxLength="10" PreviewTextInput="OnPricePreview"
                     Text="{Binding new_promo_price, UpdateSourceTrigger=PropertyChanged}"/>
        </Grid>

        <!-- BUSCADOR + TABLA DE COMPOSICION -->
        <Grid Grid.Row="4" Margin="0,0,0,6">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="330"/>
                <ColumnDefinition Width="12"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Grid Grid.Column="0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0" FontWeight="Bold" Margin="0,0,0,4"><Run Text="Buscar Producto"/><Run Text=" *" Foreground="Red"/></TextBlock>

                <TextBox x:Name="SearchBox" Grid.Row="1" Height="26" FontSize="11" VerticalContentAlignment="Center"
                         Padding="4,0" Margin="0,0,0,6"
                         Text="{Binding promo_search_query, UpdateSourceTrigger=PropertyChanged}"
                         ToolTip="Escriba nombre, codigo o marca del producto"/>

                <ListBox Grid.Row="2" ItemsSource="{Binding promo_search_results}"
                         Background="White" BorderBrush="#BDBDBD" BorderThickness="1"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                         HorizontalContentAlignment="Stretch">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Grid Margin="0,1">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" VerticalAlignment="Center" FontSize="11" Margin="3,0">
                                    <Run Text="{Binding product_code}" FontWeight="Bold" Foreground="#C62828"/>
                                    <Run Text=" - "/>
                                    <Run Text="{Binding name}"/>
                                </TextBlock>
                                <Button Grid.Column="1" Content="+ Agregar" Style="{StaticResource AddProductButton}"
                                        ToolTip="Agregar este producto a la composicion"
                                        Visibility="{Binding DataContext.can_add_products, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource BooleanToVisibilityConverter}}"
                                        Command="{Binding DataContext.add_to_builder_command, RelativeSource={RelativeSource AncestorType=Window}}"
                                        CommandParameter="{Binding}"/>
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>

                <TextBlock x:Name="SearchEmptyText" Grid.Row="3" FontSize="10.5" Foreground="#757575" Margin="2,4,0,0" TextWrapping="Wrap"
                           Text="No hay coincidencias. Escriba otra palabra o el codigo del producto."/>
            </Grid>

            <Grid Grid.Column="2">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0" FontWeight="Bold" Margin="0,0,0,4" Text="COMPOSICION DE LA PROMOCION"/>
                <DataGrid x:Name="CompositionGrid" Grid.Row="1" ItemsSource="{Binding builder_items}"
                          AutoGenerateColumns="False" IsReadOnly="False"
                          HeadersVisibility="Column" GridLinesVisibility="Horizontal"
                          Background="White" BorderBrush="#BDBDBD" BorderThickness="1"
                          RowHeight="28" FontSize="11" SelectionMode="Single"
                          CanUserAddRows="False" CanUserDeleteRows="False"
                          CanUserResizeColumns="False" CanUserReorderColumns="False">
                    <DataGrid.Resources>
                        <Style TargetType="DataGridColumnHeader">
                            <Setter Property="Background" Value="#C62828"/>
                            <Setter Property="Foreground" Value="White"/>
                            <Setter Property="FontWeight" Value="Bold"/>
                            <Setter Property="FontSize" Value="10.5"/>
                            <Setter Property="Padding" Value="3,0"/>
                            <Setter Property="BorderBrush" Value="#C62828"/>
                        </Style>
                    </DataGrid.Resources>
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="CODIGO" Binding="{Binding product_ref.product_code}" Width="95" IsReadOnly="True">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="VerticalAlignment" Value="Center"/>
                                    <Setter Property="FontSize" Value="10.5"/>
                                    <Setter Property="Foreground" Value="#C62828"/>
                                    <Setter Property="FontWeight" Value="Bold"/>
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>
                        <DataGridTextColumn Header="DESCRIPCION" Binding="{Binding product_ref.name}" Width="*" IsReadOnly="True">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="VerticalAlignment" Value="Center"/>
                                    <Setter Property="Margin" Value="4,0,0,0"/>
                                    <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>
                        <DataGridTemplateColumn Header="CANT." Width="80">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBox Text="{Binding quantity, UpdateSourceTrigger=LostFocus}" FontSize="11"
                                             FontWeight="SemiBold" TextAlignment="Center"
                                             HorizontalAlignment="Stretch" Margin="3,2" VerticalContentAlignment="Center">
                                        <TextBox.Style>
                                            <Style TargetType="TextBox">
                                                <Setter Property="IsReadOnly" Value="False"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding quantity_editable}" Value="False">
                                                        <Setter Property="IsReadOnly" Value="True"/>
                                                        <Setter Property="Background" Value="#F5F5F5"/>
                                                        <Setter Property="Foreground" Value="#616161"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBox.Style>
                                    </TextBox>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTemplateColumn Header="" Width="50">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Button Content="&#x2715;" Background="#FFCDD2" Foreground="#C62828"
                                            BorderThickness="0" Width="20" Height="20" Cursor="Hand"
                                            FontWeight="Bold" FontSize="10" HorizontalAlignment="Center"
                                            VerticalAlignment="Center" ToolTip="Quitar este producto de la composicion"
                                            Command="{Binding DataContext.remove_from_builder_command, RelativeSource={RelativeSource AncestorType=Window}}"
                                            CommandParameter="{Binding}">
                                        <Button.Template>
                                            <ControlTemplate TargetType="Button">
                                                <Border x:Name="bd" Background="{TemplateBinding Background}" CornerRadius="3">
                                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                </Border>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter TargetName="bd" Property="Background" Value="#EF9A9A"/>
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Button.Template>
                                    </Button>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>
            </Grid>
        </Grid>

        <!-- PIE -->
        <TextBlock x:Name="HintText" Grid.Row="5" FontSize="9.5" Foreground="#757575" Margin="2,0,0,0" TextWrapping="Wrap"/>

        <Border Grid.Row="6" Background="#FDECEA" CornerRadius="3" Padding="10,6" Margin="0,6,0,0"
                Visibility="{Binding ErrorMessage, Converter={StaticResource StringToVisibilityConverter}}">
            <TextBlock Text="{Binding ErrorMessage}" FontSize="11" Foreground="#C62828" TextWrapping="Wrap"/>
        </Border>

        <StackPanel Grid.Row="7" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
            <Button Content="Guardar" Height="30" Padding="18,0" Margin="0,0,8,0"
                    Background="#2E7D32" Foreground="White" BorderThickness="0" Cursor="Hand"
                    FontWeight="SemiBold" Command="{Binding save_promotion_command}"/>
            <Button Content="Cancelar" Height="30" Padding="18,0" Click="OnCancelClick"
                    Background="#E0E0E0" Foreground="#424242" BorderThickness="1" BorderBrush="#BDBDBD"
                    Cursor="Hand"/>
        </StackPanel>
    </Grid>
</Window>
