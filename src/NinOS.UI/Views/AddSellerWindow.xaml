<Window x:Class="NinOS.UI.Views.AddSellerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{Binding AddOrEditTitle}" Width="480"
        Height="520" ResizeMode="CanResize"
        MinHeight="400" MinWidth="420"
        WindowStartupLocation="CenterOwner">
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Focusable="False">
        <Grid Margin="18,14">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Código -->
            <TextBlock Grid.Row="0" FontWeight="Bold" Margin="0,0,0,5">
                <Run Text="Código del Vendedor"/><Run Text=" *" Foreground="Red"/>
            </TextBlock>
            <TextBox Grid.Row="1" Text="{Binding NewSellerCode}" IsReadOnly="True" Background="#F0F0F0" Padding="6" Margin="0,0,0,12"/>

            <!-- Nombre Completo -->
            <TextBlock Grid.Row="2" FontWeight="Bold" Margin="0,0,0,5">
                <Run Text="Nombre Completo"/><Run Text=" *" Foreground="Red"/>
            </TextBlock>
            <TextBox Grid.Row="3" Text="{Binding NewFullName, UpdateSourceTrigger=PropertyChanged}" Padding="6" Margin="0,0,0,14"/>

            <!-- Zonas Asignadas -->
            <TextBlock Grid.Row="4" FontWeight="Bold" Margin="0,0,0,6" Text="Zonas Asignadas"/>
            <Border Grid.Row="5" BorderBrush="#E0E0E0" BorderThickness="1" CornerRadius="4" Padding="8" Background="#FAFAFA" MinHeight="160" Margin="0,0,0,12">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <ItemsControl ItemsSource="{Binding AvailableZonas}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <CheckBox IsChecked="{Binding IsSelected, Mode=TwoWay}"
                                          IsEnabled="{Binding IsEnabled}"
                                          ToolTip="{Binding ToolTip}"
                                          Margin="4,5" FontSize="12.5" FontWeight="SemiBold">
                                    <TextBlock Text="{Binding DisplayText}"/>
                                </CheckBox>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </Border>

            <!-- Error message -->
            <TextBlock Grid.Row="6" Text="{Binding ErrorMessage}" Foreground="Red" FontWeight="Bold" Margin="0,0,0,8"
                       Visibility="{Binding ErrorMessage, Converter={StaticResource StringToVisibilityConverter}}"
                       TextWrapping="Wrap"/>

            <!-- Acciones -->
            <StackPanel Grid.Row="7" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,4,0,0">
                <Button Content="{Binding SaveButtonText}" Command="{Binding SaveSellerCommand}"
                        Background="#0078D7" Foreground="White" FontWeight="Bold" Padding="16,8" Cursor="Hand" Margin="0,0,10,0"/>
                <Button Content="Cancelar" Click="CancelButton_Click"
                        Background="#6C757D" Foreground="White" Padding="16,8" Cursor="Hand"/>
            </StackPanel>
        </Grid>
    </ScrollViewer>
</Window>
