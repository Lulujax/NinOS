<UserControl x:Class="NinOS.UI.Views.CustomerView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="White">
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Border Background="#F4F4F4" CornerRadius="4" Grid.Row="0" Margin="0,0,0,10" Padding="15">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock FontWeight="Bold" Margin="0,0,10,0" Text="Buscar Cliente:" VerticalAlignment="Center"/>
                    <TextBox FontSize="14" Padding="6" Text="{Binding SearchQuery, UpdateSourceTrigger=PropertyChanged}" Width="300"/>
                </StackPanel>

                <Button Grid.Column="2" Background="#0078D7" Command="{Binding AddCustomerCommand}" Content="Agregar Cliente" Cursor="Hand" FontWeight="Bold" Foreground="White" Padding="20,8"/>
            </Grid>
        </Border>

        <TabControl Grid.Row="1" SelectedIndex="{Binding SelectedTabIndex, UpdateSourceTrigger=PropertyChanged}">
            <TabItem Header="Todos">
                <DataGrid AlternatingRowBackground="#E3F2FD" AutoGenerateColumns="False" HeadersVisibility="Column" IsReadOnly="True" ItemsSource="{Binding AllCustomers}" Margin="5" MinRowHeight="40">
                    <DataGrid.Columns>
                        <DataGridTextColumn Binding="{Binding IdDisplay}" Header="#" Width="50"/>
                        <DataGridTextColumn Binding="{Binding CustomerCode}" Header="Código" Width="100"/>
                        <DataGridTextColumn Binding="{Binding BusinessName}" Header="Razón Social" Width="180">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="TextWrapping" Value="Wrap"/>
                                    <Setter Property="Margin" Value="5"/>
                                    <Setter Property="VerticalAlignment" Value="Center"/>
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>
                        <DataGridTextColumn Binding="{Binding Rif}" Header="RIF" Width="120"/>
                        <DataGridTextColumn Binding="{Binding ContactName}" Header="Nombre Contacto" Width="150"/>
                        <DataGridTextColumn Binding="{Binding PhoneNumber}" Header="Teléfono" Width="120"/>
                        <DataGridTextColumn Binding="{Binding FiscalAddress}" Header="Dirección Fiscal" Width="200">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="TextWrapping" Value="Wrap"/>
                                    <Setter Property="Margin" Value="5"/>
                                    <Setter Property="VerticalAlignment" Value="Center"/>
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>
                        <DataGridTextColumn Binding="{Binding DeliveryAddress}" Header="Dirección Entrega" Width="200">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="TextWrapping" Value="Wrap"/>
                                    <Setter Property="Margin" Value="5"/>
                                    <Setter Property="VerticalAlignment" Value="Center"/>
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>
                        <DataGridTextColumn Binding="{Binding SellerName}" Header="Vendedor" Width="100"/>
                        <DataGridTemplateColumn Header="Acciones" Width="140">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <StackPanel HorizontalAlignment="Center" Orientation="Horizontal">
                                        <Button Background="#E0E0E0" Command="{Binding DataContext.EditCustomerCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" Content="Editar" Cursor="Hand" Margin="0,0,10,0" Padding="10,5"/>
                                        <Button Background="#FFCDD2" Command="{Binding DataContext.DeleteCustomerCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" Content="Borrar" Cursor="Hand" Padding="10,5"/>
                                    </StackPanel>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>
            </TabItem>

            <TabItem Header="Anais">
