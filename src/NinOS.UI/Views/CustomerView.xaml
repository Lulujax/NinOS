<UserControl x:Class="NinOS.UI.Views.CustomerView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="White">
    <UserControl.Resources>
        <Style x:Key="CustomerRow" TargetType="DataGridRow">
            <Setter Property="Height" Value="46"/>
            <Setter Property="ContextMenu">
                <Setter.Value>
                    <ContextMenu>
                        <MenuItem Header="👁️ Ver Historial"
                                  Command="{Binding DataContext.OpenCustomerHistoryCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                  CommandParameter="{Binding}"/>
                        <MenuItem Header="✏️ Editar Cliente"
                                  Command="{Binding DataContext.EditCustomerCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                  CommandParameter="{Binding}"/>
                        <Separator/>
                        <MenuItem Header="🗑️ Eliminar Cliente"
                                  Command="{Binding DataContext.DeleteCustomerCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                  CommandParameter="{Binding}"/>
                    </ContextMenu>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="CompactDataGrid" TargetType="DataGrid">
            <Setter Property="RowStyle" Value="{StaticResource CustomerRow}"/>
            <Setter Property="AutoGenerateColumns" Value="False"/>
            <Setter Property="IsReadOnly" Value="True"/>
            <Setter Property="GridLinesVisibility" Value="All"/>
            <Setter Property="HeadersVisibility" Value="Column"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush" Value="#E0E0E0"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="RowHeaderWidth" Value="0"/>
            <Setter Property="CanUserAddRows" Value="False"/>
            <Setter Property="CanUserDeleteRows" Value="False"/>
            <Setter Property="CanUserReorderColumns" Value="False"/>
            <Setter Property="CanUserResizeColumns" Value="False"/>
            <Setter Property="SelectionMode" Value="Single"/>
            <Setter Property="EnableRowVirtualization" Value="True"/>
            <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Auto"/>
            <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Auto"/>
            <Setter Property="FontSize" Value="11"/>
        </Style>
        <Style x:Key="CellText" TargetType="TextBlock">
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
        </Style>
        <Style x:Key="CellTextCenter" TargetType="TextBlock" BasedOn="{StaticResource CellText}">
            <Setter Property="HorizontalAlignment" Value="Center"/>
            <Setter Property="TextAlignment" Value="Center"/>
        </Style>
        <Style x:Key="CellWrap" TargetType="TextBlock" BasedOn="{StaticResource CellText}">
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
            <Setter Property="Height" Value="32"/>
            <Setter Property="VerticalAlignment" Value="Top"/>
        </Style>
        <Style x:Key="HeaderActionButton" TargetType="Button">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="12.5"/>
            <Setter Property="Padding" Value="14,4"/>
            <Setter Property="MinWidth" Value="140"/>
            <Setter Property="Height" Value="28"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="{TemplateBinding Background}" CornerRadius="4"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Opacity" Value="0.85"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="RowEditButton" TargetType="Button">
            <Setter Property="Padding" Value="6,2"/>
            <Setter Property="Margin" Value="1"/>
            <Setter Property="FontSize" Value="10"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="#FFF3E0" CornerRadius="3" Padding="{TemplateBinding Padding}"
                                Margin="{TemplateBinding Margin}" BorderBrush="#FFE0B2" BorderThickness="1">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                                              TextElement.Foreground="#E65100"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#FFE0B2"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="RowDeleteButton" TargetType="Button">
            <Setter Property="Padding" Value="6,2"/>
            <Setter Property="Margin" Value="1"/>
            <Setter Property="FontSize" Value="10"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="#FFEBEE" CornerRadius="3" Padding="{TemplateBinding Padding}"
                                Margin="{TemplateBinding Margin}" BorderBrush="#FFCDD2" BorderThickness="1">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                                              TextElement.Foreground="#C62828"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#FFCDD2"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="RowHistoryButton" TargetType="Button">
            <Setter Property="Padding" Value="6,2"/>
            <Setter Property="Margin" Value="1"/>
            <Setter Property="FontSize" Value="10"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="#E3F2FD" CornerRadius="3" Padding="{TemplateBinding Padding}"
                                Margin="{TemplateBinding Margin}" BorderBrush="#BBDEFB" BorderThickness="1">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                                              TextElement.Foreground="#0D47A1"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#BBDEFB"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Border Background="#F4F4F4" CornerRadius="4" Grid.Row="0" Margin="0,0,0,10" Padding="15">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock FontWeight="Bold" Margin="0,0,10,0" Text="Buscar Cliente:" VerticalAlignment="Center"/>
                    <Border Background="White" CornerRadius="4" BorderBrush="#E0E0E0" BorderThickness="1">
                        <Grid Width="240">
                            <TextBlock Text="&#x1F50D;" Margin="8,0,0,0" VerticalAlignment="Center" FontSize="13.5" Foreground="#9E9E9E"/>
                            <TextBox Margin="26,2,8,2" BorderThickness="0" Background="Transparent"
                                     VerticalContentAlignment="Center" FontSize="12.5"
                                     Text="{Binding SearchQuery, UpdateSourceTrigger=PropertyChanged}"/>
                        </Grid>
                    </Border>
                </StackPanel>

                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button x:Name="btn_reporte" Content="📄 Maestro de Clientes ▾" Style="{StaticResource HeaderActionButton}"
                            Background="#1B3A2D" Margin="0,0,8,0" Click="on_reporte_click"
                            ToolTip="Seleccionar zonas e imprimir o exportar maestro de clientes a PDF y Excel"/>

                    <Button Style="{StaticResource HeaderActionButton}" Background="#6C757D"
                            Command="{Binding EditZonasCommand}" Content="Editar Zonas" Margin="0,0,8,0"/>
                    <Button Style="{StaticResource HeaderActionButton}" Background="#0078D7"
                            Command="{Binding AddCustomerCommand}" Content="Agregar Cliente"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- POPUP: CONFIGURADOR DE REPORTE DE CLIENTES -->
        <Popup x:Name="popup_reporte"
               PlacementTarget="{Binding ElementName=btn_reporte}"
               Placement="Bottom"
               StaysOpen="False"
               AllowsTransparency="True"
               PopupAnimation="Fade">
            <Border x:Name="panel_reporte"
                    Background="White" BorderBrush="#C9D3C7" BorderThickness="1" CornerRadius="5"
                    Padding="14,12" Width="360">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="12" Direction="270" ShadowDepth="4" Opacity="0.18" Color="#000000"/>
                </Border.Effect>
                <StackPanel>
                    <TextBlock Text="MAESTRO DE CLIENTES" FontSize="11.5" FontWeight="Bold" Foreground="#1B3A2D"/>
                    <TextBlock Text="Seleccione las zonas que desea incluir en el maestro de clientes y el formato de emisión."
                               FontSize="9.5" Foreground="#7A8A80" TextWrapping="Wrap" Margin="0,2,0,8"/>

                    <!-- SELECCIÓN DE ZONAS -->
                    <Border Background="#F9FAF8" BorderBrush="#E0E6DF" BorderThickness="1" CornerRadius="4" Padding="8" Margin="0,0,0,8">
                        <StackPanel>
                            <Grid Margin="0,0,0,4">
                                <TextBlock Text="ZONAS A INCLUIR" FontSize="9.5" FontWeight="Bold" Foreground="#1B3A2D" VerticalAlignment="Center"/>
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                    <CheckBox Content="Todas" IsChecked="{Binding all_report_zones_selected, Mode=TwoWay}"
                                              FontSize="10.5" FontWeight="SemiBold" Foreground="#333333" Margin="0,0,8,0" Cursor="Hand"/>
                                    <Button Content="Quitar" Background="Transparent" Foreground="#C62828"
                                            FontWeight="SemiBold" FontSize="10.5" BorderThickness="0" Cursor="Hand"
                                            Command="{Binding clear_report_zones_command}"/>
                                </StackPanel>
                            </Grid>
                            <ScrollViewer MaxHeight="160" VerticalScrollBarVisibility="Auto">
                                <ItemsControl ItemsSource="{Binding report_zone_options}">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <WrapPanel/>
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <CheckBox Content="{Binding display_name}" IsChecked="{Binding is_checked, Mode=TwoWay}"
                                                      FontSize="10.5" Foreground="#333333" Width="150" Margin="2,2,4,2" Cursor="Hand"/>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>
                        </StackPanel>
                    </Border>

                    <!-- FILTRO DE BÚSQUEDA (Si hay texto en búsqueda) -->
                    <Border Visibility="{Binding HasActiveSearch, Converter={StaticResource BooleanToVisibilityConverter}}"
                            Background="#F0F4EC" BorderBrush="#D1DEC9" BorderThickness="1" CornerRadius="4" Padding="8,5" Margin="0,0,0,8">
                        <CheckBox Content="{Binding ActiveSearchLabel}" IsChecked="{Binding apply_search_filter_in_report, Mode=TwoWay}"
                                  FontSize="10" FontWeight="SemiBold" Foreground="#1B3A2D" Cursor="Hand"/>
                    </Border>

                    <!-- BOTONES DE ACCIÓN (2x2 UniformGrid) -->
                    <UniformGrid Columns="2" Rows="2" Margin="0,4,0,0">
                        <Button Content="👁️ Vista Previa" Style="{StaticResource ToolbarReportPreviewButton}"
                                Height="30" Margin="0,0,3,3" Click="on_preview_reporte_click"/>
                        <Button Content="🖨️ Imprimir" Style="{StaticResource ToolbarPrintButton}"
                                Height="30" Margin="3,0,0,3" Click="on_print_reporte_click"/>
                        <Button Content="📄 PDF" Style="{StaticResource ToolbarPdfButton}"
                                Height="30" Margin="0,3,3,0" Click="on_descargar_reporte_click"/>
                        <Button Content="📊 Excel" Style="{StaticResource ToolbarExcelButton}"
                                Height="30" Margin="3,3,0,0" Click="on_excel_reporte_click"/>
                    </UniformGrid>
                </StackPanel>
            </Border>
        </Popup>

        <TabControl Grid.Row="1"
                    ItemsSource="{Binding ZonaTabs}"
                    SelectedItem="{Binding SelectedTab, Mode=TwoWay}">
            <TabControl.ItemTemplate>
                <DataTemplate>
                    <TextBlock Text="{Binding Header}" FontSize="12.5" Padding="4,2"/>
                </DataTemplate>
            </TabControl.ItemTemplate>
            <TabControl.ContentTemplate>
                <DataTemplate>
                    <DataGrid Style="{StaticResource CompactDataGrid}" ItemsSource="{Binding Customers}"
                              MouseDoubleClick="CustomerGrid_MouseDoubleClick">
                        <DataGrid.Columns>
                            <DataGridTextColumn Binding="{Binding IdDisplay}" Header="#" Width="36"/>
                            <DataGridTextColumn Binding="{Binding CustomerCode}" Header="Código" Width="70" ElementStyle="{StaticResource CellWrap}"/>
                            <DataGridTemplateColumn Header="Razón Social" Width="170">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding BusinessName}" Style="{StaticResource CellWrap}" ToolTip="{Binding BusinessName}"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTextColumn Binding="{Binding Rif}" Header="RIF" Width="105" ElementStyle="{StaticResource CellWrap}"/>
                            <DataGridTextColumn Binding="{Binding ContactName}" Header="Nombre Contacto" Width="125" ElementStyle="{StaticResource CellWrap}"/>
                            <DataGridTextColumn Binding="{Binding PhoneNumber}" Header="Teléfono" Width="108" ElementStyle="{StaticResource CellWrap}"/>
                            <DataGridTemplateColumn Header="Dirección Fiscal" Width="170">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding FiscalAddress}" Style="{StaticResource CellWrap}" ToolTip="{Binding FiscalAddress}"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTemplateColumn Header="Dirección Entrega" Width="170">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding EffectiveDeliveryAddress}" Style="{StaticResource CellWrap}" ToolTip="{Binding EffectiveDeliveryAddress}"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTextColumn Binding="{Binding ZonaName}" Header="Zona" Width="110" ElementStyle="{StaticResource CellWrap}"/>
                            <DataGridTemplateColumn Header="Acciones" Width="185">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <StackPanel HorizontalAlignment="Center" Orientation="Horizontal">
                                            <Button Style="{StaticResource RowHistoryButton}"
                                                    Command="{Binding DataContext.OpenCustomerHistoryCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                    CommandParameter="{Binding}"
                                                    Content="Historial"/>
                                            <Button Style="{StaticResource RowEditButton}"
                                                    Command="{Binding DataContext.EditCustomerCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                    CommandParameter="{Binding}"
                                                    Content="Editar"/>
                                            <Button Style="{StaticResource RowDeleteButton}"
                                                    Command="{Binding DataContext.DeleteCustomerCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                    CommandParameter="{Binding}"
                                                    Content="Borrar"/>
                                        </StackPanel>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                </DataTemplate>
            </TabControl.ContentTemplate>
        </TabControl>
    </Grid>
</UserControl>
