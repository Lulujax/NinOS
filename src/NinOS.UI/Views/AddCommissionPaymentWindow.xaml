<Window x:Class="NinOS.UI.Views.AddCommissionPaymentWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Pago de Comision" Height="420" Width="460"
        WindowStartupLocation="CenterOwner" Background="#F5F5F5"
        ResizeMode="NoResize" FontSize="12">
    <Grid Margin="14">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="70"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <TextBlock Grid.Row="0" Grid.ColumnSpan="2" Text="Pago de Comision" FontSize="14" FontWeight="Bold"
                   Foreground="#2E7D32" Margin="0,0,0,6"/>

        <TextBlock Grid.Row="1" Grid.Column="0" Text="Nota:" VerticalAlignment="Center" Margin="0,0,0,5"/>
        <Grid Grid.Row="1" Grid.Column="1" Margin="0,0,0,5">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBox x:Name="NoteTextBox" Grid.Column="0" Height="26" FontSize="11" VerticalContentAlignment="Center"
                     TextChanged="OnNoteSearchChanged" CaretBrush="Transparent"/>
            <Button x:Name="BtnToggleDropdown" Grid.Column="1" Content="&#x25BC;" Width="24" Height="26"
                    FontSize="9" Cursor="Hand" Click="OnToggleDropdown"
                    Background="#F5F5F5" Foreground="#757575" BorderBrush="#BDBDBD" BorderThickness="1,0,0,0"
                    VerticalAlignment="Center">
                <Button.Template>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="{TemplateBinding Background}" Padding="0"
                                BorderThickness="{TemplateBinding BorderThickness}" BorderBrush="{TemplateBinding BorderBrush}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#E0E0E0"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Button.Template>
            </Button>
            <Popup x:Name="NotePopup" IsOpen="False" AllowsTransparency="True"
                   PlacementTarget="{Binding ElementName=NoteTextBox}" Placement="Bottom"
                   MaxHeight="200" PopupAnimation="Fade" StaysOpen="False"
                   HorizontalOffset="0">
                <Border Background="White" BorderBrush="#BDBDBD" BorderThickness="1"
                        Width="{Binding ActualWidth, ElementName=NoteTextBox}">
                    <ListBox x:Name="NoteListBox" BorderThickness="0"
                             SelectionChanged="OnNoteListSelected"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding Display}" FontSize="11" Padding="4,2"/>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Border>
            </Popup>
        </Grid>

        <Border Grid.Row="2" Grid.ColumnSpan="2" x:Name="NoteInfoBorder" Background="#E8F5E9"
                CornerRadius="3" Padding="8" Margin="0,0,0,5" Visibility="Collapsed">
            <TextBlock x:Name="NoteInfoText" FontSize="11" Foreground="#2E7D32" TextWrapping="Wrap"/>
        </Border>

        <TextBlock Grid.Row="3" Grid.Column="0" Text="Tasa BS/USD:" VerticalAlignment="Center" Margin="0,0,0,5"/>
        <TextBox Grid.Row="3" Grid.Column="1" x:Name="RateBox" VerticalContentAlignment="Center" Height="24"
                 Width="120" HorizontalAlignment="Left" Margin="0,0,0,5" FontSize="11"
                 PreviewTextInput="OnPreviewNumeric"/>

        <TextBlock Grid.Row="4" Grid.Column="0" Text="Tipo:" VerticalAlignment="Center" Margin="0,0,0,5"/>
        <ComboBox Grid.Row="4" Grid.Column="1" x:Name="TypeCombo" Width="150" HorizontalAlignment="Left"
                  Height="26" Margin="0,0,0,5" FontSize="11">
            <ComboBoxItem Content="Pago Movil" IsSelected="True"/>
            <ComboBoxItem Content="Efectivo"/>
        </ComboBox>

        <TextBlock Grid.Row="5" Grid.Column="0" Text="Referencia:" VerticalAlignment="Center" Margin="0,0,0,5"/>
        <TextBox Grid.Row="5" Grid.Column="1" x:Name="ReferenceBox" VerticalContentAlignment="Center" Height="24"
                 Width="160" HorizontalAlignment="Left" Margin="0,0,0,5" MaxLength="50" FontSize="11"/>

        <TextBlock Grid.Row="6" Grid.ColumnSpan="2" x:Name="ErrorText" Foreground="#C62828" FontSize="10"
                   TextWrapping="Wrap" Margin="0,0,0,4" Visibility="Collapsed"/>

        <StackPanel Grid.Row="8" Grid.ColumnSpan="2" Orientation="Horizontal" HorizontalAlignment="Right"
                    VerticalAlignment="Bottom">
            <Button Content="Cancelar" Padding="10,4" Background="#E0E0E0" Foreground="#424242"
                    BorderThickness="0" Cursor="Hand" Click="OnCancelClick" Margin="0,0,6,0" FontSize="11"/>
            <Button x:Name="BtnRegistrar" Content="Liquidar" Padding="10,4" Background="#2E7D32" Foreground="White"
                    BorderThickness="0" Cursor="Hand" Click="OnConfirmClick" FontSize="11" FontWeight="SemiBold"
                    IsEnabled="False">
                <Button.Template>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="{TemplateBinding Background}" CornerRadius="4"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#43A047"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="bd" Property="Background" Value="#A5D6A7"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Button.Template>
            </Button>
        </StackPanel>
    </Grid>
</Window>