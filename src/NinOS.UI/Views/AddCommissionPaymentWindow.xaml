<Window x:Class="NinOS.UI.Views.AddCommissionPaymentWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Liquidacion de Comisiones" Height="600" Width="560" MinHeight="560" MinWidth="520"
        WindowStartupLocation="CenterOwner" Background="#F5F5F5"
        ResizeMode="CanResize" FontSize="12">
    <Window.Resources>
        <Style x:Key="NotesGridStyle" TargetType="DataGrid">
            <Setter Property="AutoGenerateColumns" Value="False"/>
            <Setter Property="IsReadOnly" Value="True"/>
            <Setter Property="GridLinesVisibility" Value="Horizontal"/>
            <Setter Property="HeadersVisibility" Value="Column"/>
            <Setter Property="RowHeaderWidth" Value="0"/>
            <Setter Property="CanUserAddRows" Value="False"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="MinRowHeight" Value="22"/>
            <Setter Property="SelectionMode" Value="Single"/>
            <Setter Property="SelectionUnit" Value="FullRow"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush" Value="#C8E6C9"/>
            <Setter Property="Background" Value="White"/>
        </Style>
        <Style x:Key="CellCenter" TargetType="TextBlock">
            <Setter Property="HorizontalAlignment" Value="Center"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
        <Style x:Key="CellGreen" TargetType="TextBlock" BasedOn="{StaticResource CellCenter}">
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="#2E7D32"/>
        </Style>
        <Style x:Key="HeaderGreen" TargetType="DataGridColumnHeader">
            <Setter Property="Background" Value="#2E7D32"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="FontSize" Value="10"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="Padding" Value="3,0"/>
        </Style>
    </Window.Resources>
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
    <Grid Margin="14">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="80"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <TextBlock Grid.Row="0" Grid.ColumnSpan="2" Text="Liquidacion de Comisiones" FontSize="14" FontWeight="Bold"
                   Foreground="#2E7D32" Margin="0,0,0,6"/>

        <!-- BUSCADOR DE NOTA -->
        <Grid Grid.Row="1" Grid.ColumnSpan="2" Margin="0,0,0,5">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <Grid Grid.Column="0" Margin="0,0,6,0">
                <Border Background="White" CornerRadius="4" BorderBrush="#E0E0E0" BorderThickness="1">
                    <Grid>
                        <TextBlock Text="&#x1F50D;" Margin="8,0,0,0" VerticalAlignment="Center" FontSize="12" Foreground="#9E9E9E"/>
                        <TextBox x:Name="NoteTextBox" Margin="28,1,22,1" BorderThickness="0" Background="Transparent"
                                 VerticalContentAlignment="Center" FontSize="12"
                                 CaretBrush="Transparent" TextChanged="OnNoteSearchChanged"/>
                    </Grid>
                </Border>
                <Popup x:Name="NotePopup" IsOpen="False" AllowsTransparency="True"
                       PlacementTarget="{Binding ElementName=NoteTextBox}" Placement="Bottom"
                       MaxHeight="180" PopupAnimation="Fade" StaysOpen="False">
                    <Border Background="White" BorderBrush="#C8E6C9" BorderThickness="1"
                            Width="{Binding ActualWidth, ElementName=NoteTextBox}">
                        <ListBox x:Name="NoteListBox" BorderThickness="0"
                                 SelectionChanged="OnNoteListSelected"
                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock FontSize="11" Padding="4,2">
                                        <Run Text="{Binding note_number, Mode=OneWay}" FontWeight="Bold" Foreground="#2E7D32"/>
                                        <Run Text="  "/>
                                        <Run Text="{Binding customer_name, Mode=OneWay}" Foreground="#424242"/>
                                        <Run Text="  |  "/>
                                        <Run Text="{Binding seller_name, Mode=OneWay}" FontWeight="SemiBold" Foreground="#F57C00"/>
                                        <Run Text="  |  COMISION "/>
                                        <Run Text="{Binding amount_usd, Mode=OneWay, StringFormat={}{0:0.##}}"/>
                                    </TextBlock>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </Border>
                </Popup>
            </Grid>
            <Button x:Name="BtnToggleDropdown" Grid.Column="1" Content="&#x25BC;" Width="26" Height="24"
                    FontSize="9" Cursor="Hand" Click="OnToggleDropdown"
                    Background="#F5F5F5" Foreground="#757575" BorderBrush="#BDBDBD" BorderThickness="1"
                    VerticalAlignment="Center">
                <Button.Template>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="{TemplateBinding Background}" Padding="0"
                                BorderThickness="{TemplateBinding BorderThickness}" BorderBrush="{TemplateBinding BorderBrush}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#E0E0E0"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Button.Template>
            </Button>
        </Grid>

        <TextBlock Grid.Row="2" Grid.ColumnSpan="2" Text="NOTAS A PAGAR:" FontSize="10" FontWeight="Bold"
                   Foreground="#424242" Margin="0,0,0,3"/>

        <DataGrid Grid.Row="3" Grid.ColumnSpan="2" x:Name="NotesGrid" Style="{StaticResource NotesGridStyle}"
                  Height="160" Margin="0,0,0,6">
            <DataGrid.ColumnHeaderStyle>
                <Style TargetType="DataGridColumnHeader" BasedOn="{StaticResource HeaderGreen}"/>
            </DataGrid.ColumnHeaderStyle>
            <DataGrid.Columns>
                <DataGridTextColumn Header="NRO" Binding="{Binding note_number}" Width="60"
                                    ElementStyle="{StaticResource CellCenter}"/>
                <DataGridTextColumn Header="CLIENTE" Binding="{Binding customer_name}" Width="130"
                                    ElementStyle="{StaticResource CellCenter}"/>
                <DataGridTextColumn Header="VENDEDORA" Binding="{Binding seller_name}" Width="95"
                                    ElementStyle="{StaticResource CellCenter}"/>
                <DataGridTextColumn Header="VENTA" Binding="{Binding sale_amount_usd, StringFormat={}{0:0.##}}" Width="70"
                                    ElementStyle="{StaticResource CellCenter}"/>
                <DataGridTextColumn Header="COMISION" Binding="{Binding amount_usd, StringFormat={}{0:0.##}}" Width="85"
                                    ElementStyle="{StaticResource CellGreen}"/>
                <DataGridTemplateColumn Width="34">
                    <DataGridTemplateColumn.Header>
                        <TextBlock Text="" FontSize="10"/>
                    </DataGridTemplateColumn.Header>
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <Button Content="&#x2715;" FontSize="10" Background="Transparent" BorderThickness="0"
                                    Cursor="Hand" Foreground="#C62828" Padding="2" HorizontalAlignment="Center"
                                    Click="OnRemoveClick"/>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
            </DataGrid.Columns>
        </DataGrid>

        <Border Grid.Row="4" Grid.ColumnSpan="2" Background="#E8F5E9" CornerRadius="3" Padding="8" Margin="0,0,0,8">
            <TextBlock x:Name="SummaryText" FontSize="11" Foreground="#1B5E20" FontWeight="Bold" TextWrapping="Wrap"/>
        </Border>

        <TextBlock Grid.Row="5" Grid.Column="0" Text="Tasa BS/USD:" VerticalAlignment="Center" Margin="0,0,0,5"/>
        <TextBox Grid.Row="5" Grid.Column="1" x:Name="RateBox" VerticalContentAlignment="Center" Height="24"
                 Width="120" HorizontalAlignment="Left" Margin="0,0,0,5" FontSize="11"
                 PreviewTextInput="OnPreviewNumeric"/>

        <TextBlock Grid.Row="6" Grid.Column="0" Text="Monto USD:" VerticalAlignment="Center" Margin="0,0,0,5"/>
        <TextBox Grid.Row="6" Grid.Column="1" x:Name="AmountBox" VerticalContentAlignment="Center" Height="24"
                 Width="120" HorizontalAlignment="Left" Margin="0,0,0,5" FontSize="11"
                 PreviewTextInput="OnPreviewNumeric"/>

        <TextBlock Grid.Row="7" Grid.Column="0" Text="Monto BS:" VerticalAlignment="Center" Margin="0,0,0,5"/>
        <TextBox Grid.Row="7" Grid.Column="1" x:Name="BsAmountBox" VerticalContentAlignment="Center" Height="24"
                 Width="120" HorizontalAlignment="Left" Margin="0,0,0,5" FontSize="11"
                 PreviewTextInput="OnPreviewNumeric"/>

        <TextBlock Grid.Row="8" Grid.Column="0" Text="Tipo:" VerticalAlignment="Center" Margin="0,0,0,5"/>
        <ComboBox Grid.Row="8" Grid.Column="1" x:Name="TypeCombo" Width="150" HorizontalAlignment="Left"
                  Height="26" Margin="0,0,0,5" FontSize="11">
            <ComboBoxItem Content="Pago Movil" IsSelected="True"/>
            <ComboBoxItem Content="Efectivo"/>
        </ComboBox>

        <TextBlock Grid.Row="9" Grid.Column="0" Text="Fecha:" VerticalAlignment="Center" Margin="0,0,0,5"/>
        <DatePicker Grid.Row="9" Grid.Column="1" x:Name="PaymentDatePicker" Width="150" HorizontalAlignment="Left"
                    Height="26" Margin="0,0,0,5" FontSize="11"/>

        <TextBlock Grid.Row="10" Grid.Column="0" Text="Referencia:" VerticalAlignment="Center" Margin="0,0,0,5"/>
        <TextBox Grid.Row="10" Grid.Column="1" x:Name="ReferenceBox" VerticalContentAlignment="Center" Height="24"
                 Width="160" HorizontalAlignment="Left" Margin="0,0,0,5" MaxLength="50" FontSize="11"/>

        <TextBlock Grid.Row="11" Grid.Column="0" Text="Banco:" VerticalAlignment="Center" Margin="0,0,0,5"/>
        <TextBox Grid.Row="11" Grid.Column="1" x:Name="BankBox" VerticalContentAlignment="Center" Height="24"
                 Width="160" HorizontalAlignment="Left" Margin="0,0,0,5" MaxLength="100" FontSize="11"/>

        <TextBlock Grid.Row="12" Grid.Column="0" Text="Obs.:" VerticalAlignment="Top" Margin="0,1,0,5"/>
        <TextBox Grid.Row="12" Grid.Column="1" x:Name="ObsBox" Height="36" AcceptsReturn="True" TextWrapping="Wrap"
                 VerticalScrollBarVisibility="Auto" MaxLength="500" FontSize="11"/>

        <TextBlock Grid.Row="13" Grid.ColumnSpan="2" x:Name="ErrorText" Foreground="#C62828" FontSize="10"
                   TextWrapping="Wrap" Margin="0,0,0,4" Visibility="Collapsed"/>

        <StackPanel Grid.Row="14" Grid.ColumnSpan="2" Orientation="Horizontal" HorizontalAlignment="Right"
                    VerticalAlignment="Bottom">
            <Button Content="Cancelar" Padding="10,4" Background="#E0E0E0" Foreground="#424242"
                    BorderThickness="0" Cursor="Hand" Click="OnCancelClick" Margin="0,0,6,0" FontSize="11"/>
            <Button x:Name="BtnRegistrar" Content="Liquidar" Padding="10,4" Background="#2E7D32" Foreground="White"
                    BorderThickness="0" Cursor="Hand" Click="OnConfirmClick" FontSize="11" FontWeight="SemiBold">
                <Button.Template>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="{TemplateBinding Background}" CornerRadius="4"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#43A047"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="bd" Property="Background" Value="#A5D6A7"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Button.Template>
            </Button>
        </StackPanel>
    </Grid>
    </ScrollViewer>
</Window>