<UserControl x:Class="NinOS.UI.Views.VesuprontaView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:views="clr-namespace:NinOS.UI.Views"
             Background="White">
    <UserControl.Resources>
        <Style TargetType="TabItem">
            <Setter Property="Foreground" Value="#4A148C"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Background" Value="#F5F5F5"/>
            <Style.Triggers>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="#FFFFFF"/>
                    <Setter Property="FontWeight" Value="Bold"/>
                </Trigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <Border Grid.Row="0" Background="#FFFFFF" BorderBrush="#6A1B9A" BorderThickness="0,0,0,2" Padding="12,8">
            <TextBlock Text="EMPRESA: VESUPRONTA" Foreground="#4A148C" FontSize="14" FontWeight="SemiBold" HorizontalAlignment="Left" />
        </Border>
        <TabControl Grid.Row="1">
            <TabItem Header="Ventas Vesupronta">
                <views:SalesView DataContext="{Binding sales_vm}" />
            </TabItem>
            <TabItem Header="Cuentas por Cobrar Vesupronta">
                <views:AccountsReceivableView DataContext="{Binding accounts_receivable_vm}"
                                               PaymentsContext="{Binding DataContext.payments_vm, RelativeSource={RelativeSource AncestorType=UserControl}}" />
            </TabItem>
            <TabItem Header="Pagos Vesupronta">
                <views:PaymentsView DataContext="{Binding payments_vm}" />
            </TabItem>
        </TabControl>
    </Grid>
</UserControl>
