<Window x:Class="NinOS.UI.Views.ElegirTipoCargaWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Tipo de carga"
        Width="460" SizeToContent="Height"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        FontSize="13">
    <StackPanel Margin="20">
        <TextBlock Text="¿Qué significa lo que escribió en CANTIDAD?" FontWeight="Bold" TextWrapping="Wrap"/>

        <RadioButton x:Name="rb_conteo" GroupName="tipo" IsChecked="True" Margin="0,12,0,2"
                     Content="Conteo: es el stock que debe quedar"/>
        <TextBlock Text="Ejemplo: en el sistema hay 10 y escribe 25 → queda 25." Margin="20,0,0,10"
                   Foreground="#6B7280" TextWrapping="Wrap"/>

        <RadioButton x:Name="rb_ajuste" GroupName="tipo"
                     Content="Ajuste: se suma o se resta al stock actual"/>
        <TextBlock Text="Ejemplo: en el sistema hay 10 y escribe 15 → queda 25; escribe -3 → queda 7."
                   Margin="20,0,0,10" Foreground="#6B7280" TextWrapping="Wrap"/>

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button Content="Cancelar" IsCancel="True" Width="100" Height="30" Margin="0,0,8,0"/>
            <Button Content="Continuar" IsDefault="True" Width="120" Height="30" Click="on_continuar_click"/>
        </StackPanel>
    </StackPanel>
</Window>
