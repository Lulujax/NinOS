<Window x:Class="NinOS.UI.Views.PaymentNoteHistoryWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Historial de Abonos"
        Width="980" Height="520"
        WindowStartupLocation="CenterOwner"
        WindowState="Maximized"
        ResizeMode="CanResizeWithGrip"
        Background="White"
        PreviewKeyDown="Window_PreviewKeyDown">
    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- TARJETA DE CABECERA -->
        <Border Grid.Row="0" Background="#F0F6FC" BorderBrush="#0D62B5" BorderThickness="1"
                CornerRadius="4" Padding="12" Margin="0,0,0,8">
            <StackPanel>
                <!-- Fila 1: Nota / Cliente / Vendedora -->
                <DockPanel LastChildFill="True">
                    <StackPanel Orientation="Horizontal" DockPanel.Dock="Left">
                        <TextBlock Text="Nota:" FontSize="12" FontWeight="Bold" Foreground="#0D62B5" VerticalAlignment="Center"/>
                        <TextBlock x:Name="NoteNumberText" FontSize="13" FontWeight="Bold" Foreground="#1565C0" Margin="6,0,18,0" VerticalAlignment="Center"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" DockPanel.Dock="Left">
                        <TextBlock Text="Cliente:" FontSize="12" FontWeight="Bold" Foreground="#0D62B5" VerticalAlignment="Center"/>
                        <TextBlock x:Name="CustomerText" FontSize="12" Foreground="#424242" Margin="6,0,18,0" VerticalAlignment="Center"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" DockPanel.Dock="Left">
                        <TextBlock Text="Vendedora:" FontSize="12" FontWeight="Bold" Foreground="#0D62B5" VerticalAlignment="Center"/>
                        <TextBlock x:Name="SellerText" FontSize="12" Foreground="#424242" Margin="6,0,0,0" VerticalAlignment="Center"/>
                    </StackPanel>
                </DockPanel>

                <!-- Fila 2: Totales -->
                <Border Background="White" BorderBrush="#DEE5EB" BorderThickness="1" CornerRadius="4" Margin="0,8,0,0" Padding="8,6">
                    <DockPanel LastChildFill="False">
                        <StackPanel Orientation="Horizontal" DockPanel.Dock="Left" Margin="0,0,24,0">
                            <TextBlock Text="FACTURADO:" FontSize="12" FontWeight="Bold" Foreground="#424242" VerticalAlignment="Center"/>
                            <TextBlock x:Name="TotalFacturadoText" FontSize="14" FontWeight="Bold" Foreground="#0D62B5" Margin="6,0,0,0" VerticalAlignment="Center"/>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" DockPanel.Dock="Left" Margin="0,0,24,0">
                            <TextBlock Text="TOTAL ABONADO:" FontSize="12" FontWeight="Bold" Foreground="#424242" VerticalAlignment="Center"/>
                            <TextBlock x:Name="TotalAbonadoText" FontSize="14" FontWeight="Bold" Foreground="#2E7D32" Margin="6,0,0,0" VerticalAlignment="Center"/>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" DockPanel.Dock="Left">
                            <TextBlock Text="SALDO PENDIENTE:" FontSize="12" FontWeight="Bold" Foreground="#424242" VerticalAlignment="Center"/>
                            <TextBlock x:Name="SaldoPendienteText" FontSize="14" FontWeight="Bold" Margin="6,0,0,0" VerticalAlignment="Center"/>
                        </StackPanel>
                    </DockPanel>
                </Border>
            </StackPanel>
        </Border>

        <!-- DATAGRID DE ABONOS -->
        <DataGrid Grid.Row="1" x:Name="HistoryGrid" AutoGenerateColumns="False"
                  AlternatingRowBackground="#F5F9FD" RowBackground="White"
                  CanUserAddRows="False" IsReadOnly="True" GridLinesVisibility="Horizontal"
                  HorizontalGridLinesBrush="#E0E7EE"
                  BorderBrush="#C5D3E0" BorderThickness="1" FontSize="11" RowHeight="30"
                  EnableRowVirtualization="True">
            <DataGrid.Resources>
                <Style TargetType="DataGridColumnHeader">
                    <Setter Property="Background" Value="#0D62B5"/>
                    <Setter Property="Foreground" Value="White"/>
                    <Setter Property="FontWeight" Value="Bold"/>
                    <Setter Property="FontSize" Value="11"/>
                    <Setter Property="Padding" Value="4,0"/>
                </Style>
            </DataGrid.Resources>
            <DataGrid.Columns>
                <DataGridTextColumn Header="FECHA PAGO" Binding="{Binding payment_date, StringFormat={}{0:dd/MM/yyyy}}" Width="90"/>
                <DataGridTextColumn Header="FECHA REGISTRO" Binding="{Binding fecha_registro_display}" Width="120"/>
                <DataGridTextColumn Header="ULT. EDICION" Binding="{Binding ult_edicion_display}" Width="120"/>
                <DataGridTextColumn Header="TIPO" Binding="{Binding payment_type}" Width="80"/>
                <DataGridTextColumn Header="BANCO" Binding="{Binding bank_name}" Width="85"/>
                <DataGridTextColumn Header="REFERENCIA" Binding="{Binding reference_number}" Width="95"/>
                <DataGridTextColumn Header="MONTO BS" Binding="{Binding monto_bs_display}" Width="85">
                    <DataGridTextColumn.ElementStyle>
                        <Style TargetType="TextBlock">
                            <Setter Property="HorizontalAlignment" Value="Right"/>
                            <Setter Property="TextAlignment" Value="Right"/>
                        </Style>
                    </DataGridTextColumn.ElementStyle>
                </DataGridTextColumn>
                <DataGridTextColumn Header="TASA" Binding="{Binding tasa_display}" Width="60">
                    <DataGridTextColumn.ElementStyle>
                        <Style TargetType="TextBlock">
                            <Setter Property="HorizontalAlignment" Value="Right"/>
                            <Setter Property="TextAlignment" Value="Right"/>
                        </Style>
                    </DataGridTextColumn.ElementStyle>
                </DataGridTextColumn>
                <DataGridTextColumn Header="MONTO" Binding="{Binding amount_usd, StringFormat={}{0:N2}}" Width="80">
                    <DataGridTextColumn.ElementStyle>
                        <Style TargetType="TextBlock">
                            <Setter Property="HorizontalAlignment" Value="Right"/>
                            <Setter Property="FontWeight" Value="SemiBold"/>
                        </Style>
                    </DataGridTextColumn.ElementStyle>
                </DataGridTextColumn>
                <DataGridTextColumn Header="OBSERVACIONES" Binding="{Binding notes}" Width="*"/>
                <DataGridTemplateColumn Header="ACCIONES" Width="55">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <Button Content="&#x270F;" ToolTip="Editar abono" FontSize="11"
                                    Background="Transparent" BorderThickness="0" Cursor="Hand"
                                    Click="EditButton_Click" Width="26" Height="22"
                                    Foreground="#0D62B5" Padding="0" HorizontalAlignment="Center"/>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
            </DataGrid.Columns>
        </DataGrid>

        <!-- PANEL DE ACCIONES -->
        <DockPanel Grid.Row="2" Margin="0,8,0,0" LastChildFill="False">
            <Button x:Name="BtnAddAbono" DockPanel.Dock="Left" Content="+ Registrar Nuevo Abono"
                    Background="#0D62B5" Foreground="White" FontWeight="SemiBold" FontSize="11"
                    Padding="10,5" BorderThickness="0" Cursor="Hand" Click="AddAbonoButton_Click">
                <Button.Template>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="{TemplateBinding Background}" CornerRadius="4" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#1976D2"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="bd" Property="Background" Value="#B0BEC5"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Button.Template>
            </Button>
            <Button DockPanel.Dock="Left" Margin="8,0,0,0" Content="Cerrar" Background="#E0E0E0" Foreground="#424242"
                    FontSize="10" Padding="8,3" BorderThickness="0" Cursor="Hand" Click="CloseButton_Click"/>
        </DockPanel>
    </Grid>
</Window>