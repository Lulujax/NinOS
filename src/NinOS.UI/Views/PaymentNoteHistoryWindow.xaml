<Window x:Class="NinOS.UI.Views.PaymentNoteHistoryWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Historial de Pagos"
        Width="800" Height="400"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResizeWithGrip"
        Background="White">
    <Grid Margin="15">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <TextBlock Grid.Row="0" x:Name="HeaderText" FontWeight="Bold" FontSize="14" Foreground="#2E7D32" HorizontalAlignment="Center" Margin="0,0,0,10"/>
        <DataGrid Grid.Row="1" x:Name="HistoryGrid" AutoGenerateColumns="False"
                  AlternatingRowBackground="#E8F5E9" RowBackground="White"
                  CanUserAddRows="False" IsReadOnly="True" GridLinesVisibility="All"
                  HorizontalGridLinesBrush="#A5D6A7" VerticalGridLinesBrush="#A5D6A7"
                  BorderBrush="#4CAF50" BorderThickness="1" FontSize="12" RowHeight="30">
            <DataGrid.Resources>
                <Style TargetType="DataGridColumnHeader">
                    <Setter Property="Background" Value="#2E7D32"/>
                    <Setter Property="Foreground" Value="White"/>
                    <Setter Property="FontWeight" Value="Bold"/>
                    <Setter Property="FontSize" Value="11"/>
                </Style>
            </DataGrid.Resources>
            <DataGrid.Columns>
                <DataGridTextColumn Header="FECHA" Binding="{Binding payment_date, StringFormat={}{0:dd/MM/yyyy HH:mm}}" Width="120"/>
                <DataGridTextColumn Header="USD" Binding="{Binding amount_usd, StringFormat={}{0:N2}}" Width="90">
                    <DataGridTextColumn.ElementStyle><Style TargetType="TextBlock"><Setter Property="HorizontalAlignment" Value="Right"/></Style></DataGridTextColumn.ElementStyle>
                </DataGridTextColumn>
                <DataGridTextColumn Header="BS" Binding="{Binding amount_bs, StringFormat={}{0:N2}}" Width="90">
                    <DataGridTextColumn.ElementStyle><Style TargetType="TextBlock"><Setter Property="HorizontalAlignment" Value="Right"/></Style></DataGridTextColumn.ElementStyle>
                </DataGridTextColumn>
                <DataGridTextColumn Header="TASA" Binding="{Binding exchange_rate, StringFormat={}{0:N2}}" Width="70"/>
                <DataGridTextColumn Header="TIPO" Binding="{Binding payment_type}" Width="100"/>
                <DataGridTextColumn Header="REF" Binding="{Binding reference_number}" Width="120"/>
            </DataGrid.Columns>
        </DataGrid>
    </Grid>
</Window>
