<Window x:Class="NinOS.UI.Views.AddPaymentWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Registrar Pago" Height="468" Width="460"
        WindowStartupLocation="CenterOwner" Background="#F5F5F5"
        ResizeMode="NoResize" FontSize="12">
    <Grid Margin="14">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="70"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <TextBlock Grid.Row="0" Grid.ColumnSpan="2" Text="Registrar Pago" FontSize="14" FontWeight="Bold"
                   Foreground="#1565C0" Margin="0,0,0,6"/>

        <TextBlock Grid.Row="1" Grid.Column="0" Text="Nota:" VerticalAlignment="Center" Margin="0,0,0,5"/>
        <Grid Grid.Row="1" Grid.Column="1" Margin="0,0,0,5">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBox x:Name="NoteTextBox" Grid.Column="0" Height="26" FontSize="11" VerticalContentAlignment="Center"
                     TextChanged="OnNoteSearchChanged" CaretBrush="Transparent"/>
            <Button x:Name="BtnToggleDropdown" Grid.Column="1" Content="&#x25BC;" Width="24" Height="26"
                    FontSize="9" Cursor="Hand" Click="OnToggleDropdown"
                    Background="#F5F5F5" Foreground="#757575" BorderBrush="#BDBDBD" BorderThickness="1,0,0,0"
                    VerticalAlignment="Center">
                <Button.Template>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="{TemplateBinding Background}" Padding="0"
                                BorderThickness="{TemplateBinding BorderThickness}" BorderBrush="{TemplateBinding BorderBrush}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#E0E0E0"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Button.Template>
            </Button>
            <Popup x:Name="NotePopup" IsOpen="False" AllowsTransparency="True"
                   PlacementTarget="{Binding ElementName=NoteTextBox}" Placement="Bottom"
                   MaxHeight="200" PopupAnimation="Fade" StaysOpen="False"
                   HorizontalOffset="0">
                <Border Background="White" BorderBrush="#BDBDBD" BorderThickness="1"
                        Width="{Binding ActualWidth, ElementName=NoteTextBox}">
                    <ListBox x:Name="NoteListBox" BorderThickness="0"
                             SelectionChanged="OnNoteListSelected"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding Display}" FontSize="11" Padding="4,2"/>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Border>
            </Popup>
        </Grid>

        <Border Grid.Row="2" Grid.ColumnSpan="2" x:Name="NoteInfoBorder" Background="#E3F2FD"
                CornerRadius="3" Padding="8" Margin="0,0,0,5" Visibility="Collapsed">
            <TextBlock x:Name="NoteInfoText" FontSize="11" Foreground="#1565C0" TextWrapping="Wrap"/>
        </Border>

        <TextBlock Grid.Row="3" Grid.Column="0" Text="Tipo:" VerticalAlignment="Center" Margin="0,0,0,5"/>
        <StackPanel Grid.Row="3" Grid.Column="1" Orientation="Horizontal" Margin="0,0,0,5">
            <RadioButton x:Name="RadioBS" Content="Bolivares" GroupName="PaymentType" IsChecked="True"
                         Margin="0,0,12,0" VerticalAlignment="Center" Checked="OnPaymentTypeChanged"/>
            <RadioButton x:Name="RadioEfectivo" Content="Efectivo" GroupName="PaymentType"
                         VerticalAlignment="Center" Checked="OnPaymentTypeChanged"/>
        </StackPanel>

        <TextBlock Grid.Row="4" Grid.Column="0" Text="Fecha:" VerticalAlignment="Center" Margin="0,0,0,5"/>
        <DatePicker Grid.Row="4" Grid.Column="1" x:Name="PaymentDatePicker" Margin="0,0,0,5" FontSize="11"/>

        <StackPanel x:Name="BsPanel" Grid.Row="5" Grid.Column="0" Grid.ColumnSpan="2">
            <Grid Margin="0,0,0,4">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="70"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="Tasa:" VerticalAlignment="Center" Margin="0,0,6,0"/>
                <TextBox x:Name="RateBox" Grid.Column="1" VerticalContentAlignment="Center" Height="24"
                         Width="90" HorizontalAlignment="Left" FontSize="11"/>
            </Grid>
            <Grid Margin="0,0,0,4">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="70"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="Bs:*" VerticalAlignment="Center" Margin="0,0,6,0"/>
                <TextBox x:Name="BsAmountBox" Grid.Column="1" VerticalContentAlignment="Center" Height="24"
                         Width="90" HorizontalAlignment="Left" FontSize="11"/>
            </Grid>
        </StackPanel>

        <Grid Grid.Row="6" Grid.Column="0" Grid.ColumnSpan="2" Margin="0,0,0,4">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="70"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0" Text="Monto USD:*" VerticalAlignment="Center" Margin="0,0,6,0"/>
            <TextBox x:Name="AmountBox" Grid.Column="1" VerticalContentAlignment="Center" Height="24"
                     Width="90" HorizontalAlignment="Left" FontSize="11"
                     TextChanged="OnAmountChanged"/>
            <TextBlock x:Name="EquivText" Grid.Column="1" Text="" FontSize="10" Foreground="#2E7D32"
                       VerticalAlignment="Center" Margin="96,0,0,0"/>
        </Grid>

        <StackPanel x:Name="RefPanel" Grid.Row="7" Grid.Column="0" Grid.ColumnSpan="2" Margin="0,0,0,4">
            <Grid Margin="0,0,0,4">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="70"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="Ref.:*" VerticalAlignment="Center" Margin="0,0,6,0"/>
                <TextBox x:Name="ReferenceBox" Grid.Column="1" VerticalContentAlignment="Center" Height="24"
                         Width="160" HorizontalAlignment="Left" MaxLength="50" FontSize="11"/>
            </Grid>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="70"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="Banco:*" VerticalAlignment="Center" Margin="0,0,6,0"/>
                <TextBox x:Name="BankBox" Grid.Column="1" VerticalContentAlignment="Center" Height="24"
                         Width="160" HorizontalAlignment="Left" MaxLength="100" FontSize="11"/>
            </Grid>
        </StackPanel>

        <Grid Grid.Row="8" Grid.Column="0" Grid.ColumnSpan="2" Margin="0,0,0,4">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="70"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0" Text="Obs.:" VerticalAlignment="Top" Margin="0,0,6,0"/>
            <TextBox x:Name="ObsBox" Grid.Column="1" Height="36" AcceptsReturn="True" TextWrapping="Wrap"
                     VerticalScrollBarVisibility="Auto" MaxLength="500" FontSize="11"/>
        </Grid>

        <TextBlock Grid.Row="9" Grid.ColumnSpan="2" x:Name="ErrorText" Foreground="#C62828" FontSize="10"
                   TextWrapping="Wrap" Margin="0,0,0,4" Visibility="Collapsed"/>

        <StackPanel Grid.Row="10" Grid.ColumnSpan="2" Orientation="Horizontal" HorizontalAlignment="Right"
                    VerticalAlignment="Bottom">
            <Button Content="Cancelar" Padding="10,4" Background="#E0E0E0" Foreground="#424242"
                    BorderThickness="0" Cursor="Hand" Click="OnCancelClick" Margin="0,0,6,0" FontSize="11"/>
            <Button x:Name="BtnRegistrar" Content="Registrar" Padding="10,4" Background="#1565C0" Foreground="White"
                    BorderThickness="0" Cursor="Hand" Click="OnConfirmClick" FontSize="11" FontWeight="SemiBold">
                <Button.Template>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="{TemplateBinding Background}" CornerRadius="4"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#1976D2"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Button.Template>
            </Button>
        </StackPanel>
    </Grid>
</Window>
