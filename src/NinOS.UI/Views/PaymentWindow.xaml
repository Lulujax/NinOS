<Window x:Class="NinOS.UI.Views.PaymentWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Registrar Pago"
        Width="480" SizeToContent="Height"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        Background="White" FontSize="14">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="150"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <TextBlock Grid.Row="0" Grid.Column="0" Text="Nota:" FontWeight="Bold" VerticalAlignment="Center" Margin="0,0,10,8"/>
        <TextBlock Grid.Row="0" Grid.Column="1" x:Name="NoteNumberText" VerticalAlignment="Center" Margin="0,0,0,8"/>

        <TextBlock Grid.Row="1" Grid.Column="0" Text="Saldo pendiente:" FontWeight="Bold" VerticalAlignment="Center" Margin="0,0,10,8"/>
        <TextBlock Grid.Row="1" Grid.Column="1" x:Name="BalanceText" FontWeight="Bold" Foreground="#D32F2F" VerticalAlignment="Center" Margin="0,0,0,8"/>

        <TextBlock Grid.Row="2" Grid.Column="0" Text="Tipo de pago:" FontWeight="Bold" VerticalAlignment="Center" Margin="0,0,10,8"/>
        <StackPanel Grid.Row="2" Grid.Column="1" Orientation="Horizontal" Margin="0,0,0,8">
            <RadioButton x:Name="RadioBS" Content="Bolivares" GroupName="PaymentType" IsChecked="True" Margin="0,0,15,0" VerticalAlignment="Center" Checked="OnPaymentTypeChanged"/>
            <RadioButton x:Name="RadioEfectivo" Content="Efectivo ($)" GroupName="PaymentType" VerticalAlignment="Center" Checked="OnPaymentTypeChanged"/>
        </StackPanel>

        <TextBlock Grid.Row="3" Grid.Column="0" Text="Fecha del pago:" FontWeight="Bold" VerticalAlignment="Center" Margin="0,0,10,8"/>
        <DatePicker Grid.Row="3" Grid.Column="1" x:Name="PaymentDatePicker" VerticalAlignment="Center" Margin="0,0,0,8"/>

        <StackPanel x:Name="BSPanel" Grid.Row="4" Grid.Column="0" Grid.ColumnSpan="2" Margin="0,0,0,4">
            <Grid Margin="0,0,0,4">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="150"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="Tasa BS/USD:" FontWeight="Bold" VerticalAlignment="Center" Margin="0,0,10,0"/>
                <TextBox x:Name="ExchangeRateBox" Grid.Column="1" VerticalContentAlignment="Center" Height="30" Width="120" HorizontalAlignment="Left" PreviewTextInput="OnPreviewNumericInput" TextChanged="OnBsChanged"/>
            </Grid>
            <Grid Margin="0,0,0,4">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="150"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="Monto (BS):" FontWeight="Bold" VerticalAlignment="Center" Margin="0,0,10,0"/>
                <TextBox x:Name="AmountBsBox" Grid.Column="1" VerticalContentAlignment="Center" Height="30" Width="120" HorizontalAlignment="Left" PreviewTextInput="OnPreviewNumericInput" TextChanged="OnBsChanged"/>
            </Grid>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="150"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="Abono en USD:" FontWeight="Bold" VerticalAlignment="Center" Margin="0,0,10,0"/>
                <TextBlock x:Name="EquivUsdText" Grid.Column="1" Text="-" FontWeight="Bold" Foreground="#2E7D32" VerticalAlignment="Center"/>
            </Grid>
        </StackPanel>

        <StackPanel x:Name="EfectivoPanel" Grid.Row="4" Grid.Column="0" Grid.ColumnSpan="2" Orientation="Horizontal" Visibility="Collapsed" Margin="0,0,0,4">
            <TextBlock Text="Monto en efectivo:" FontWeight="Bold" VerticalAlignment="Center" Margin="0,0,10,0" Width="150"/>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="120"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" Orientation="Horizontal">
                    <TextBox x:Name="AmountUsdBox" VerticalContentAlignment="Center" Height="30" Width="100" PreviewTextInput="OnPreviewNumericInput" TextChanged="OnEfectivoChanged"/>
                    <TextBlock Text="$" FontWeight="Bold" VerticalAlignment="Center" Margin="5,0,0,0" Foreground="#888"/>
                </StackPanel>
                <TextBlock Grid.Column="1" x:Name="EquivEfectivoText" Text="-" FontWeight="Bold" Foreground="#2E7D32" VerticalAlignment="Center" Margin="10,0,0,0"/>
            </Grid>
        </StackPanel>

        <StackPanel x:Name="ReferencePanel" Grid.Row="5" Grid.Column="0" Grid.ColumnSpan="2" Orientation="Horizontal" Margin="0,0,0,8">
            <TextBlock Text="Referencia:" FontWeight="Bold" VerticalAlignment="Center" Margin="0,0,10,0" Width="150"/>
            <TextBox x:Name="ReferenceBox" VerticalContentAlignment="Center" Height="30" Width="300"/>
        </StackPanel>

        <StackPanel Grid.Row="8" Grid.Column="0" Grid.ColumnSpan="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
            <Button Content="Cancelar" Width="100" Height="34" Margin="0,0,10,0" Click="OnCancelClick"/>
            <Button Content="Registrar Pago" Width="140" Height="34" FontWeight="Bold" Background="#4CAF50" Foreground="White" Click="OnConfirmClick"/>
        </StackPanel>
    </Grid>
</Window>
