<Window x:Class="NinOS.UI.Views.PaymentWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Registrar Abono"
        Width="420"
        SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="White"
        FontSize="14">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="160"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <TextBlock Grid.Row="0" Grid.Column="0" Text="Nota:" FontWeight="Bold" VerticalAlignment="Center" Margin="0,0,10,8"/>
        <TextBlock Grid.Row="0" Grid.Column="1" x:Name="NoteNumberText" VerticalAlignment="Center" Margin="0,0,0,8"/>

        <TextBlock Grid.Row="1" Grid.Column="0" Text="Saldo pendiente:" FontWeight="Bold" VerticalAlignment="Center" Margin="0,0,10,8"/>
        <TextBlock Grid.Row="1" Grid.Column="1" x:Name="BalanceText" FontWeight="Bold" Foreground="#D32F2F" VerticalAlignment="Center" Margin="0,0,0,8"/>

        <TextBlock Grid.Row="2" Grid.Column="0" Text="Monto (USD):" FontWeight="Bold" VerticalAlignment="Center" Margin="0,0,10,8"/>
        <TextBox Grid.Row="2" Grid.Column="1" x:Name="AmountUsdBox" Margin="0,0,0,8" VerticalContentAlignment="Center" Height="30" PreviewTextInput="OnPreviewNumericInput"/>

        <TextBlock Grid.Row="3" Grid.Column="0" Text="Tasa de cambio:" FontWeight="Bold" VerticalAlignment="Center" Margin="0,0,10,8"/>
        <TextBox Grid.Row="3" Grid.Column="1" x:Name="ExchangeRateBox" Margin="0,0,0,8" VerticalContentAlignment="Center" Height="30" PreviewTextInput="OnPreviewNumericInput" TextChanged="OnExchangeRateChanged"/>

        <TextBlock Grid.Row="4" Grid.Column="0" Text="Monto (Bs):" FontWeight="Bold" VerticalAlignment="Center" Margin="0,0,10,8"/>
        <TextBlock Grid.Row="4" Grid.Column="1" x:Name="AmountBsText" FontWeight="Bold" VerticalAlignment="Center" Margin="0,0,0,8"/>

        <StackPanel Grid.Row="5" Grid.Column="0" Grid.ColumnSpan="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
            <Button Content="Cancelar" Width="100" Height="34" Margin="0,0,10,0" Click="OnCancelClick"/>
            <Button Content="Registrar Abono" Width="130" Height="34" FontWeight="Bold" Background="#2196F3" Foreground="White" Click="OnConfirmClick"/>
        </StackPanel>
    </Grid>
</Window>
