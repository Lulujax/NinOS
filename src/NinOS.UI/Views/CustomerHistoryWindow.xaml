<Window x:Class="NinOS.UI.Views.CustomerHistoryWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Historial del Cliente"
        Width="1160" Height="720"
        MinWidth="960" MinHeight="560"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResizeWithGrip"
        Background="#F5F7FA">
    <Window.Resources>
        <Style x:Key="MetricCard" TargetType="Border">
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="#D0D7DE"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="4"/>
            <Setter Property="Padding" Value="10,6"/>
            <Setter Property="Margin" Value="4,0"/>
            <Setter Property="MinWidth" Value="125"/>
        </Style>

        <Style x:Key="ActionButton" TargetType="Button">
            <Setter Property="FontSize" Value="10.5"/>
            <Setter Property="Padding" Value="6,2"/>
            <Setter Property="Margin" Value="2"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="BorderThickness" Value="1"/>
        </Style>

        <Style x:Key="PreviewBtn" TargetType="Button" BasedOn="{StaticResource ActionButton}">
            <Setter Property="Background" Value="#F5F5F5"/>
            <Setter Property="BorderBrush" Value="#CCCCCC"/>
            <Setter Property="Foreground" Value="#333333"/>
        </Style>

        <Style x:Key="PdfBtn" TargetType="Button" BasedOn="{StaticResource ActionButton}">
            <Setter Property="Background" Value="#E8F5E9"/>
            <Setter Property="BorderBrush" Value="#A5D6A7"/>
            <Setter Property="Foreground" Value="#2E7D32"/>
        </Style>

        <Style x:Key="PaymentsBtn" TargetType="Button" BasedOn="{StaticResource ActionButton}">
            <Setter Property="Background" Value="#E3F2FD"/>
            <Setter Property="BorderBrush" Value="#90CAF9"/>
            <Setter Property="Foreground" Value="#1565C0"/>
        </Style>

        <Style x:Key="CompactDataGrid" TargetType="DataGrid">
            <Setter Property="AutoGenerateColumns" Value="False"/>
            <Setter Property="IsReadOnly" Value="True"/>
            <Setter Property="GridLinesVisibility" Value="Horizontal"/>
            <Setter Property="HeadersVisibility" Value="Column"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush" Value="#D0D7DE"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="RowHeaderWidth" Value="0"/>
            <Setter Property="CanUserAddRows" Value="False"/>
            <Setter Property="CanUserDeleteRows" Value="False"/>
            <Setter Property="CanUserReorderColumns" Value="False"/>
            <Setter Property="CanUserResizeColumns" Value="False"/>
            <Setter Property="SelectionMode" Value="Single"/>
            <Setter Property="EnableRowVirtualization" Value="True"/>
            <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Auto"/>
            <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Auto"/>
            <Setter Property="FontSize" Value="11.5"/>
            <Setter Property="MinRowHeight" Value="26"/>
            <Setter Property="AlternatingRowBackground" Value="#FAFBFC"/>
            <Setter Property="RowBackground" Value="White"/>
            <Setter Property="ColumnHeaderStyle">
                <Setter.Value>
                    <Style TargetType="DataGridColumnHeader">
                        <Setter Property="Background" Value="#F0F4F8"/>
                        <Setter Property="Foreground" Value="#24292F"/>
                        <Setter Property="FontWeight" Value="Bold"/>
                        <Setter Property="BorderThickness" Value="0,0,1,1"/>
                        <Setter Property="BorderBrush" Value="#D0D7DE"/>
                        <Setter Property="Padding" Value="6,4"/>
                        <Setter Property="HorizontalContentAlignment" Value="Center"/>
                    </Style>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="CellCenter" TargetType="TextBlock">
            <Setter Property="HorizontalAlignment" Value="Center"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="TextAlignment" Value="Center"/>
        </Style>

        <Style x:Key="CellRight" TargetType="TextBlock">
            <Setter Property="HorizontalAlignment" Value="Right"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="TextAlignment" Value="Right"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="0,0,4,0"/>
        </Style>

        <Style x:Key="CellTextWrap" TargetType="TextBlock">
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
        </Style>
    </Window.Resources>

    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- FILA 0: CABECERA CON DATOS DEL CLIENTE Y TARJETAS DE TOTALES -->
        <Border Grid.Row="0" Background="#F0F4F8" BorderBrush="#0D62B5" BorderThickness="1"
                CornerRadius="6" Padding="12" Margin="0,0,0,10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Datos del cliente -->
                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                        <TextBlock Text="{Binding BusinessName}" FontSize="18" FontWeight="Bold" Foreground="#0D62B5" VerticalAlignment="Center"/>
                        <Border Background="#E3F2FD" BorderBrush="#90CAF9" BorderThickness="1" CornerRadius="3" Padding="6,1" Margin="10,0,0,0" VerticalAlignment="Center">
                            <TextBlock Text="{Binding CustomerCode}" FontWeight="Bold" Foreground="#1565C0" FontSize="12"/>
                        </Border>
                    </StackPanel>

                    <WrapPanel Margin="0,0,0,4">
                        <StackPanel Orientation="Horizontal" Margin="0,0,16,2">
                            <TextBlock Text="RIF: " FontWeight="Bold" Foreground="#555"/>
                            <TextBlock Text="{Binding Rif}" FontWeight="SemiBold"/>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,16,2">
                            <TextBlock Text="Zona: " FontWeight="Bold" Foreground="#555"/>
                            <TextBlock Text="{Binding ZonaName}" FontWeight="SemiBold" Foreground="#0D62B5"/>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,16,2">
                            <TextBlock Text="Contacto: " FontWeight="Bold" Foreground="#555"/>
                            <TextBlock Text="{Binding ContactName}"/>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,16,2">
                            <TextBlock Text="Teléfono: " FontWeight="Bold" Foreground="#555"/>
                            <TextBlock Text="{Binding PhoneNumber}"/>
                        </StackPanel>
                    </WrapPanel>

                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="Dir. Fiscal: " FontWeight="Bold" Foreground="#666" FontSize="11"/>
                        <TextBlock Text="{Binding FiscalAddress}" FontSize="11" Foreground="#444" Margin="0,0,16,0" TextTrimming="CharacterEllipsis" MaxWidth="320"/>
                        <TextBlock Text="Dir. Despacho: " FontWeight="Bold" Foreground="#666" FontSize="11"/>
                        <TextBlock Text="{Binding EffectiveDeliveryAddress}" FontSize="11" Foreground="#444" TextTrimming="CharacterEllipsis" MaxWidth="320"/>
                    </StackPanel>
                </StackPanel>

                <!-- Tarjetas KPI de Totales -->
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Style="{StaticResource MetricCard}">
                        <StackPanel HorizontalAlignment="Center">
                            <TextBlock Text="TOTAL FACTURADO" FontSize="9.5" FontWeight="Bold" Foreground="#555" HorizontalAlignment="Center"/>
                            <TextBlock Text="{Binding TotalInvoicedUsd, StringFormat='${0:N2}'}" FontSize="15" FontWeight="Bold" Foreground="#0D62B5" HorizontalAlignment="Center" Margin="0,2,0,0"/>
                            <TextBlock Text="{Binding TotalNotesCount, StringFormat='{0} notas'}" FontSize="10" Foreground="#777" HorizontalAlignment="Center"/>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource MetricCard}">
                        <StackPanel HorizontalAlignment="Center">
                            <TextBlock Text="TOTAL ABONADO" FontSize="9.5" FontWeight="Bold" Foreground="#555" HorizontalAlignment="Center"/>
                            <TextBlock Text="{Binding TotalPaidUsd, StringFormat='${0:N2}'}" FontSize="15" FontWeight="Bold" Foreground="#2E7D32" HorizontalAlignment="Center" Margin="0,2,0,0"/>
                            <TextBlock Text="Cobrado" FontSize="10" Foreground="#2E7D32" HorizontalAlignment="Center"/>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource MetricCard}">
                        <StackPanel HorizontalAlignment="Center">
                            <TextBlock Text="SALDO PENDIENTE" FontSize="9.5" FontWeight="Bold" Foreground="#555" HorizontalAlignment="Center"/>
                            <TextBlock Text="{Binding BalanceDueUsd, StringFormat='${0:N2}'}" FontSize="15" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,2,0,0">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Foreground" Value="#D32F2F"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding BalanceDueUsd}" Value="0">
                                                <Setter Property="Foreground" Value="#2E7D32"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                            <TextBlock Text="Por cobrar" FontSize="10" Foreground="#777" HorizontalAlignment="Center"/>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource MetricCard}">
                        <StackPanel HorizontalAlignment="Center">
                            <TextBlock Text="NOTAS CRÉDITO" FontSize="9.5" FontWeight="Bold" Foreground="#555" HorizontalAlignment="Center"/>
                            <TextBlock Text="{Binding TotalCreditNotesUsd, StringFormat='${0:N2}'}" FontSize="15" FontWeight="Bold" Foreground="#6A1B9A" HorizontalAlignment="Center" Margin="0,2,0,0"/>
                            <TextBlock Text="{Binding TotalCreditNotesCount, StringFormat='{0} NCs'}" FontSize="10" Foreground="#777" HorizontalAlignment="Center"/>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Grid>
        </Border>

        <!-- FILA 1: BARRA DE FILTROS POR FECHA -->
        <Border Grid.Row="1" Background="White" BorderBrush="#D0D7DE" BorderThickness="1"
                CornerRadius="4" Padding="10,6" Margin="0,0,0,10">
            <DockPanel LastChildFill="False">
                <StackPanel Orientation="Horizontal" DockPanel.Dock="Left" VerticalAlignment="Center">
                    <TextBlock Text="Rango de Fechas:" FontWeight="Bold" VerticalAlignment="Center" Margin="0,0,12,0"/>
                    <TextBlock Text="Desde:" VerticalAlignment="Center" Margin="0,0,4,0"/>
                    <DatePicker SelectedDate="{Binding FromDate, Mode=TwoWay}" Width="125" Height="25" Margin="0,0,12,0"/>
                    <TextBlock Text="Hasta:" VerticalAlignment="Center" Margin="0,0,4,0"/>
                    <DatePicker SelectedDate="{Binding ToDate, Mode=TwoWay}" Width="125" Height="25" Margin="0,0,16,0"/>

                    <Button Content="Filtrar" Command="{Binding FilterCommand}"
                            Background="#1565C0" Foreground="White" FontWeight="Bold"
                            FontSize="11.5" Padding="14,3" Height="25" BorderThickness="0" Cursor="Hand" Margin="0,0,8,0">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border Background="{TemplateBinding Background}" CornerRadius="3" Padding="{TemplateBinding Padding}">
                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>

                    <Button Content="Ver Todo el Historial" Command="{Binding ClearFilterCommand}"
                            Background="#E0E0E0" Foreground="#333333" FontWeight="SemiBold"
                            FontSize="11.5" Padding="12,3" Height="25" BorderThickness="0" Cursor="Hand">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border Background="{TemplateBinding Background}" CornerRadius="3" Padding="{TemplateBinding Padding}">
                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- FILA 2: PESTAÑAS DEL HISTORIAL -->
        <TabControl Grid.Row="2" Background="Transparent" BorderThickness="0">
            <!-- PESTAÑA 1: NOTAS DE ENTREGA -->
            <TabItem Header="Notas de Entrega">
                <DataGrid Style="{StaticResource CompactDataGrid}" ItemsSource="{Binding DeliveryNotes}">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="N° NOTA" Binding="{Binding note_number}" Width="75" ElementStyle="{StaticResource CellCenter}"/>
                        <DataGridTextColumn Header="FECHA" Binding="{Binding creation_date, StringFormat=dd/MM/yyyy}" Width="80" ElementStyle="{StaticResource CellCenter}"/>
                        <DataGridTextColumn Header="DESPACHO" Binding="{Binding dispatch_date, StringFormat=dd/MM/yyyy}" Width="80" ElementStyle="{StaticResource CellCenter}"/>
                        <DataGridTextColumn Header="TIPO" Binding="{Binding note_type_display}" Width="75" ElementStyle="{StaticResource CellCenter}"/>
                        <DataGridTextColumn Header="VENDEDOR" Binding="{Binding seller_name}" Width="95" ElementStyle="{StaticResource CellCenter}"/>
                        <DataGridTextColumn Header="TOTAL ($)" Binding="{Binding total_amount_usd, StringFormat=N2}" Width="85" ElementStyle="{StaticResource CellRight}"/>
                        <DataGridTextColumn Header="ABONADO ($)" Binding="{Binding paid_amount_usd, StringFormat=N2}" Width="85" ElementStyle="{StaticResource CellRight}"/>
                        <DataGridTextColumn Header="SALDO ($)" Binding="{Binding balance_due_usd, StringFormat=N2}" Width="85" ElementStyle="{StaticResource CellRight}"/>
                        <DataGridTextColumn Header="ESTADO" Binding="{Binding status}" Width="80" ElementStyle="{StaticResource CellCenter}"/>
                        <DataGridTemplateColumn Header="OBSERVACIONES" Width="*">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding sales_observations}" ToolTip="{Binding sales_observations}" Style="{StaticResource CellTextWrap}"/>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTemplateColumn Header="ACCIONES" Width="185">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                        <Button Content="Vista Previa" Style="{StaticResource PreviewBtn}"
                                                Command="{Binding DataContext.PreviewNoteCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                CommandParameter="{Binding}"/>
                                        <Button Content="PDF" Style="{StaticResource PdfBtn}"
                                                Command="{Binding DataContext.PrintNotePdfCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                CommandParameter="{Binding}"/>
                                        <Button Content="Abonos" Style="{StaticResource PaymentsBtn}"
                                                Command="{Binding DataContext.ViewNotePaymentsCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                CommandParameter="{Binding}"/>
                                    </StackPanel>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>
            </TabItem>

            <!-- PESTAÑA 2: NOTAS DE CRÉDITO -->
            <TabItem Header="Notas de Crédito (Devoluciones y Obsequios)">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- Subfiltro de categoría -->
                    <Border Grid.Row="0" Background="#F9FAFB" BorderBrush="#E0E0E0" BorderThickness="1" CornerRadius="3" Padding="8,4" Margin="0,4,0,6">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="Categoría:" FontWeight="Bold" VerticalAlignment="Center" Margin="0,0,8,0"/>
                            <ComboBox ItemsSource="{Binding CreditNoteCategoryOptions}"
                                      SelectedItem="{Binding CreditNoteCategoryFilter, Mode=TwoWay}"
                                      Width="140" Height="24" VerticalContentAlignment="Center"/>
                        </StackPanel>
                    </Border>

                    <DataGrid Grid.Row="1" Style="{StaticResource CompactDataGrid}" ItemsSource="{Binding CreditNotes}">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="N° NC" Binding="{Binding note_number}" Width="85" ElementStyle="{StaticResource CellCenter}"/>
                            <DataGridTextColumn Header="CATEGORÍA" Binding="{Binding category}" Width="95" ElementStyle="{StaticResource CellCenter}"/>
                            <DataGridTextColumn Header="NOTA ORIGEN" Binding="{Binding source_note_number}" Width="95" ElementStyle="{StaticResource CellCenter}"/>
                            <DataGridTextColumn Header="FECHA" Binding="{Binding creation_date, StringFormat=dd/MM/yyyy}" Width="85" ElementStyle="{StaticResource CellCenter}"/>
                            <DataGridTextColumn Header="VENDEDOR" Binding="{Binding seller_name}" Width="100" ElementStyle="{StaticResource CellCenter}"/>
                            <DataGridTextColumn Header="TOTAL USD" Binding="{Binding total_amount_usd, StringFormat=N2}" Width="95" ElementStyle="{StaticResource CellRight}"/>
                            <DataGridTextColumn Header="ESTADO" Binding="{Binding status}" Width="85" ElementStyle="{StaticResource CellCenter}"/>
                            <DataGridTemplateColumn Header="ACCIONES" Width="140">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                            <Button Content="Detalle" Style="{StaticResource PreviewBtn}"
                                                    Command="{Binding DataContext.ViewCreditNoteDetailCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                    CommandParameter="{Binding}"/>
                                            <Button Content="PDF" Style="{StaticResource PdfBtn}"
                                                    Command="{Binding DataContext.PrintCreditNotePdfCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                    CommandParameter="{Binding}"/>
                                        </StackPanel>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </TabItem>

            <!-- PESTAÑA 3: HISTORIAL DE ABONOS Y COBRANZAS -->
            <TabItem Header="Cobranzas y Abonos Realizados">
                <DataGrid Style="{StaticResource CompactDataGrid}" ItemsSource="{Binding Payments}">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="FECHA" Binding="{Binding payment_date, StringFormat=dd/MM/yyyy}" Width="85" ElementStyle="{StaticResource CellCenter}"/>
                        <DataGridTextColumn Header="N° NOTA" Binding="{Binding note_number}" Width="80" ElementStyle="{StaticResource CellCenter}"/>
                        <DataGridTextColumn Header="MÉTODO" Binding="{Binding payment_type}" Width="105" ElementStyle="{StaticResource CellCenter}"/>
                        <DataGridTextColumn Header="MONTO USD" Binding="{Binding amount_usd, StringFormat=N2}" Width="95" ElementStyle="{StaticResource CellRight}"/>
                        <DataGridTextColumn Header="MONTO BS" Binding="{Binding monto_bs_display}" Width="95" ElementStyle="{StaticResource CellRight}"/>
                        <DataGridTextColumn Header="TASA BCV" Binding="{Binding tasa_display}" Width="80" ElementStyle="{StaticResource CellCenter}"/>
                        <DataGridTextColumn Header="BANCO" Binding="{Binding bank_name}" Width="110" ElementStyle="{StaticResource CellCenter}"/>
                        <DataGridTextColumn Header="REFERENCIA" Binding="{Binding reference_number}" Width="110" ElementStyle="{StaticResource CellCenter}"/>
                        <DataGridTemplateColumn Header="OBSERVACIONES" Width="*">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding notes}" ToolTip="{Binding notes}" Style="{StaticResource CellTextWrap}"/>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>
            </TabItem>

            <!-- PESTAÑA 4: PRODUCTOS MÁS COMPRADOS -->
            <TabItem Header="Artículos Más Comprados">
                <DataGrid Style="{StaticResource CompactDataGrid}" ItemsSource="{Binding TopProducts}">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="CÓDIGO" Binding="{Binding ProductCode}" Width="95" ElementStyle="{StaticResource CellCenter}"/>
                        <DataGridTextColumn Header="PRODUCTO" Binding="{Binding ProductName}" Width="260"/>
                        <DataGridTextColumn Header="CANTIDAD TOTAL" Binding="{Binding TotalQuantity}" Width="110" ElementStyle="{StaticResource CellCenter}"/>
                        <DataGridTextColumn Header="ÚLTIMO PRECIO ($)" Binding="{Binding LastPriceUsd, StringFormat=N2}" Width="120" ElementStyle="{StaticResource CellRight}"/>
                        <DataGridTextColumn Header="TOTAL FACTURADO ($)" Binding="{Binding TotalAmountUsd, StringFormat=N2}" Width="135" ElementStyle="{StaticResource CellRight}"/>
                        <DataGridTextColumn Header="ÚLTIMA COMPRA" Binding="{Binding LastPurchaseDate, StringFormat=dd/MM/yyyy}" Width="105" ElementStyle="{StaticResource CellCenter}"/>
                    </DataGrid.Columns>
                </DataGrid>
            </TabItem>
        </TabControl>

        <!-- FILA 3: FOOTER -->
        <Border Grid.Row="3" Margin="0,10,0,0">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="Cerrar" Click="OnCloseClick"
                        Background="#6C757D" Foreground="White" FontWeight="Bold"
                        Padding="18,6" Cursor="Hand" BorderThickness="0">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border Background="{TemplateBinding Background}" CornerRadius="4" Padding="{TemplateBinding Padding}">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                        </ControlTemplate>
                    </Button.Template>
                </Button>
            </StackPanel>
        </Border>
    </Grid>
</Window>
