<Window x:Class="NinOS.UI.Views.ProductSalesHistoryWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Historial de Ventas del Producto"
        Width="1000" Height="560"
        WindowStartupLocation="CenterOwner"
        WindowState="Maximized"
        ResizeMode="CanResizeWithGrip"
        Background="White"
        PreviewKeyDown="Window_PreviewKeyDown">
    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- TARJETA DE PRODUCTO -->
        <Border Grid.Row="0" Background="#F0F6FC" BorderBrush="#0D62B5" BorderThickness="1"
                CornerRadius="4" Padding="12" Margin="0,0,0,8">
            <StackPanel>
                <DockPanel LastChildFill="True">
                    <StackPanel Orientation="Horizontal" DockPanel.Dock="Left">
                        <TextBlock Text="Producto:" FontSize="15" FontWeight="Bold" Foreground="#0D62B5" VerticalAlignment="Center"/>
                        <TextBlock x:Name="ProductNameText" FontSize="17" FontWeight="Bold" Foreground="#1565C0" Margin="6,0,18,0" VerticalAlignment="Center"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" DockPanel.Dock="Left">
                        <TextBlock Text="Código:" FontSize="15" FontWeight="Bold" Foreground="#0D62B5" VerticalAlignment="Center"/>
                        <TextBlock x:Name="ProductCodeText" FontSize="15" Foreground="#424242" Margin="6,0,18,0" VerticalAlignment="Center"/>
                    </StackPanel>
                </DockPanel>

                <Border Background="White" BorderBrush="#DEE5EB" BorderThickness="1" CornerRadius="4" Margin="0,8,0,0" Padding="8,6">
                    <DockPanel LastChildFill="False">
                        <StackPanel Orientation="Horizontal" DockPanel.Dock="Left" Margin="0,0,24,0">
                            <TextBlock Text="CATEGORÍA:" FontSize="15" FontWeight="Bold" Foreground="#424242" VerticalAlignment="Center"/>
                            <TextBlock x:Name="ProductCategoryText" FontSize="16" FontWeight="Bold" Foreground="#0D62B5" Margin="6,0,0,0" VerticalAlignment="Center"/>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" DockPanel.Dock="Left" Margin="0,0,24,0">
                            <TextBlock Text="PRECIO ($):" FontSize="15" FontWeight="Bold" Foreground="#424242" VerticalAlignment="Center"/>
                            <TextBlock x:Name="ProductPriceText" FontSize="16" FontWeight="Bold" Foreground="#2E7D32" Margin="6,0,0,0" VerticalAlignment="Center"/>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" DockPanel.Dock="Left" Margin="0,0,24,0">
                            <TextBlock Text="STOCK:" FontSize="15" FontWeight="Bold" Foreground="#424242" VerticalAlignment="Center"/>
                            <TextBlock x:Name="ProductStockText" FontSize="16" FontWeight="Bold" Foreground="#E65100" Margin="6,0,0,0" VerticalAlignment="Center"/>
                        </StackPanel>
                    </DockPanel>
                </Border>
            </StackPanel>
        </Border>

        <!-- DATAGRID DE HISTORIAL DE VENTAS -->
        <DataGrid Grid.Row="1" x:Name="HistoryGrid" AutoGenerateColumns="False"
                  AlternatingRowBackground="#F5F9FD" RowBackground="White"
                  CanUserAddRows="False" IsReadOnly="True" GridLinesVisibility="Horizontal"
                  HorizontalGridLinesBrush="#E0E7EE"
                  BorderBrush="#C5D3E0" BorderThickness="1" FontSize="14" RowHeight="35"
                  EnableRowVirtualization="True">
            <DataGrid.Resources>
                <Style TargetType="DataGridColumnHeader">
                    <Setter Property="Background" Value="#0D62B5"/>
                    <Setter Property="Foreground" Value="White"/>
                    <Setter Property="FontWeight" Value="Bold"/>
                    <Setter Property="FontSize" Value="14"/>
                    <Setter Property="Padding" Value="4,0"/>
                </Style>
            </DataGrid.Resources>
            <DataGrid.Columns>
                <DataGridTextColumn Header="NOTA" Binding="{Binding note_number}" Width="90"/>
                <DataGridTextColumn Header="FECHA" Binding="{Binding fecha_display}" Width="90"/>
                <DataGridTextColumn Header="CLIENTE" Binding="{Binding customer_name}" Width="*"/>
                <DataGridTextColumn Header="VENDEDORA" Binding="{Binding seller_name}" Width="110"/>
                <DataGridTextColumn Header="VENDIDO EN" Binding="{Binding sold_as}" Width="90"/>
                <DataGridTextColumn Header="MOVIMIENTO" Binding="{Binding movement_type}" Width="95">
                    <DataGridTextColumn.ElementStyle>
                        <Style TargetType="TextBlock">
                            <Setter Property="HorizontalAlignment" Value="Center"/>
                            <Setter Property="FontWeight" Value="Bold"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding movement_type}" Value="ENTRADA">
                                    <Setter Property="Foreground" Value="#2E7D32"/>
                                </DataTrigger>
                                <DataTrigger Binding="{Binding movement_type}" Value="SALIDA">
                                    <Setter Property="Foreground" Value="#C62828"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </DataGridTextColumn.ElementStyle>
                </DataGridTextColumn>
                <DataGridTextColumn Header="UNIDADES" Binding="{Binding unidades_display}" Width="80">
                    <DataGridTextColumn.ElementStyle>
                        <Style TargetType="TextBlock">
                            <Setter Property="HorizontalAlignment" Value="Right"/>
                            <Setter Property="FontWeight" Value="Bold"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding movement_type}" Value="ENTRADA">
                                    <Setter Property="Foreground" Value="#2E7D32"/>
                                </DataTrigger>
                                <DataTrigger Binding="{Binding movement_type}" Value="SALIDA">
                                    <Setter Property="Foreground" Value="#C62828"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </DataGridTextColumn.ElementStyle>
                </DataGridTextColumn>
                <DataGridTextColumn Header="PRECIO U." Binding="{Binding precio_display}" Width="85">
                    <DataGridTextColumn.ElementStyle>
                        <Style TargetType="TextBlock">
                            <Setter Property="HorizontalAlignment" Value="Right"/>
                            <Setter Property="TextAlignment" Value="Right"/>
                        </Style>
                    </DataGridTextColumn.ElementStyle>
                </DataGridTextColumn>
                <DataGridTextColumn Header="SUBTOTAL" Binding="{Binding subtotal_display}" Width="85">
                    <DataGridTextColumn.ElementStyle>
                        <Style TargetType="TextBlock">
                            <Setter Property="HorizontalAlignment" Value="Right"/>
                            <Setter Property="TextAlignment" Value="Right"/>
                        </Style>
                    </DataGridTextColumn.ElementStyle>
                </DataGridTextColumn>
                <DataGridTextColumn Header="ESTADO" Binding="{Binding status}" Width="85">
                    <DataGridTextColumn.ElementStyle>
                        <Style TargetType="TextBlock">
                            <Setter Property="HorizontalAlignment" Value="Center"/>
                            <Setter Property="FontWeight" Value="SemiBold"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding status}" Value="Anulada">
                                    <Setter Property="Foreground" Value="#2E7D32"/>
                                </DataTrigger>
                                <DataTrigger Binding="{Binding status}" Value="Pendiente">
                                    <Setter Property="Foreground" Value="#C62828"/>
                                </DataTrigger>
                                <DataTrigger Binding="{Binding status}" Value="Pagada">
                                    <Setter Property="Foreground" Value="#1565C0"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </DataGridTextColumn.ElementStyle>
                </DataGridTextColumn>
            </DataGrid.Columns>
        </DataGrid>

        <!-- PANEL DE ACCIONES -->
        <DockPanel Grid.Row="2" Margin="0,8,0,0" LastChildFill="False">
            <Button DockPanel.Dock="Left" Content="Cerrar" Background="#E0E0E0" Foreground="#424242"
                    FontSize="13" Padding="8,3" BorderThickness="0" Cursor="Hand" Click="CloseButton_Click"/>
        </DockPanel>
    </Grid>
</Window>
