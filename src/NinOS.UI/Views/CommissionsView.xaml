<UserControl x:Class="NinOS.UI.Views.CommissionsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d" Background="White">
    <UserControl.Resources>
        <Style x:Key="TabItemStyle" TargetType="ListBoxItem">
            <Setter Property="Padding" Value="12,8"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Style.Triggers>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="#E65100"/>
                    <Setter Property="Foreground" Value="White"/>
                    <Setter Property="FontWeight" Value="Bold"/>
                </Trigger>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#FFE0B2"/>
                </Trigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="220"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        <Border Grid.Column="0" Background="#FFF8F0" CornerRadius="4" Margin="0,0,10,0" Padding="10">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <TextBlock Grid.Row="0" Text="COMISIONES 10%" FontWeight="Bold" FontSize="13" Foreground="#E65100" HorizontalAlignment="Center" Margin="0,0,0,8"/>
                <ListBox Grid.Row="1" ItemsSource="{Binding pending_months}" SelectedItem="{Binding selected_month}"
                         Background="Transparent" BorderThickness="0" ItemContainerStyle="{StaticResource TabItemStyle}">
                    <ListBox.ItemTemplate><DataTemplate><TextBlock Text="{Binding}"/></DataTemplate></ListBox.ItemTemplate>
                </ListBox>
                <TextBlock Grid.Row="2" Text="VENDEDORES" FontWeight="Bold" FontSize="11" Margin="0,8,0,5" Foreground="#888"/>
                <ListBox Grid.Row="3" ItemsSource="{Binding sellers}" Background="Transparent" BorderThickness="0"
                         ItemContainerStyle="{StaticResource TabItemStyle}" DisplayMemberPath="full_name"/>
            </Grid>
        </Border>
        <Border Grid.Column="1" BorderBrush="#E65100" BorderThickness="2" Padding="10" Background="White" CornerRadius="4">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <TextBlock Grid.Row="0" Text="COMISIONES DE VENDEDORES" FontWeight="Bold" FontSize="15" Foreground="#E65100" HorizontalAlignment="Center" Margin="0,0,0,8"/>

                <DataGrid Grid.Row="1" ItemsSource="{Binding commissions}" AutoGenerateColumns="False"
                          AlternatingRowBackground="#FFF3E0" RowBackground="White"
                          CanUserAddRows="False" GridLinesVisibility="All"
                          HorizontalGridLinesBrush="#FFCC80" VerticalGridLinesBrush="#FFCC80"
                          BorderBrush="#E65100" BorderThickness="1" FontSize="13" RowHeight="38">
                    <DataGrid.Resources>
                        <Style TargetType="DataGridColumnHeader">
                            <Setter Property="Background" Value="#E65100"/>
                            <Setter Property="Foreground" Value="White"/>
                            <Setter Property="FontWeight" Value="Bold"/>
                            <Setter Property="FontSize" Value="12"/>
                            <Setter Property="Height" Value="32"/>
                            <Setter Property="HorizontalContentAlignment" Value="Center"/>
                        </Style>
                        <Style TargetType="DataGridCell">
                            <Setter Property="VerticalAlignment" Value="Center"/>
                            <Setter Property="Padding" Value="4,2"/>
                        </Style>
                    </DataGrid.Resources>
                    <DataGrid.Columns>
                        <DataGridCheckBoxColumn Header="SEL" Width="45" IsReadOnly="False"
                                                Binding="{Binding is_selected, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}"/>
                        <DataGridTextColumn Header="NOTA" Binding="{Binding note_number}" Width="85" IsReadOnly="True">
                            <DataGridTextColumn.ElementStyle><Style TargetType="TextBlock"><Setter Property="HorizontalAlignment" Value="Center"/></Style></DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>
                        <DataGridTextColumn Header="VENDEDOR" Binding="{Binding seller_name}" Width="110" IsReadOnly="True"/>
                        <DataGridTextColumn Header="CLIENTE" Binding="{Binding customer_name}" Width="*" IsReadOnly="True"/>
                        <DataGridTextColumn Header="VENTA USD" Binding="{Binding amount_usd, StringFormat={}{0:N2}}" Width="95" IsReadOnly="True">
                            <DataGridTextColumn.ElementStyle><Style TargetType="TextBlock"><Setter Property="HorizontalAlignment" Value="Right"/></Style></DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>
                        <DataGridTextColumn Header="COMISION" Binding="{Binding amount_usd, StringFormat={}{0:N2}}" Width="95" IsReadOnly="True">
                            <DataGridTextColumn.ElementStyle><Style TargetType="TextBlock"><Setter Property="FontWeight" Value="Bold"/><Setter Property="Foreground" Value="#E65100"/><Setter Property="HorizontalAlignment" Value="Right"/></Style></DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>
                        <DataGridTextColumn Header="ESTADO" Width="75" IsReadOnly="True">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="HorizontalAlignment" Value="Center"/>
                                    <Setter Property="FontWeight" Value="Bold"/>
                                    <Setter Property="Text" Value="Pendiente"/>
                                    <Setter Property="Foreground" Value="#E65100"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding is_paid}" Value="True">
                                            <Setter Property="Text" Value="Pagada"/>
                                            <Setter Property="Foreground" Value="#2E7D32"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>
                    </DataGrid.Columns>
                </DataGrid>

                <Border Grid.Row="2" Background="#FFF3E0" BorderBrush="#E65100" BorderThickness="1" Margin="0,8,0,0" Padding="8,10" CornerRadius="4">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="PENDIENTE:" FontWeight="Bold" FontSize="13" Foreground="#E65100"/>
                        <TextBlock Grid.Column="1" Text="{Binding total_pending_usd, StringFormat={}{0:N2} USD}" FontWeight="Bold" FontSize="15" Foreground="#E65100" Margin="15,0"/>
                        <TextBlock Grid.Column="2" Text="PAGADO:" FontWeight="Bold" FontSize="13" Foreground="#2E7D32" Margin="20,0,0,0"/>
                        <TextBlock Grid.Column="3" Text="{Binding total_paid_usd, StringFormat={}{0:N2} USD}" FontWeight="Bold" FontSize="15" Foreground="#2E7D32" Margin="15,0"/>
                    </Grid>
                </Border>

                <Border Grid.Row="3" Background="#E65100" BorderBrush="#BF360C" BorderThickness="1" Margin="0,8,0,0" Padding="8,10" CornerRadius="4">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="Tasa BS/USD:" FontWeight="Bold" Foreground="White" VerticalAlignment="Center"/>
                        <TextBox Grid.Column="1" Text="{Binding exchange_rate, UpdateSourceTrigger=PropertyChanged}" Height="28" VerticalContentAlignment="Center" Margin="5,0,12,0"/>
                        <TextBlock Grid.Column="2" Text="Tipo:" FontWeight="Bold" Foreground="White" VerticalAlignment="Center"/>
                        <ComboBox Grid.Column="3" Height="28" VerticalContentAlignment="Center" Margin="5,0,12,0">
                            <ComboBoxItem Content="Transferencia" IsSelected="True"/>
                            <ComboBoxItem Content="Pago Movil"/>
                        </ComboBox>
                        <TextBlock Grid.Column="4" Text="Referencia:" FontWeight="Bold" Foreground="White" VerticalAlignment="Center"/>
                        <TextBox Grid.Column="5" Text="{Binding reference_number, UpdateSourceTrigger=PropertyChanged}" Height="28" VerticalContentAlignment="Center" Margin="5,0,12,0"/>
                        <Button Grid.Column="6" Content="LIQUIDAR" Command="{Binding pay_commission_command}"
                                Background="#FF9800" Foreground="White" FontWeight="Bold" FontSize="12"
                                Padding="15,6" BorderThickness="0" Cursor="Hand"/>
                    </Grid>
                </Border>
            </Grid>
        </Border>
    </Grid>
</UserControl>
