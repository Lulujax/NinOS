<UserControl x:Class="NinOS.UI.Views.RelacionVesuprontaView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:NinOS.UI.Controls"
             Background="White">
    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <WrapPanel Grid.Row="0" Margin="0,0,0,10" VerticalAlignment="Center">
            <controls:RangoFechasPicker Rango="{Binding rango_filtro, Mode=TwoWay}" Margin="0,0,14,0"/>
            <Button Content="👁️ Vista Previa" Style="{StaticResource ToolbarReportPreviewButton}" Height="30" MinWidth="120" Margin="0,0,6,0"
                    Command="{Binding preview_command}"/>
            <Button Content="🖨️ Imprimir" Style="{StaticResource ToolbarPrintButton}" Height="30" MinWidth="110" Margin="0,0,6,0"
                    Command="{Binding print_command}"/>
            <Button Content="📄 PDF" Style="{StaticResource ToolbarPdfButton}" Height="30" MinWidth="90" Margin="0,0,6,0"
                    Command="{Binding pdf_command}"/>
            <Button Content="📊 Excel" Style="{StaticResource ToolbarExcelButton}" Height="30" MinWidth="100"
                    Command="{Binding excel_command}"/>
        </WrapPanel>

        <Grid Grid.Row="1">
            <DataGrid ItemsSource="{Binding filas}" AutoGenerateColumns="False" IsReadOnly="True"
                      CanUserAddRows="False" CanUserDeleteRows="False" HeadersVisibility="Column"
                      GridLinesVisibility="All" HorizontalGridLinesBrush="Black" VerticalGridLinesBrush="Black"
                      BorderBrush="Black" BorderThickness="1" AlternatingRowBackground="#F3E5F5"
                      ColumnHeaderHeight="36">
                <DataGrid.ColumnHeaderStyle>
                    <Style TargetType="DataGridColumnHeader">
                        <Setter Property="Background" Value="#4A148C"/>
                        <Setter Property="Foreground" Value="White"/>
                        <Setter Property="FontWeight" Value="Bold"/>
                        <Setter Property="HorizontalContentAlignment" Value="Center"/>
                        <Setter Property="VerticalContentAlignment" Value="Center"/>
                        <Setter Property="Padding" Value="4,4"/>
                        <Setter Property="ContentTemplate">
                            <Setter.Value>
                                <DataTemplate>
                                    <TextBlock Text="{Binding}" TextWrapping="Wrap" TextAlignment="Center"/>
                                </DataTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </DataGrid.ColumnHeaderStyle>
                <DataGrid.Columns>
                    <DataGridTextColumn Header="FECHA DE DESPACHO" Binding="{Binding despacho_texto}" Width="Auto">
                        <DataGridTextColumn.ElementStyle>
                            <Style TargetType="TextBlock">
                                <Setter Property="HorizontalAlignment" Value="Center"/>
                            </Style>
                        </DataGridTextColumn.ElementStyle>
                    </DataGridTextColumn>
                    <DataGridTextColumn Header="NRO" Binding="{Binding nro}" Width="Auto" MinWidth="120" FontWeight="SemiBold">
                        <DataGridTextColumn.ElementStyle>
                            <Style TargetType="TextBlock">
                                <Setter Property="TextWrapping" Value="Wrap"/>
                                <Setter Property="VerticalAlignment" Value="Center"/>
                            </Style>
                        </DataGridTextColumn.ElementStyle>
                    </DataGridTextColumn>
                    <DataGridTextColumn Header="CLIENTE" Binding="{Binding cliente}" Width="2*">
                        <DataGridTextColumn.ElementStyle>
                            <Style TargetType="TextBlock">
                                <Setter Property="TextWrapping" Value="Wrap"/>
                                <Setter Property="VerticalAlignment" Value="Center"/>
                            </Style>
                        </DataGridTextColumn.ElementStyle>
                    </DataGridTextColumn>
                    <DataGridTextColumn Header="MONTO FACTURADO" Binding="{Binding monto_facturado_texto}" Width="Auto">
                        <DataGridTextColumn.ElementStyle>
                            <Style TargetType="TextBlock">
                                <Setter Property="TextAlignment" Value="Right"/>
                            </Style>
                        </DataGridTextColumn.ElementStyle>
                    </DataGridTextColumn>
                    <DataGridTextColumn Header="DESCUENTO" Binding="{Binding descuento_texto}" Width="Auto">
                        <DataGridTextColumn.ElementStyle>
                            <Style TargetType="TextBlock">
                                <Setter Property="HorizontalAlignment" Value="Center"/>
                            </Style>
                        </DataGridTextColumn.ElementStyle>
                    </DataGridTextColumn>
                    <DataGridTextColumn Header="FECHA DE PAGO" Binding="{Binding fecha_pago_texto}" Width="Auto">
                        <DataGridTextColumn.ElementStyle>
                            <Style TargetType="TextBlock">
                                <Setter Property="HorizontalAlignment" Value="Center"/>
                            </Style>
                        </DataGridTextColumn.ElementStyle>
                    </DataGridTextColumn>
                    <DataGridTextColumn Header="MONTO PAGADO" Binding="{Binding monto_pagado_texto}" Width="Auto">
                        <DataGridTextColumn.ElementStyle>
                            <Style TargetType="TextBlock">
                                <Setter Property="TextAlignment" Value="Right"/>
                            </Style>
                        </DataGridTextColumn.ElementStyle>
                    </DataGridTextColumn>
                    <DataGridTextColumn Header="10% COMISION" Binding="{Binding comision_texto}" Width="Auto">
                        <DataGridTextColumn.ElementStyle>
                            <Style TargetType="TextBlock">
                                <Setter Property="TextAlignment" Value="Right"/>
                            </Style>
                        </DataGridTextColumn.ElementStyle>
                    </DataGridTextColumn>
                    <DataGridTextColumn Header="SALDO ACTUALIZADO" Binding="{Binding saldo_actualizado_texto}" Width="Auto" FontWeight="Bold">
                        <DataGridTextColumn.ElementStyle>
                            <Style TargetType="TextBlock">
                                <Setter Property="TextAlignment" Value="Right"/>
                            </Style>
                        </DataGridTextColumn.ElementStyle>
                    </DataGridTextColumn>
                    <DataGridTextColumn Header="FECHA COMISION CANCELADA" Binding="{Binding fecha_comision_texto}" Width="Auto" MinWidth="130">
                        <DataGridTextColumn.ElementStyle>
                            <Style TargetType="TextBlock">
                                <Setter Property="TextWrapping" Value="Wrap"/>
                                <Setter Property="HorizontalAlignment" Value="Center"/>
                            </Style>
                        </DataGridTextColumn.ElementStyle>
                    </DataGridTextColumn>
                </DataGrid.Columns>
            </DataGrid>
            <TextBlock Text="{Binding estado_texto}" Foreground="#555555" FontSize="13"
                       HorizontalAlignment="Center" VerticalAlignment="Center" TextWrapping="Wrap"/>
        </Grid>

        <Grid Grid.Row="2" Margin="0,10,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="16" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Border Grid.Column="0" BorderBrush="#4A148C" BorderThickness="1" Background="#F3E5F5" Padding="12,8">
                <StackPanel>
                    <TextBlock Text="{Binding etiqueta_total_ventas}" FontWeight="Bold" Foreground="#4A148C"/>
                    <TextBlock Text="{Binding total_ventas_texto}" FontSize="18" FontWeight="Bold" Foreground="#4A148C"
                               HorizontalAlignment="Right"/>
                </StackPanel>
            </Border>
            <Border Grid.Column="2" BorderBrush="#C62828" BorderThickness="1" Background="#FFEBEE" Padding="12,8">
                <StackPanel>
                    <TextBlock Text="TOTAL POR COBRAR" FontWeight="Bold" Foreground="#C62828"/>
                    <TextBlock Text="{Binding total_por_cobrar_texto}" FontSize="18" FontWeight="Bold" Foreground="#C62828"
                               HorizontalAlignment="Right"/>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</UserControl>
