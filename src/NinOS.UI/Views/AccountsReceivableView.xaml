<UserControl x:Class="NinOS.UI.Views.AccountsReceivableView"

             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"

             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"

             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"

             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:common="clr-namespace:NinOS.UI.Common"

             mc:Ignorable="d" Background="White">

    <UserControl.Resources>

        <Style x:Key="CompactDataGrid" TargetType="DataGrid">

            <Setter Property="AutoGenerateColumns" Value="False"/>

            <Setter Property="IsReadOnly" Value="True"/>

            <Setter Property="GridLinesVisibility" Value="Horizontal"/>

            <Setter Property="HeadersVisibility" Value="Column"/>

            <Setter Property="BorderThickness" Value="1"/>

            <Setter Property="BorderBrush" Value="#E0E0E0"/>

            <Setter Property="Background" Value="White"/>

            <Setter Property="RowHeaderWidth" Value="0"/>

            <Setter Property="CanUserAddRows" Value="False"/>

            <Setter Property="CanUserDeleteRows" Value="False"/>

            <Setter Property="CanUserReorderColumns" Value="False"/>

            <Setter Property="CanUserResizeColumns" Value="False"/>

            <Setter Property="SelectionMode" Value="Single"/>

            <Setter Property="EnableRowVirtualization" Value="True"/>

            <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Auto"/>

            <Setter Property="FontSize" Value="11"/>

            <Setter Property="MinRowHeight" Value="20"/>

        </Style>

        <Style x:Key="CellText" TargetType="TextBlock">

            <Setter Property="FontWeight" Value="Bold"/>

            <Setter Property="VerticalAlignment" Value="Center"/>

            <Setter Property="TextTrimming" Value="CharacterEllipsis"/>

        </Style>

        <Style x:Key="CellTextCenter" TargetType="TextBlock" BasedOn="{StaticResource CellText}">

            <Setter Property="HorizontalAlignment" Value="Center"/>

            <Setter Property="TextAlignment" Value="Center"/>

        </Style>

        <Style x:Key="CellTextWrap" TargetType="TextBlock" BasedOn="{StaticResource CellText}">

            <Setter Property="TextWrapping" Value="Wrap"/>

            <Setter Property="TextTrimming" Value="None"/>

        </Style>

        



        <DataTemplate x:Key="MontoCellTemplate">

            <Grid>

                <TextBlock Text="{Binding total_amount_usd, StringFormat=N2}" VerticalAlignment="Center">

                    <TextBlock.Style>

                        <Style TargetType="TextBlock" BasedOn="{StaticResource CellTextCenter}">

                            <Style.Triggers>

                                <DataTrigger Binding="{Binding is_editing}" Value="True">

                                    <Setter Property="Visibility" Value="Collapsed"/>

                                </DataTrigger>

                            </Style.Triggers>

                        </Style>

                    </TextBlock.Style>

                </TextBlock>

                <TextBox Text="{Binding edit_monto_text, UpdateSourceTrigger=PropertyChanged}" Height="22"

                         FontSize="12.5" TextAlignment="Center" Padding="2,1" VerticalContentAlignment="Center">

                    <TextBox.Style>

                        <Style TargetType="TextBox">

                            <Setter Property="Visibility" Value="Collapsed"/>

                            <Style.Triggers>

                                <DataTrigger Binding="{Binding is_editing}" Value="True">

                                    <Setter Property="Visibility" Value="Visible"/>

                                </DataTrigger>

                            </Style.Triggers>

                        </Style>

                    </TextBox.Style>

                </TextBox>

            </Grid>

        </DataTemplate>



        <DataTemplate x:Key="DctoCellTemplate">

            <Grid>

                <TextBlock Text="{Binding discount_percentage_text}" VerticalAlignment="Center">

                    <TextBlock.Style>

                        <Style TargetType="TextBlock" BasedOn="{StaticResource CellTextCenter}">

                            <Style.Triggers>

                                <DataTrigger Binding="{Binding is_editing}" Value="True">

                                    <Setter Property="Visibility" Value="Collapsed"/>

                                </DataTrigger>

                            </Style.Triggers>

                        </Style>

                    </TextBlock.Style>

                </TextBlock>

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">

                    <StackPanel.Style>

                        <Style TargetType="StackPanel">

                            <Setter Property="Visibility" Value="Collapsed"/>

                            <Style.Triggers>

                                <DataTrigger Binding="{Binding is_editing}" Value="True">

                                    <Setter Property="Visibility" Value="Visible"/>

                                </DataTrigger>

                            </Style.Triggers>

                        </Style>

                    </StackPanel.Style>

                    <TextBox Text="{Binding edit_dcto_text, UpdateSourceTrigger=PropertyChanged}" Width="40" Height="22"

                             FontSize="12.5" TextAlignment="Center" Padding="2,1" VerticalContentAlignment="Center"/>

                    <TextBlock Text="%" FontSize="11.5" VerticalAlignment="Center" Margin="2,0,0,0" Foreground="#424242"/>

                </StackPanel>

            </Grid>

        </DataTemplate>



        <DataTemplate x:Key="ActionsCellTemplate">
            <Grid>
                <!-- Modo Normal: botones de acción -->
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                    <StackPanel.Style>
                        <Style TargetType="StackPanel">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding is_editing}" Value="True">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </StackPanel.Style>

                    <!-- Vista Previa -->
                    <Button Content="👁️" Style="{StaticResource GridRowBadgePreview}"
                            ToolTip="Vista previa de la nota"
                            Command="{Binding DataContext.preview_note_command, RelativeSource={RelativeSource AncestorType=UserControl}}"
                            CommandParameter="{Binding}"/>

                    <!-- Exportar unificado (PDF / Excel) -->
                    <Button Content="📥 ▾" Style="{StaticResource GridRowBadgeExport}"
                            ToolTip="Exportar nota (PDF o Excel)"
                            common:DropdownMenuHelper.IsOpenOnClick="True"
                            Tag="{Binding DataContext, RelativeSource={RelativeSource AncestorType=UserControl}}">
                        <Button.ContextMenu>
                            <ContextMenu Style="{StaticResource StandardDropdownContextMenu}">
                                <MenuItem Header="📄 Descargar PDF"
                                          Style="{StaticResource StandardDropdownMenuItem}"
                                          Command="{Binding PlacementTarget.Tag.print_pdf_command, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                          CommandParameter="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}"/>
                                <MenuItem Header="📊 Exportar a Excel"
                                          Style="{StaticResource StandardDropdownMenuItem}"
                                          Command="{Binding PlacementTarget.Tag.export_note_excel_command, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                          CommandParameter="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}"/>
                            </ContextMenu>
                        </Button.ContextMenu>
                    </Button>

                    <!-- Editar -->
                    <Button Content="Editar" ToolTip="Editar monto o descuento"
                            Command="{Binding DataContext.start_edit_command, RelativeSource={RelativeSource AncestorType=UserControl}}"
                            CommandParameter="{Binding}">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource GridRowBadgeEdit}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding status}" Value="Anulada">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding status}" Value="Pagada">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding status}" Value="Devuelta">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>

                    <!-- Registrar Pago -->
                    <Button Content="Pago" ToolTip="Registrar abono o pago"
                            Command="{Binding DataContext.request_payment_command, RelativeSource={RelativeSource AncestorType=UserControl}}"
                            CommandParameter="{Binding}">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource GridRowBadgeSuccess}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding status}" Value="Anulada">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding status}" Value="Pagada">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding status}" Value="Devuelta">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>

                    <!-- Anular -->
                    <Button Content="Anular" ToolTip="Anular nota"
                            Command="{Binding DataContext.annul_note_command, RelativeSource={RelativeSource AncestorType=UserControl}}"
                            CommandParameter="{Binding}">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource GridRowBadgeDanger}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding status}" Value="Anulada">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding status}" Value="Pagada">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding status}" Value="Devuelta">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>
                </StackPanel>

                <!-- Modo Edición Rápida: Guardar / Cancelar -->
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                    <StackPanel.Style>
                        <Style TargetType="StackPanel">
                            <Setter Property="Visibility" Value="Collapsed"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding is_editing}" Value="True">
                                    <Setter Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </StackPanel.Style>
                    <Button Content="&#x2714;" Style="{StaticResource GridRowBadgeSave}" ToolTip="Guardar cambios"
                            Command="{Binding DataContext.apply_edit_command, RelativeSource={RelativeSource AncestorType=UserControl}}"
                            CommandParameter="{Binding}"/>
                    <Button Content="&#x2715;" Style="{StaticResource GridRowBadgeCancel}" ToolTip="Cancelar edición"
                            Command="{Binding DataContext.cancel_edit_command, RelativeSource={RelativeSource AncestorType=UserControl}}"
                            CommandParameter="{Binding}"/>
                </StackPanel>
            </Grid>
        </DataTemplate>

        <Style x:Key="RedComboBox" TargetType="ComboBox">

            <Setter Property="Height" Value="26"/>

            <Setter Property="FontSize" Value="11"/>

            <Setter Property="FontWeight" Value="SemiBold"/>

            <Setter Property="Foreground" Value="White"/>

            <Setter Property="HorizontalContentAlignment" Value="Center"/>

            <Setter Property="Template">

                <Setter.Value>

                    <ControlTemplate TargetType="ComboBox">

                        <Grid>

                            <ToggleButton x:Name="ToggleButton" Focusable="False" ClickMode="Press"

                                          IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}">

                                <ToggleButton.Template>

                                    <ControlTemplate TargetType="ToggleButton">

                                        <Border x:Name="bd" Background="#D32F2F" BorderBrush="#B71C1C"

                                                BorderThickness="1" CornerRadius="3" Padding="8,0">

                                            <ContentPresenter/>

                                        </Border>

                                        <ControlTemplate.Triggers>

                                            <Trigger Property="IsMouseOver" Value="True">

                                                <Setter TargetName="bd" Property="Background" Value="#E53935"/>

                                            </Trigger>

                                            <Trigger Property="IsChecked" Value="True">

                                                <Setter TargetName="bd" Property="Background" Value="#C62828"/>

                                            </Trigger>

                                        </ControlTemplate.Triggers>

                                    </ControlTemplate>

                                </ToggleButton.Template>

                            </ToggleButton>

                            <ContentPresenter x:Name="ContentSite" Margin="8,0,20,0" VerticalAlignment="Center"

                                              HorizontalAlignment="Center" IsHitTestVisible="False"

                                              Content="{TemplateBinding SelectionBoxItem}"

                                              ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"/>

                            <Path x:Name="Arrow" Data="M 0 0 L 8 0 L 4 5 Z" Fill="White"

                                  HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,8,0" IsHitTestVisible="False"/>

                            <Popup IsOpen="{TemplateBinding IsDropDownOpen}" Placement="Bottom" AllowsTransparency="True"

                                   Focusable="False" PopupAnimation="Slide">

                                <Border MinWidth="{Binding ActualWidth, ElementName=ContentSite}"

                                        MaxHeight="{TemplateBinding MaxDropDownHeight}"

                                        Background="White" BorderBrush="#B71C1C" BorderThickness="1" CornerRadius="3">

                                    <ScrollViewer>

                                        <ItemsPresenter/>

                                    </ScrollViewer>

                                </Border>

                            </Popup>

                        </Grid>

                    </ControlTemplate>

                </Setter.Value>

            </Setter>

        </Style>

    </UserControl.Resources>

    <Grid Margin="6">

        <Grid.RowDefinitions>

            <RowDefinition Height="Auto"/>

            <RowDefinition Height="*"/>

            <RowDefinition Height="Auto"/>

            <RowDefinition Height="Auto"/>

        </Grid.RowDefinitions>



        <!-- FILA 0: HEADER - titulo + busqueda + mes + boton -->

        <WrapPanel Grid.Row="0" Margin="0,0,0,6">



            <TextBlock Text="CUENTAS POR COBRAR" FontSize="16.5" FontWeight="Bold"

                       Foreground="#D32F2F" VerticalAlignment="Center" Margin="0,0,12,6"/>



            <!-- Busqueda -->

            <Grid Width="260" Margin="0,0,8,6" VerticalAlignment="Center">

                <Border Background="White" CornerRadius="4" BorderBrush="#E0E0E0" BorderThickness="1">

                    <Grid>

                        <TextBlock Text="&#x1F50D;" Margin="8,0,0,0" VerticalAlignment="Center" FontSize="13.5" Foreground="#9E9E9E"/>

                        <TextBox x:Name="txt_search" Margin="26,2,22,2" BorderThickness="0" Background="Transparent"

                                 VerticalContentAlignment="Center" FontSize="12.5"

                                 Text="{Binding search_query, UpdateSourceTrigger=PropertyChanged}"

                                 TextChanged="txt_search_TextChanged"/>

                        <Button x:Name="btn_clear_search" Content="&#x2715;" Margin="0,0,4,0"

                                HorizontalAlignment="Right" Width="20" Height="20"

                                Cursor="Hand" Visibility="Collapsed" Click="btn_clear_search_Click">

                            <Button.Template>

                                <ControlTemplate TargetType="Button">

                                    <Border Background="Transparent" Padding="2">

                                        <TextBlock Text="{TemplateBinding Content}" FontSize="10.5" Foreground="#9E9E9E"

                                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>

                                    </Border>

                                </ControlTemplate>

                            </Button.Template>

                        </Button>

                    </Grid>

                </Border>

            </Grid>



            <!-- Año + Mes + Filtro -->

                <TextBlock VerticalAlignment="Center" FontSize="12.5" FontWeight="SemiBold" Margin="0,0,6,6"><Run Text="Año:"/><Run Text="*" Foreground="#F44336"/></TextBlock>

                <ComboBox x:Name="cmb_year" Margin="0,0,8,6" MinWidth="75" VerticalAlignment="Center"

                          ItemsSource="{Binding available_years}"

                          SelectedItem="{Binding selected_year}"

                          FontSize="12.5" Height="26"

                          HorizontalContentAlignment="Center"/>



                <TextBlock VerticalAlignment="Center" FontSize="12.5" FontWeight="SemiBold" Margin="0,0,6,6"><Run Text="Mes:"/><Run Text="*" Foreground="#F44336"/></TextBlock>

                <ComboBox x:Name="cmb_month" Margin="0,0,8,6" MinWidth="105"

                          ItemsSource="{Binding available_months}"

                          SelectedItem="{Binding selected_month}"

                          FontSize="12.5" Height="26" VerticalAlignment="Center"

                          HorizontalContentAlignment="Center"/>



                <ComboBox Width="110" Margin="0,0,8,6" VerticalAlignment="Center" Style="{StaticResource RedComboBox}"

                          ItemsSource="{Binding filter_options}"

                          SelectedItem="{Binding selected_filter}"

                          HorizontalContentAlignment="Center">

                    <ComboBox.ItemContainerStyle>

                        <Style TargetType="ComboBoxItem">

                            <Setter Property="Foreground" Value="#212121"/>

                            <Setter Property="FontWeight" Value="Normal"/>

                            <Setter Property="Padding" Value="6,3"/>

                            <Style.Triggers>

                                <Trigger Property="IsSelected" Value="True">

                                    <Setter Property="Background" Value="#FFCDD2"/>

                                    <Setter Property="Foreground" Value="#B71C1C"/>

                                    <Setter Property="FontWeight" Value="Bold"/>

                                </Trigger>

                            </Style.Triggers>

                        </Style>

                    </ComboBox.ItemContainerStyle>

                </ComboBox>



                <Button Content="Registrar pago" Style="{StaticResource ToolbarPrimaryDangerButton}"
                        Margin="0,0,8,6" VerticalAlignment="Center"
                        Command="{Binding add_payment_command}"/>



<Button x:Name="btn_reporte" Content="Reporte" Style="{StaticResource ToolbarReportPreviewButton}"
                    VerticalAlignment="Center" Margin="0,0,0,6"
                    ToolTip="Reporte de cuentas por cobrar"
                    Click="on_reporte_click"/>

        </WrapPanel>



        <!-- POPUP: CONFIGURADOR DE REPORTE DE CUENTAS POR COBRAR -->

        <Popup x:Name="popup_reporte"

               PlacementTarget="{Binding ElementName=btn_reporte}"

               Placement="Bottom"

               StaysOpen="False"

               AllowsTransparency="True"

               PopupAnimation="Fade">

            <Border x:Name="panel_reporte"

                    Background="White" BorderBrush="#C9D3C7" BorderThickness="1" CornerRadius="5"

                    Padding="14,12" Width="330">

                <Border.Effect>

                    <DropShadowEffect BlurRadius="12" Direction="270" ShadowDepth="4" Opacity="0.18" Color="#000000"/>

                </Border.Effect>

                <StackPanel>

                    <TextBlock Text="REPORTE DE CUENTAS POR COBRAR" FontSize="11.5" FontWeight="Bold"

                               Foreground="#1B3A2D"/>

                    <TextBlock Text="Solo entran notas pendientes de cobro. Las pagadas, anuladas y devueltas no suman ni aparecen."

                               FontSize="9.5" Foreground="#7A8A80" TextWrapping="Wrap" Margin="0,2,0,8"/>



                    <!-- PERIODO / CRITERIO DEL REPORTE -->
                    <TextBlock Text="CRITERIO DEL REPORTE" FontSize="9.5" FontWeight="Bold" Foreground="#55665C" Margin="0,0,0,3"/>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                        <RadioButton Content="Mes" GroupName="cxc_periodo" x:Name="rbtn_periodo_mes"
                                     Checked="on_periodo_mes_checked"
                                     FontSize="11.5" Foreground="#333333" Margin="0,0,12,0" Cursor="Hand" IsChecked="True"/>
                        <RadioButton Content="Año" GroupName="cxc_periodo" x:Name="rbtn_periodo_anio"
                                     Checked="on_periodo_anio_checked"
                                     FontSize="11.5" Foreground="#333333" Margin="0,0,12,0" Cursor="Hand"/>
                        <RadioButton Content="Por Zona" GroupName="cxc_periodo" x:Name="rbtn_periodo_zona"
                                     Checked="on_periodo_zona_checked"
                                     FontSize="11.5" FontWeight="Bold" Foreground="#1B3A2D" Cursor="Hand"/>
                    </StackPanel>

                    <StackPanel x:Name="panel_periodo_mes">
                        <ComboBox ItemsSource="{Binding pending_months}"
                                  SelectedItem="{Binding selected_month}"
                                  FontSize="11.5" Height="25" Cursor="Hand"/>
                    </StackPanel>

                    <StackPanel x:Name="panel_periodo_anio" Visibility="Collapsed">
                        <ComboBox ItemsSource="{Binding pending_years}"
                                  SelectedItem="{Binding selected_report_year}"
                                  FontSize="11.5" Height="25" Cursor="Hand"/>
                    </StackPanel>

                    <!-- PANEL EN CASCADA CUANDO SE ELIGE POR ZONA -->
                    <Border x:Name="panel_periodo_zona" Visibility="Collapsed" Background="#F1F8F4"
                            BorderBrush="#C8E6C9" BorderThickness="1" CornerRadius="4" Padding="8,6" Margin="0,0,0,4">
                        <StackPanel>
                            <TextBlock Text="PERÍODO POR ZONA" FontSize="9" FontWeight="Bold" Foreground="#1B3A2D" Margin="0,0,0,4"/>
                            <RadioButton Content="Todas a la fecha (Todo en calle)" GroupName="cxc_zona_subperiodo" x:Name="rbtn_zona_sub_todas"
                                         Checked="on_zona_subperiodo_changed" FontSize="11" Margin="0,0,0,3" Cursor="Hand" IsChecked="True"/>
                            <RadioButton Content="Mes en específico" GroupName="cxc_zona_subperiodo" x:Name="rbtn_zona_sub_mes"
                                         Checked="on_zona_subperiodo_changed" FontSize="11" Margin="0,0,0,3" Cursor="Hand"/>
                            <Grid x:Name="panel_zona_selectores_mes" Visibility="Collapsed" Margin="16,2,0,4">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <ComboBox Grid.Column="0" ItemsSource="{Binding pending_years}" SelectedItem="{Binding selected_report_year}" Margin="0,0,4,0" Height="24" FontSize="11"/>
                                <ComboBox Grid.Column="1" ItemsSource="{Binding pending_months}" SelectedItem="{Binding selected_month}" Height="24" FontSize="11"/>
                            </Grid>
                            <RadioButton Content="Año completo" GroupName="cxc_zona_subperiodo" x:Name="rbtn_zona_sub_anio"
                                         Checked="on_zona_subperiodo_changed" FontSize="11" Margin="0,0,0,3" Cursor="Hand"/>
                            <Grid x:Name="panel_zona_selectores_anio" Visibility="Collapsed" Margin="16,2,0,4">
                                <ComboBox ItemsSource="{Binding pending_years}" SelectedItem="{Binding selected_report_year}" Height="24" FontSize="11"/>
                            </Grid>
                            <TextBlock Text="* Agrupa por zona, muestra la columna Vendedor y al final incluye el Resumen General."
                                       FontSize="8.5" FontStyle="Italic" Foreground="#4E6B5A" TextWrapping="Wrap" Margin="0,4,0,0"/>
                        </StackPanel>
                    </Border>

                    <!-- AGRUPAR EN -->
                    <StackPanel x:Name="panel_agrupar_en">
                        <TextBlock Text="AGRUPAR EN (páginas del PDF)" FontSize="9.5" FontWeight="Bold"
                                   Foreground="#55665C" Margin="0,10,0,3"/>
                        <ComboBox ItemsSource="{Binding report_group_options}"
                                  SelectedItem="{Binding selected_report_group, Mode=TwoWay}"
                                  FontSize="11.5" Height="25" Cursor="Hand"/>
                        <TextBlock Text="Por Vendedor: una página por vendedor. Por Zona: una página por zona."
                                   FontSize="9" Foreground="#7A8A80" TextWrapping="Wrap" Margin="0,3,0,0"/>
                    </StackPanel>

                    <!-- ALCANCE -->
                    <Border Background="#F7FAF8" BorderBrush="#E0E8E3" BorderThickness="1" CornerRadius="4"
                            Padding="8,6" Margin="0,10,0,0">
                        <StackPanel>
                            <TextBlock Text="Las listas de vendedores y zonas son el filtro: desmarque lo que no quiera en el reporte."
                                       FontSize="9.5" Foreground="#55665C" TextWrapping="Wrap" Margin="0,0,0,6"/>
                            <StackPanel x:Name="panel_filtro_vendedores">
                                <Grid Margin="0,0,0,4">
                                    <TextBlock Text="VENDEDORES" FontSize="9.5" FontWeight="Bold" Foreground="#1B3A2D" VerticalAlignment="Center"/>
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                        <CheckBox Content="Todos" IsChecked="{Binding all_report_sellers_selected, Mode=TwoWay}"
                                                  FontSize="10.5" FontWeight="SemiBold" Foreground="#333333" Margin="0,0,8,0" Cursor="Hand"/>
                                        <Button Content="Quitar" Background="Transparent" Foreground="#C62828"
                                                FontWeight="SemiBold" FontSize="10.5" BorderThickness="0" Cursor="Hand"
                                                Command="{Binding clear_report_sellers_command}"/>
                                    </StackPanel>
                                </Grid>
                                <ItemsControl ItemsSource="{Binding report_seller_options}">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <WrapPanel/>
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <CheckBox Content="{Binding display_name}" IsChecked="{Binding is_checked, Mode=TwoWay}"
                                                      FontSize="11" Foreground="#333333" Width="105" Margin="2,2,4,2" Cursor="Hand"/>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>



                            <StackPanel Margin="0,6,0,0">

                                <Grid Margin="0,0,0,4">

                                    <TextBlock Text="ZONAS" FontSize="9.5" FontWeight="Bold" Foreground="#1B3A2D" VerticalAlignment="Center"/>

                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">

                                        <CheckBox Content="Todas" IsChecked="{Binding all_report_zones_selected, Mode=TwoWay}"

                                                  FontSize="10.5" FontWeight="SemiBold" Foreground="#333333" Margin="0,0,8,0" Cursor="Hand"/>

                                        <Button Content="Quitar" Background="Transparent" Foreground="#C62828"

                                                FontWeight="SemiBold" FontSize="10.5" BorderThickness="0" Cursor="Hand"

                                                Command="{Binding clear_report_zones_command}"/>

                                    </StackPanel>

                                </Grid>

                                <ItemsControl ItemsSource="{Binding report_zone_options}">

                                    <ItemsControl.ItemsPanel>

                                        <ItemsPanelTemplate>

                                            <WrapPanel/>

                                        </ItemsPanelTemplate>

                                    </ItemsControl.ItemsPanel>

                                    <ItemsControl.ItemTemplate>

                                        <DataTemplate>

                                            <CheckBox Content="{Binding display_name}" IsChecked="{Binding is_checked, Mode=TwoWay}"

                                                      FontSize="11" Foreground="#333333" Width="105" Margin="2,2,4,2" Cursor="Hand"/>

                                        </DataTemplate>

                                    </ItemsControl.ItemTemplate>

                                </ItemsControl>

                            </StackPanel>

                        </StackPanel>

                    </Border>



                    <UniformGrid Columns="2" Rows="2" Margin="0,10,0,0">
                        <Button Content="👁️ Vista Previa" Style="{StaticResource ToolbarReportPreviewButton}"
                                Height="30" Margin="0,0,3,3"
                                Click="on_preview_reporte_click"/>
                        <Button Content="🖨️ Imprimir" Style="{StaticResource ToolbarPrintButton}"
                                Height="30" Margin="3,0,0,3"
                                Click="on_print_reporte_click"/>
                        <Button Content="📄 PDF" Style="{StaticResource ToolbarPdfButton}"
                                Height="30" Margin="0,3,3,0"
                                Click="on_descargar_reporte_click"/>
                        <Button Content="📊 Excel" Style="{StaticResource ToolbarExcelButton}"
                                Height="30" Margin="3,3,0,0"
                                Click="on_excel_reporte_click"/>
                    </UniformGrid>

                </StackPanel>

            </Border>

        </Popup>



        <!-- FILA 1: TABS DE VENDEDORAS -->

        <TabControl Grid.Row="1" ItemsSource="{Binding seller_tabs}" SelectedItem="{Binding selected_tab, Mode=TwoWay}" Margin="0,0,0,4">

            <TabControl.ItemTemplate>

                <DataTemplate>

                    <TextBlock Text="{Binding Header}" FontWeight="SemiBold" FontSize="12.5"/>

                </DataTemplate>

            </TabControl.ItemTemplate>

            <TabControl.ContentTemplate>

                <DataTemplate>

                    <DataGrid Style="{StaticResource CompactDataGrid}" ItemsSource="{Binding Items}"

                              PreviewMouseDoubleClick="DataGrid_PreviewMouseDoubleClick">

                    <DataGrid.Columns>

                        <DataGridTextColumn Header="NRO" Binding="{Binding note_number}" Width="70"

                          ElementStyle="{StaticResource CellTextCenter}"/>

                        <DataGridTemplateColumn Header="DESPACHADO" Width="110">

                            <DataGridTemplateColumn.CellTemplate>

                                <DataTemplate>

                                    <DatePicker SelectedDate="{Binding dispatch_date, Mode=OneWay}" Text=""

                                                SelectedDateChanged="DispatchDatePicker_SelectedDateChanged"

                                                FontSize="11" Height="22" Padding="2,0" Margin="2,0"

                                                HorizontalContentAlignment="Center" VerticalContentAlignment="Center"/>

                                </DataTemplate>

                            </DataGridTemplateColumn.CellTemplate>

                        </DataGridTemplateColumn>

                        <DataGridTextColumn Header="CLIENTE" Binding="{Binding customer_name}" Width="170"

                          ElementStyle="{StaticResource CellTextWrap}"/>

                        <DataGridTextColumn Header="ZONA" Binding="{Binding zone_name}" Width="90"

                          ElementStyle="{StaticResource CellTextCenter}"/>

                        <DataGridTemplateColumn Header="MONTO *" Width="80"

                          CellTemplate="{StaticResource MontoCellTemplate}"/>

                        <DataGridTemplateColumn Header="DCTO" Width="55"

                          CellTemplate="{StaticResource DctoCellTemplate}"/>

                        <DataGridTextColumn Header="ABONADO" Binding="{Binding paid_amount_usd, StringFormat=N2}" Width="80"

                          ElementStyle="{StaticResource CellTextCenter}"/>

                        <DataGridTextColumn Header="SALDO PEND." Binding="{Binding balance_due_usd, StringFormat=N2}" Width="90"

                          ElementStyle="{StaticResource CellTextCenter}"/>

<DataGridTemplateColumn Header="OBSERVACION" Width="170">

                            <DataGridTemplateColumn.CellTemplate>

                                <DataTemplate>

                                    <Grid>

                                        <TextBlock Text="{Binding observations}" ToolTip="{Binding observations}" TextWrapping="Wrap"

                                                   TextTrimming="CharacterEllipsis" VerticalAlignment="Center" Cursor="Hand">

                                            <TextBlock.Style>

                                                <Style TargetType="TextBlock">

                                                    <Style.Triggers>

                                                        <DataTrigger Binding="{Binding is_editing_observations}" Value="True">

                                                            <Setter Property="Visibility" Value="Collapsed"/>

                                                        </DataTrigger>

                                                    </Style.Triggers>

                                                </Style>

                                            </TextBlock.Style>

                                        </TextBlock>

                                        <TextBox Text="{Binding observations, UpdateSourceTrigger=PropertyChanged}" MaxLength="500"

                                                 TextWrapping="Wrap" VerticalAlignment="Center" Background="#FFFDE7"

                                                 KeyDown="ObsTextBox_KeyDown" LostKeyboardFocus="ObsTextBox_LostKeyboardFocus">

                                            <TextBox.Style>

                                                <Style TargetType="TextBox">

                                                    <Setter Property="Visibility" Value="Collapsed"/>

                                                    <Style.Triggers>

                                                        <DataTrigger Binding="{Binding is_editing_observations}" Value="True">

                                                            <Setter Property="Visibility" Value="Visible"/>

                                                        </DataTrigger>

                                                    </Style.Triggers>

                                                </Style>

                                            </TextBox.Style>

                                        </TextBox>

                                    </Grid>

                                </DataTemplate>

                            </DataGridTemplateColumn.CellTemplate>

                        </DataGridTemplateColumn>

                        <DataGridTextColumn Header="ESTADO" Binding="{Binding status}" Width="75">

                        <DataGridTextColumn.ElementStyle>

                            <Style TargetType="TextBlock">

                                <Setter Property="HorizontalAlignment" Value="Center"/>

                                <Setter Property="FontWeight" Value="Bold"/>

                                <Style.Triggers>

                                    <DataTrigger Binding="{Binding status}" Value="Pagada">

                                        <Setter Property="Foreground" Value="#2E7D32"/>

                                    </DataTrigger>

                                    <DataTrigger Binding="{Binding status}" Value="Pendiente">

                                        <Setter Property="Foreground" Value="#F57C00"/>

                                    </DataTrigger>

                                    <DataTrigger Binding="{Binding status}" Value="Anulada">

                                        <Setter Property="Foreground" Value="#9E9E9E"/>

                                        <Setter Property="FontStyle" Value="Italic"/>

                                    </DataTrigger>

                                    <DataTrigger Binding="{Binding status}" Value="Devuelta">

                                        <Setter Property="Foreground" Value="#7B1FA2"/>

                                    </DataTrigger>

                                </Style.Triggers>

                            </Style>

                        </DataGridTextColumn.ElementStyle>

                    </DataGridTextColumn>

                        <DataGridTemplateColumn Header="ACCIONES" Width="Auto" CanUserResize="False">

                            <DataGridTemplateColumn.HeaderStyle>

                                <Style TargetType="DataGridColumnHeader">

                                    <Setter Property="HorizontalContentAlignment" Value="Center"/>

                                </Style>

                            </DataGridTemplateColumn.HeaderStyle>

                            <DataGridTemplateColumn.CellTemplate>

                                <DataTemplate>

                                    <ContentControl Content="{Binding}" ContentTemplate="{StaticResource ActionsCellTemplate}"/>

                                </DataTemplate>

                            </DataGridTemplateColumn.CellTemplate>

                        </DataGridTemplateColumn>

                    </DataGrid.Columns>

                </DataGrid>

            </DataTemplate>

        </TabControl.ContentTemplate>

        </TabControl>



        <!-- FILA 3: FOOTER - 3 totales -->

        <Border Grid.Row="3" Background="#D32F2F" Padding="10,5" CornerRadius="0,0,4,4">

            <Grid>

                <Grid.ColumnDefinitions>

                    <ColumnDefinition Width="*"/>

                    <ColumnDefinition Width="*"/>

                    <ColumnDefinition Width="*"/>

                </Grid.ColumnDefinitions>



                <StackPanel Grid.Column="0" Orientation="Horizontal" HorizontalAlignment="Center">

                    <TextBlock Text="TOTAL FACTURADO: $" Foreground="#FFCDD2" FontSize="12.5" VerticalAlignment="Center"/>

                    <TextBlock Text="{Binding total_invoiced_usd, StringFormat=N2}" Foreground="White" FontSize="14.5"

                               FontWeight="Bold" VerticalAlignment="Center" Margin="4,0,0,0"/>

                </StackPanel>



                <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Center">

                    <TextBlock Text="TOTAL ABONADO: $" Foreground="#FFCDD2" FontSize="12.5" VerticalAlignment="Center"/>

                    <TextBlock Text="{Binding total_paid_usd, StringFormat=N2}" Foreground="White" FontSize="14.5"

                               FontWeight="Bold" VerticalAlignment="Center" Margin="4,0,0,0"/>

                </StackPanel>



                <StackPanel Grid.Column="2" Orientation="Horizontal" HorizontalAlignment="Center">

                    <TextBlock Text="TOTAL POR COBRAR: $" Foreground="#FFCDD2" FontSize="12.5" VerticalAlignment="Center"/>

                    <TextBlock Text="{Binding total_balance_usd, StringFormat=N2}" Foreground="White" FontSize="14.5"

                               FontWeight="Bold" VerticalAlignment="Center" Margin="4,0,0,0"/>

                </StackPanel>

            </Grid>

        </Border>

    </Grid>

</UserControl>

