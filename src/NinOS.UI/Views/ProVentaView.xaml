<UserControl x:Class="NinOS.UI.Views.ProVentaView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="White">
    <UserControl.Resources>
        <Style x:Key="CenterCellStyle" TargetType="TextBlock">
            <Setter Property="TextAlignment" Value="Center"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
        <Style x:Key="ProVentaGrid" TargetType="DataGrid">
            <Setter Property="AutoGenerateColumns" Value="False"/>
            <Setter Property="IsReadOnly" Value="True"/>
            <Setter Property="CanUserAddRows" Value="False"/>
            <Setter Property="CanUserDeleteRows" Value="False"/>
            <Setter Property="GridLinesVisibility" Value="All"/>
            <Setter Property="HorizontalGridLinesBrush" Value="#B0B0B0"/>
            <Setter Property="VerticalGridLinesBrush" Value="#B0B0B0"/>
            <Setter Property="HeadersVisibility" Value="Column"/>
            <Setter Property="RowHeaderWidth" Value="0"/>
            <Setter Property="SelectionMode" Value="Single"/>
            <Setter Property="SelectionUnit" Value="FullRow"/>
            <Setter Property="BorderBrush" Value="#1565C0"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="AlternatingRowBackground" Value="#E3F2FD"/>
            <Setter Property="ColumnHeaderStyle">
                <Setter.Value>
                    <Style TargetType="DataGridColumnHeader">
                        <Setter Property="Background" Value="#1565C0"/>
                        <Setter Property="Foreground" Value="White"/>
                        <Setter Property="FontWeight" Value="Bold"/>
                        <Setter Property="HorizontalContentAlignment" Value="Center"/>
                        <Setter Property="Padding" Value="4"/>
                    </Style>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" BorderBrush="#1565C0" BorderThickness="1" Padding="8" Margin="0,0,0,8" Background="#E3F2FD">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="Relacion Pro Venta:" FontWeight="Bold" VerticalAlignment="Center" Margin="0,0,8,0"/>
                <ComboBox SelectedIndex="{Binding selected_report_index, Mode=TwoWay}" Width="330">
                    <ComboBoxItem Content="Relacion por cobrar - reporte semanal"/>
                    <ComboBoxItem Content="Relacion por cobrar - pendientes"/>
                    <ComboBoxItem Content="Relacion por cobrar - pagadas"/>
                </ComboBox>
            </StackPanel>
        </Border>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto"
                      Visibility="{Binding is_weekly, Converter={StaticResource BooleanToVisibilityConverter}}">
            <StackPanel>
                <Border BorderBrush="#B0B0B0" BorderThickness="1" Padding="8" Margin="0,0,0,10">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="Mes:" FontWeight="Bold" VerticalAlignment="Center" Margin="0,0,6,0"/>
                        <ComboBox ItemsSource="{Binding available_months}" SelectedItem="{Binding selected_month, Mode=TwoWay}"
                                  DisplayMemberPath="label" Width="180" Margin="0,0,20,0"/>
                        <TextBlock Text="Semana:" FontWeight="Bold" VerticalAlignment="Center" Margin="0,0,6,0"/>
                        <ComboBox ItemsSource="{Binding weeks}" SelectedItem="{Binding selected_week, Mode=TwoWay}"
                                  DisplayMemberPath="label" Width="200" Margin="0,0,20,0"/>
                        <Button Content="Imprimir PDF" Command="{Binding print_command}" Background="#1565C0"
                                Foreground="White" FontWeight="Bold" Padding="14,6" Cursor="Hand"/>
                    </StackPanel>
                </Border>

                <TextBlock Text="{Binding relation_title}" FontSize="20" FontWeight="Bold" HorizontalAlignment="Center" Foreground="#1565C0"/>
                <TextBlock Text="{Binding relation_subtitle}" FontSize="12" FontWeight="Bold" HorizontalAlignment="Center"
                           Foreground="#666666" Margin="0,2,0,8"/>

                <TextBlock Text="No hay notas de despacho en esta semana." Foreground="#888888" HorizontalAlignment="Center"
                           Margin="0,20,0,0"
                           Visibility="{Binding is_empty, Converter={StaticResource BooleanToVisibilityConverter}}"/>

                <StackPanel Width="1080" Visibility="{Binding has_rows, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <DataGrid Style="{StaticResource ProVentaGrid}" ItemsSource="{Binding report_rows}">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="NRO NOTA CLIENTE" Binding="{Binding note_number}" Width="1.5*"
                                                ElementStyle="{StaticResource CenterCellStyle}"/>
                            <DataGridTextColumn Header="CLIENTE" Binding="{Binding customer_name}" Width="2.7*"/>
                            <DataGridTextColumn Header="MONTO NOTA" Binding="{Binding amount, StringFormat=N2}" Width="1.05*"
                                                ElementStyle="{StaticResource CenterCellStyle}"/>
                            <DataGridTextColumn Header="COMISION LUIS 10%" Binding="{Binding commission_luis, StringFormat=N2}" Width="1.45*"
                                                ElementStyle="{StaticResource CenterCellStyle}"/>
                            <DataGridTextColumn Header="GASTOS OPERATIVOS 25%" Binding="{Binding gastos_25, StringFormat=N2}" Width="1.35*"
                                                ElementStyle="{StaticResource CenterCellStyle}"/>
                            <DataGridTextColumn Header="GASTOS ADMINISTRATIVOS 15%" Binding="{Binding gastos_15, StringFormat=N2}" Width="1.35*"
                                                ElementStyle="{StaticResource CenterCellStyle}"/>
                            <DataGridTemplateColumn Header="ACCIONES" Width="1.9*">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                            <Button Content="Vista Previa" Padding="6,2" Margin="2" FontSize="9.5" Cursor="Hand"
                                                    Background="#F5F5F5" BorderThickness="1" BorderBrush="#E0E0E0"
                                                    Foreground="#424242"
                                                    Command="{Binding DataContext.note_preview_command, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                    CommandParameter="{Binding}"/>
                                            <Button Content="Imprimir" Padding="6,2" Margin="2" FontSize="9.5" Cursor="Hand"
                                                    Background="#F5F5F5" BorderThickness="1" BorderBrush="#E0E0E0"
                                                    Foreground="#424242"
                                                    Command="{Binding DataContext.note_pdf_command, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                    CommandParameter="{Binding}"/>
                                        </StackPanel>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="1.5*"/>
                            <ColumnDefinition Width="2.7*"/>
                            <ColumnDefinition Width="1.05*"/>
                            <ColumnDefinition Width="1.45*"/>
                            <ColumnDefinition Width="1.35*"/>
                            <ColumnDefinition Width="1.35*"/>
                            <ColumnDefinition Width="1.9*"/>
                        </Grid.ColumnDefinitions>
                        <Border Grid.Column="0" BorderBrush="#1565C0" BorderThickness="1,1,1,1" Background="#E3F2FD" Padding="4">
                            <TextBlock Text="TOTAL" FontWeight="Bold" TextAlignment="Left"/>
                        </Border>
                        <Border Grid.Column="1" BorderBrush="#1565C0" BorderThickness="0,1,1,1" Background="#E3F2FD"/>
                        <Border Grid.Column="2" BorderBrush="#1565C0" BorderThickness="0,1,1,1" Background="#E3F2FD" Padding="4">
                            <TextBlock Text="{Binding total_amount, StringFormat=N2}" FontWeight="Bold" TextAlignment="Center"/>
                        </Border>
                        <Border Grid.Column="3" BorderBrush="#1565C0" BorderThickness="0,1,1,1" Background="#E3F2FD" Padding="4">
                            <TextBlock Text="{Binding total_commission_luis, StringFormat=N2}" FontWeight="Bold" TextAlignment="Center"/>
                        </Border>
                        <Border Grid.Column="4" BorderBrush="#1565C0" BorderThickness="0,1,1,1" Background="#E3F2FD" Padding="4">
                            <TextBlock Text="{Binding total_gastos_25, StringFormat=N2}" FontWeight="Bold" TextAlignment="Center"/>
                        </Border>
                        <Border Grid.Column="5" BorderBrush="#1565C0" BorderThickness="0,1,1,1" Background="#E3F2FD" Padding="4">
                            <TextBlock Text="{Binding total_gastos_15, StringFormat=N2}" FontWeight="Bold" TextAlignment="Center"/>
                        </Border>
                        <Border Grid.Column="6" BorderBrush="#1565C0" BorderThickness="0,1,1,1" Background="#E3F2FD"/>
                    </Grid>
                </StackPanel>

                <Border Width="560" HorizontalAlignment="Center" BorderBrush="#1565C0" BorderThickness="1" Margin="0,14,0,0">
                    <StackPanel>
                        <TextBlock Text="LIQUIDACION" FontWeight="Bold" FontSize="12" Foreground="#1565C0" Padding="6"/>

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="3*"/>
                                <ColumnDefinition Width="1.2*"/>
                            </Grid.ColumnDefinitions>
                            <Border Grid.Column="0" BorderBrush="#B0B0B0" BorderThickness="0,1,1,1" Background="#E3F2FD" Padding="5">
                                <TextBlock Text="TOTAL COBRADO (NOTAS MENOS COMISION LUIS G)" FontWeight="Bold"/>
                            </Border>
                            <Border Grid.Column="1" BorderBrush="#B0B0B0" BorderThickness="0,1,1,1" Background="#E3F2FD" Padding="5">
                                <TextBlock Text="{Binding total_cobrado, StringFormat=N2}" FontWeight="Bold" TextAlignment="Center"/>
                            </Border>
                        </Grid>

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="3*"/>
                                <ColumnDefinition Width="1.2*"/>
                            </Grid.ColumnDefinitions>
                            <Border Grid.Column="0" BorderBrush="#B0B0B0" BorderThickness="0,1,1,1" Background="#FFF2A8" Padding="5">
                                <TextBlock Text="NOTA DE ENTREGA POR PAGAR A PRO VENTA" FontWeight="Bold" VerticalAlignment="Center"/>
                            </Border>
                            <Border Grid.Column="1" BorderBrush="#B0B0B0" BorderThickness="0,1,1,1" Background="#FFF2A8" Padding="5">
                                <TextBlock Text="{Binding nota_por_pagar, StringFormat=N2}" FontWeight="Bold" TextAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                        </Grid>

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="3*"/>
                                <ColumnDefinition Width="1.2*"/>
                            </Grid.ColumnDefinitions>
                            <Border Grid.Column="0" BorderBrush="#B0B0B0" BorderThickness="0,1,1,1" Background="#E3F2FD" Padding="5">
                                <TextBlock Text="DIFERENCIAL" FontWeight="Bold"/>
                            </Border>
                            <Border Grid.Column="1" BorderBrush="#B0B0B0" BorderThickness="0,1,1,1" Background="#E3F2FD" Padding="5">
                                <TextBlock Text="{Binding diferencial, StringFormat=N2}" FontWeight="Bold" TextAlignment="Center"/>
                            </Border>
                        </Grid>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto"
                      Visibility="{Binding is_pending, Converter={StaticResource BooleanToVisibilityConverter}}">
            <StackPanel>
                <TextBlock Text="Relacion por cobrar - pendientes" FontSize="16" FontWeight="Bold" Foreground="#1565C0"/>

                <TextBlock Text="No hay relaciones pendientes por cobrar." Foreground="#888888" HorizontalAlignment="Center"
                           Margin="0,20,0,0"
                           Visibility="{Binding pending_empty, Converter={StaticResource BooleanToVisibilityConverter}}"/>

                <StackPanel Width="900" Visibility="{Binding has_pending, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <DataGrid Style="{StaticResource ProVentaGrid}" ItemsSource="{Binding pending_rows}"
                              MouseDoubleClick="RelationGrid_MouseDoubleClick">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="RELACION NRO" Binding="{Binding relation_label}" Width="1.2*"
                                                ElementStyle="{StaticResource CenterCellStyle}"/>
                            <DataGridTextColumn Header="MONTO POR PAGAR" Binding="{Binding amount, StringFormat=N2}" Width="1*"
                                                ElementStyle="{StaticResource CenterCellStyle}"/>
                            <DataGridTextColumn Header="SALDO COMPLETO" Binding="{Binding balance_due_usd, StringFormat=N2}" Width="1*"
                                                ElementStyle="{StaticResource CenterCellStyle}"/>
                            <DataGridTextColumn Header="ESTADO" Binding="{Binding status}" Width="0.9*"
                                                ElementStyle="{StaticResource CenterCellStyle}"/>
                            <DataGridTemplateColumn Header="ACCIONES" Width="2.2*">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                            <Button Content="PDF" Padding="6,2" Margin="2" FontSize="10"
                                                    Cursor="Hand" Background="#F5F5F5" BorderThickness="1"
                                                    BorderBrush="#E0E0E0" Foreground="#424242"
                                                    Command="{Binding DataContext.relation_pdf_command, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                    CommandParameter="{Binding}"/>
                                            <Button Content="Abonar / Pagar" Padding="6,2" Margin="2" FontSize="10"
                                                    Cursor="Hand" FontWeight="SemiBold" Foreground="White"
                                                    Command="{Binding DataContext.pay_relation_command, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                    CommandParameter="{Binding}">
                                                <Button.Template>
                                                    <ControlTemplate TargetType="Button">
                                                        <Border x:Name="bd" Background="#1565C0" CornerRadius="3"
                                                                Padding="{TemplateBinding Padding}">
                                                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                        </Border>
                                                        <ControlTemplate.Triggers>
                                                            <Trigger Property="IsMouseOver" Value="True">
                                                                <Setter TargetName="bd" Property="Background" Value="#1976D2"/>
                                                            </Trigger>
                                                        </ControlTemplate.Triggers>
                                                    </ControlTemplate>
                                                </Button.Template>
                                            </Button>
                                        </StackPanel>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="1.2*"/>
                            <ColumnDefinition Width="1*"/>
                            <ColumnDefinition Width="1*"/>
                            <ColumnDefinition Width="0.9*"/>
                            <ColumnDefinition Width="2.2*"/>
                        </Grid.ColumnDefinitions>
                        <Border Grid.Column="0" BorderBrush="#1565C0" BorderThickness="1,1,1,1" Background="#E3F2FD" Padding="4">
                            <TextBlock Text="TOTAL" FontWeight="Bold" TextAlignment="Left"/>
                        </Border>
                        <Border Grid.Column="1" BorderBrush="#1565C0" BorderThickness="0,1,1,1" Background="#E3F2FD" Padding="4">
                            <TextBlock Text="{Binding pending_total_amount, StringFormat=N2}" FontWeight="Bold" TextAlignment="Center"/>
                        </Border>
                        <Border Grid.Column="2" BorderBrush="#1565C0" BorderThickness="0,1,1,1" Background="#E3F2FD" Padding="4">
                            <TextBlock Text="{Binding pending_total_balance, StringFormat=N2}" FontWeight="Bold" TextAlignment="Center"/>
                        </Border>
                        <Border Grid.Column="3" BorderBrush="#1565C0" BorderThickness="0,1,1,1" Background="#E3F2FD"/>
                        <Border Grid.Column="4" BorderBrush="#1565C0" BorderThickness="0,1,1,1" Background="#E3F2FD"/>
                    </Grid>
                </StackPanel>
            </StackPanel>
        </ScrollViewer>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto"
                      Visibility="{Binding is_paid, Converter={StaticResource BooleanToVisibilityConverter}}">
            <StackPanel>
                <TextBlock Text="Relacion por cobrar - pagadas" FontSize="16" FontWeight="Bold" Foreground="#1565C0"/>

                <TextBlock Text="No hay relaciones pagadas." Foreground="#888888" HorizontalAlignment="Center"
                           Margin="0,20,0,0"
                           Visibility="{Binding paid_empty, Converter={StaticResource BooleanToVisibilityConverter}}"/>

                <StackPanel Width="900" Visibility="{Binding has_paid, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <DataGrid Style="{StaticResource ProVentaGrid}" ItemsSource="{Binding paid_rows}"
                              MouseDoubleClick="RelationGrid_MouseDoubleClick">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="RELACION NRO" Binding="{Binding relation_label}" Width="1.2*"
                                                ElementStyle="{StaticResource CenterCellStyle}"/>
                            <DataGridTextColumn Header="MONTO POR PAGAR" Binding="{Binding amount, StringFormat=N2}" Width="1*"
                                                ElementStyle="{StaticResource CenterCellStyle}"/>
                            <DataGridTextColumn Header="SALDO COMPLETO" Binding="{Binding balance_due_usd, StringFormat=N2}" Width="1*"
                                                ElementStyle="{StaticResource CenterCellStyle}"/>
                            <DataGridTextColumn Header="ESTADO" Binding="{Binding status}" Width="0.9*"
                                                ElementStyle="{StaticResource CenterCellStyle}"/>
                            <DataGridTemplateColumn Header="ACCIONES" Width="2.2*">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                            <Button Content="PDF" Padding="6,2" Margin="2" FontSize="10"
                                                    Cursor="Hand" Background="#F5F5F5" BorderThickness="1"
                                                    BorderBrush="#E0E0E0" Foreground="#424242"
                                                    Command="{Binding DataContext.relation_pdf_command, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                    CommandParameter="{Binding}"/>
                                        </StackPanel>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="1.2*"/>
                            <ColumnDefinition Width="1*"/>
                            <ColumnDefinition Width="1*"/>
                            <ColumnDefinition Width="0.9*"/>
                            <ColumnDefinition Width="2.2*"/>
                        </Grid.ColumnDefinitions>
                        <Border Grid.Column="0" BorderBrush="#1565C0" BorderThickness="1,1,1,1" Background="#E3F2FD" Padding="4">
                            <TextBlock Text="TOTAL" FontWeight="Bold" TextAlignment="Left"/>
                        </Border>
                        <Border Grid.Column="1" BorderBrush="#1565C0" BorderThickness="0,1,1,1" Background="#E3F2FD" Padding="4">
                            <TextBlock Text="{Binding paid_total_amount, StringFormat=N2}" FontWeight="Bold" TextAlignment="Center"/>
                        </Border>
                        <Border Grid.Column="2" BorderBrush="#1565C0" BorderThickness="0,1,1,1" Background="#E3F2FD"/>
                        <Border Grid.Column="3" BorderBrush="#1565C0" BorderThickness="0,1,1,1" Background="#E3F2FD"/>
                        <Border Grid.Column="4" BorderBrush="#1565C0" BorderThickness="0,1,1,1" Background="#E3F2FD"/>
                    </Grid>
                </StackPanel>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
