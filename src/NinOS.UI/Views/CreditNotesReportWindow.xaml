<Window x:Class="NinOS.UI.Views.CreditNotesReportWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:conv="clr-namespace:NinOS.UI.Converters"
        mc:Ignorable="d"
        Title="Reporte de Notas de Credito"
        Width="1180" Height="720"
        MinWidth="980" MinHeight="600"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResizeWithGrip"
        Background="White">
    <Window.Resources>
        <conv:RatioToStarConverter x:Key="RatioToStar" />
        <conv:BooleanToVisibilityConverter x:Key="BoolToVis" />
        <conv:InverseBooleanToVisibilityConverter x:Key="InverseBoolToVis" />

        <Style x:Key="KpiCard" TargetType="Border">
            <Setter Property="Background" Value="#F7F9F6" />
            <Setter Property="BorderBrush" Value="#E1E7DE" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="0,4,4,0" />
            <Setter Property="Padding" Value="9,7" />
        </Style>

        <Style x:Key="KpiLabel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="9" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="#6B7A6F" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>

        <Style x:Key="KpiValue" TargetType="TextBlock">
            <Setter Property="FontSize" Value="18" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="Margin" Value="0,2,0,0" />
        </Style>

        <Style x:Key="KpiHint" TargetType="TextBlock">
            <Setter Property="FontSize" Value="9" />
            <Setter Property="Foreground" Value="#8A968D" />
            <Setter Property="Margin" Value="0,2,0,0" />
        </Style>

        <Style x:Key="FilterLabel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="9.5" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="#55665C" />
            <Setter Property="Margin" Value="0,0,0,2" />
        </Style>

        <Style x:Key="FlatButton" TargetType="Button">
            <Setter Property="Height" Value="26" />
            <Setter Property="Padding" Value="12,0" />
            <Setter Property="FontSize" Value="11.5" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="{TemplateBinding Background}" CornerRadius="4" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Opacity" Value="0.88" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="bd" Property="Opacity" Value="0.45" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SectionTitle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="10.5" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="Foreground" Value="#1B3A2D" />
            <Setter Property="Margin" Value="0,0,0,6" />
        </Style>

        <Style x:Key="CompactDataGrid" TargetType="DataGrid">
            <Setter Property="AutoGenerateColumns" Value="False" />
            <Setter Property="IsReadOnly" Value="True" />
            <Setter Property="GridLinesVisibility" Value="Horizontal" />
            <Setter Property="HeadersVisibility" Value="Column" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="BorderBrush" Value="#E0E0E0" />
            <Setter Property="Background" Value="White" />
            <Setter Property="RowHeaderWidth" Value="0" />
            <Setter Property="CanUserAddRows" Value="False" />
            <Setter Property="CanUserDeleteRows" Value="False" />
            <Setter Property="CanUserReorderColumns" Value="False" />
            <Setter Property="CanUserResizeColumns" Value="False" />
            <Setter Property="SelectionMode" Value="Single" />
            <Setter Property="EnableRowVirtualization" Value="True" />
            <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="MinRowHeight" Value="22" />
        </Style>

        <Style x:Key="CellText" TargetType="TextBlock">
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="TextTrimming" Value="CharacterEllipsis" />
        </Style>

        <Style x:Key="CellTextCenter" TargetType="TextBlock" BasedOn="{StaticResource CellText}">
            <Setter Property="HorizontalAlignment" Value="Center" />
            <Setter Property="TextAlignment" Value="Center" />
        </Style>

        <Style x:Key="CellTextWrap" TargetType="TextBlock" BasedOn="{StaticResource CellText}">
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="TextTrimming" Value="None" />
        </Style>

        <Style x:Key="CellTextCenterWrap" TargetType="TextBlock" BasedOn="{StaticResource CellTextCenter}">
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="TextTrimming" Value="None" />
        </Style>
    </Window.Resources>

    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- FILA 0: TITULO + FILTROS -->
        <StackPanel Grid.Row="0" Margin="0,0,0,8">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Column="0" Text="REPORTE DE NOTAS DE CREDITO" FontSize="16.5" FontWeight="Bold"
                           Foreground="#C62828" VerticalAlignment="Center" Margin="0,0,12,0" />

                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <TextBlock Text="{Binding period_label}" FontSize="12" FontWeight="SemiBold" Foreground="#1B3A2D" />
                    <TextBlock Text="{Binding report.category_label, StringFormat=Categoria: {0}}" FontSize="9.5" Foreground="#7A8A80" />
                </StackPanel>

                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="Actualizando..." FontSize="10" Foreground="#E65100" Margin="0,0,8,0"
                               VerticalAlignment="Center"
                               Visibility="{Binding is_loading, Converter={StaticResource BoolToVis}}" />
                    <Button Content="Exportar PDF" Style="{StaticResource FlatButton}" Background="#C62828"
                            Command="{Binding export_pdf_command}" FontSize="12.5" Height="28" />
                </StackPanel>
            </Grid>

            <Border Background="#F0F4EC" BorderBrush="#DDE5D8" BorderThickness="1" CornerRadius="4" Padding="8,6">
                <StackPanel Orientation="Horizontal">
                    <StackPanel Margin="0,0,14,0">
                        <TextBlock Text="PERIODO" Style="{StaticResource FilterLabel}" />
                        <ComboBox ItemsSource="{Binding period_options}"
                                  SelectedItem="{Binding selected_period}"
                                  FontSize="11.5" Height="24" MinWidth="160"
                                  HorizontalContentAlignment="Center" />
                    </StackPanel>

                    <StackPanel Margin="0,0,14,0">
                        <TextBlock Text="CATEGORIA" Style="{StaticResource FilterLabel}" />
                        <ComboBox ItemsSource="{Binding category_options}"
                                  SelectedItem="{Binding selected_category}"
                                  FontSize="11.5" Height="24" MinWidth="130" />
                    </StackPanel>

                    <Button Content="Actualizar" Style="{StaticResource FlatButton}" Background="#1B3A2D"
                            Command="{Binding refresh_command}" VerticalAlignment="Bottom" Margin="0,0,0,0" />
                </StackPanel>
            </Border>
        </StackPanel>

        <!-- FILA 1: TARJETAS KPI -->
        <UniformGrid Grid.Row="1" Rows="1" Columns="5" Margin="0,0,0,8">
            <Grid Margin="0,0,6,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="4" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Border Grid.Column="0" Background="#C62828" CornerRadius="4,0,0,4" />
                <Border Grid.Column="1" Style="{StaticResource KpiCard}">
                    <StackPanel>
                        <TextBlock Text="TOTAL NOTAS DE CREDITO ($)" Style="{StaticResource KpiLabel}" />
                        <TextBlock Text="{Binding report.total_usd_display}" Style="{StaticResource KpiValue}" Foreground="#C62828" />
                        <TextBlock Text="{Binding report.notes_display}" Style="{StaticResource KpiHint}" />
                    </StackPanel>
                </Border>
            </Grid>

            <Grid Margin="0,0,6,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="4" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Border Grid.Column="0" Background="#1B3A2D" CornerRadius="4,0,0,4" />
                <Border Grid.Column="1" Style="{StaticResource KpiCard}">
                    <StackPanel>
                        <TextBlock Text="PROMEDIO POR NOTA ($)" Style="{StaticResource KpiLabel}" />
                        <TextBlock Text="{Binding report.average_display}" Style="{StaticResource KpiValue}" Foreground="#1B3A2D" />
                        <TextBlock Text="Ticket promedio del periodo" Style="{StaticResource KpiHint}" />
                    </StackPanel>
                </Border>
            </Grid>

            <Grid Margin="0,0,6,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="4" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Border Grid.Column="0" Background="#2E7D32" CornerRadius="4,0,0,4" />
                <Border Grid.Column="1" Style="{StaticResource KpiCard}">
                    <StackPanel>
                        <TextBlock Text="OBSEQUIOS ($)" Style="{StaticResource KpiLabel}" />
                        <TextBlock Text="{Binding report.gift_usd_display}" Style="{StaticResource KpiValue}" Foreground="#2E7D32" />
                        <TextBlock Text="{Binding report.gift_share_display, StringFormat={} {0} del total}" Style="{StaticResource KpiHint}" />
                    </StackPanel>
                </Border>
            </Grid>

            <Grid Margin="0,0,6,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="4" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Border Grid.Column="0" Background="#E65100" CornerRadius="4,0,0,4" />
                <Border Grid.Column="1" Style="{StaticResource KpiCard}">
                    <StackPanel>
                        <TextBlock Text="DEVOLUCIONES ($)" Style="{StaticResource KpiLabel}" />
                        <TextBlock Text="{Binding report.return_usd_display}" Style="{StaticResource KpiValue}" Foreground="#E65100" />
                        <TextBlock Text="{Binding report.return_share_display, StringFormat={} {0} del total}" Style="{StaticResource KpiHint}" />
                    </StackPanel>
                </Border>
            </Grid>

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="4" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Border Grid.Column="0" Background="#37474F" CornerRadius="4,0,0,4" />
                <Border Grid.Column="1" Style="{StaticResource KpiCard}">
                    <StackPanel>
                        <TextBlock Text="CLIENTES AFECTADOS" Style="{StaticResource KpiLabel}" />
                        <TextBlock Text="{Binding report.affected_customers}" Style="{StaticResource KpiValue}" Foreground="#6A1B9A" />
                        <TextBlock Text="Clientes con notas de credito" Style="{StaticResource KpiHint}" />
                    </StackPanel>
                </Border>
            </Grid>
        </UniformGrid>

        <!-- FILA 2: DETALLE + BARRAS -->
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="2.6*" />
                <ColumnDefinition Width="6" />
                <ColumnDefinition Width="1*" MinWidth="250" />
            </Grid.ColumnDefinitions>

            <Grid Grid.Column="0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0" Text="DETALLE DE NOTAS DE CREDITO" Style="{StaticResource SectionTitle}" />

                <Grid Grid.Row="1">
                    <DataGrid Style="{StaticResource CompactDataGrid}" ItemsSource="{Binding report.rows}">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="FECHA" Binding="{Binding fecha_display}" Width="80"
                                                ElementStyle="{StaticResource CellTextCenter}" />
                            <DataGridTextColumn Header="CATEGORIA" Binding="{Binding categoria_display}" Width="88"
                                                ElementStyle="{StaticResource CellTextCenter}" />
                            <DataGridTextColumn Header="NRO NC" Binding="{Binding note_number}" Width="98"
                                                ElementStyle="{StaticResource CellTextCenter}" />
                            <DataGridTextColumn Header="NOTA DE ENTREGA" Binding="{Binding entrega_display}" Width="105"
                                                ElementStyle="{StaticResource CellTextCenter}" />
                            <DataGridTextColumn Header="CLIENTE" Binding="{Binding customer_name}" Width="*"
                                                ElementStyle="{StaticResource CellTextWrap}" />
                            <DataGridTextColumn Header="VENDEDOR" Binding="{Binding seller_name}" Width="82"
                                                ElementStyle="{StaticResource CellTextCenterWrap}" />
                            <DataGridTextColumn Header="ESTADO" Binding="{Binding status}" Width="78"
                                                ElementStyle="{StaticResource CellTextCenter}" />
                            <DataGridTextColumn Header="MONTO" Binding="{Binding total_amount_usd, StringFormat=N2}" Width="82">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock" BasedOn="{StaticResource CellTextCenter}">
                                        <Setter Property="Foreground" Value="#C62828" />
                                        <Setter Property="FontWeight" Value="Bold" />
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>
                        </DataGrid.Columns>
                    </DataGrid>

                    <Border Background="#FAFAF7" BorderBrush="#E0E0E0" BorderThickness="1"
                            Visibility="{Binding has_data, Converter={StaticResource InverseBoolToVis}}">
                        <TextBlock Text="No hay notas de credito para el periodo y la categoria seleccionados."
                                   HorizontalAlignment="Center" VerticalAlignment="Center"
                                   FontSize="12" Foreground="#9AA79E" />
                    </Border>
                </Grid>
            </Grid>

            <Grid Grid.Column="2">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0" Text="DESGLOSE POR VENDEDOR" Style="{StaticResource SectionTitle}" />

                <ItemsControl Grid.Row="1" ItemsSource="{Binding report.by_seller}" Margin="0,0,0,10">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Grid Margin="0,0,0,9">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>

                                <Grid Grid.Row="0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="{Binding seller_name}" FontSize="11" FontWeight="SemiBold"
                                               Foreground="#1B3A2D" TextTrimming="CharacterEllipsis" Margin="0,0,6,0" />
                                    <TextBlock Grid.Column="1" Text="{Binding total_display}"
                                               FontSize="11" FontWeight="Bold" Foreground="#C62828" />
                                </Grid>

                                <Grid Grid.Row="1" Height="9">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="{Binding gift_ratio, Converter={StaticResource RatioToStar}}" />
                                        <ColumnDefinition Width="{Binding return_ratio, Converter={StaticResource RatioToStar}}" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Border Grid.Column="0" Background="#2E7D32" CornerRadius="2,0,0,2" />
                                    <Border Grid.Column="1" Background="#C62828" CornerRadius="0,2,2,0" />
                                </Grid>

                                <TextBlock Grid.Row="2" Text="{Binding breakdown_display}"
                                           FontSize="8.5" Foreground="#8A968D" Margin="0,2,0,0" TextTrimming="CharacterEllipsis" />
                            </Grid>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <TextBlock Grid.Row="2" Text="MOVIMIENTO POR DIA" Style="{StaticResource SectionTitle}" Margin="0,4,0,6" />

                <ScrollViewer Grid.Row="3" VerticalScrollBarVisibility="Auto">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <Grid Grid.Row="0" Height="96"
                              Visibility="{Binding show_day_bars, Converter={StaticResource BoolToVis}}">
                            <ItemsControl ItemsSource="{Binding report.by_day}" VerticalAlignment="Bottom">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <StackPanel Orientation="Horizontal" />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <StackPanel Width="17" Margin="0,0,1,0" ToolTip="{Binding day_label}">
                                            <TextBlock Text="{Binding total_display}" FontSize="6.5" Foreground="#6B7A6F"
                                                       TextAlignment="Center" TextTrimming="CharacterEllipsis" Height="12" />
                                            <Grid Height="66" Width="13" VerticalAlignment="Bottom">
                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="{Binding total_ratio, Converter={StaticResource RatioToStar}}" />
                                                    <RowDefinition Height="*" />
                                                </Grid.RowDefinitions>
                                                <Border Grid.Row="0" Background="#C62828" CornerRadius="2,2,0,0" VerticalAlignment="Bottom" />
                                            </Grid>
                                            <TextBlock Text="{Binding day_display}" FontSize="6.5" Foreground="#8A968D"
                                                       TextAlignment="Center" Margin="0,2,0,0" />
                                        </StackPanel>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </Grid>

                        <TextBlock Grid.Row="1" Text="El desglose por dia se muestra solo en el reporte de un mes."
                                   FontSize="9.5" Foreground="#9AA79E" Margin="0,8,0,0" TextWrapping="Wrap"
                                   Visibility="{Binding show_day_bars, Converter={StaticResource InverseBoolToVis}}" />
                    </Grid>
                </ScrollViewer>
            </Grid>
        </Grid>

        <!-- FILA 3: FOOTER -->
        <Border Grid.Row="3" Background="#1B3A2D" Padding="10,5" Margin="0,8,0,0" CornerRadius="0,0,4,4">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Column="0" Text="{Binding period_label, StringFormat=Reporte de notas de credito — {0}}"
                           Foreground="#C6D6CB" FontSize="11" VerticalAlignment="Center" />

                <StackPanel Grid.Column="1" Orientation="Horizontal">
                    <TextBlock Text="TOTAL DEL PERIODO: $" Foreground="#C6D6CB" FontSize="12" VerticalAlignment="Center" />
                    <TextBlock Text="{Binding report.total_usd_display}" Foreground="White" FontSize="14.5"
                               FontWeight="Bold" VerticalAlignment="Center" Margin="4,0,0,0" />
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
