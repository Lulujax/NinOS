<Window x:Class="NinOS.UI.Views.CommissionHistoryWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Historial de Comision"
        Width="820" Height="560"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResizeWithGrip"
        Background="White"
        PreviewKeyDown="Window_PreviewKeyDown">
    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- TARJETA DE CABECERA -->
        <Border Grid.Row="0" Background="#F1F8E9" BorderBrush="#2E7D32" BorderThickness="1"
                CornerRadius="4" Padding="12" Margin="0,0,0,8">
            <StackPanel>
                <DockPanel LastChildFill="True">
                    <StackPanel Orientation="Horizontal" DockPanel.Dock="Left">
                        <TextBlock Text="Nota:" FontSize="12" FontWeight="Bold" Foreground="#2E7D32" VerticalAlignment="Center"/>
                        <TextBlock x:Name="NoteNumberText" FontSize="13" FontWeight="Bold" Foreground="#1B5E20" Margin="6,0,18,0" VerticalAlignment="Center"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" DockPanel.Dock="Left">
                        <TextBlock Text="Cliente:" FontSize="12" FontWeight="Bold" Foreground="#2E7D32" VerticalAlignment="Center"/>
                        <TextBlock x:Name="CustomerText" FontSize="12" Foreground="#424242" Margin="6,0,18,0" VerticalAlignment="Center"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" DockPanel.Dock="Left">
                        <TextBlock Text="Vendedora:" FontSize="12" FontWeight="Bold" Foreground="#2E7D32" VerticalAlignment="Center"/>
                        <TextBlock x:Name="SellerText" FontSize="12" Foreground="#424242" Margin="6,0,0,0" VerticalAlignment="Center"/>
                    </StackPanel>
                </DockPanel>

                <Border Background="White" BorderBrush="#C8E6C9" BorderThickness="1" CornerRadius="4" Margin="0,8,0,0" Padding="8,6">
                    <DockPanel LastChildFill="False">
                        <StackPanel Orientation="Horizontal" DockPanel.Dock="Left" Margin="0,0,24,0">
                            <TextBlock Text="FACTURADO:" FontSize="12" FontWeight="Bold" Foreground="#424242" VerticalAlignment="Center"/>
                            <TextBlock x:Name="TotalFacturadoText" FontSize="14" FontWeight="Bold" Foreground="#1B5E20" Margin="6,0,0,0" VerticalAlignment="Center"/>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" DockPanel.Dock="Left" Margin="0,0,24,0">
                            <TextBlock Text="COMISION:" FontSize="12" FontWeight="Bold" Foreground="#424242" VerticalAlignment="Center"/>
                            <TextBlock x:Name="CommissionText" FontSize="14" FontWeight="Bold" Foreground="#2E7D32" Margin="6,0,0,0" VerticalAlignment="Center"/>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" DockPanel.Dock="Left" Margin="0,0,24,0">
                            <TextBlock Text="COMISION PENDIENTE:" FontSize="12" FontWeight="Bold" Foreground="#424242" VerticalAlignment="Center"/>
                            <TextBlock x:Name="CommissionPendingText" FontSize="14" FontWeight="Bold" Foreground="#F57C00" Margin="6,0,0,0" VerticalAlignment="Center"/>
                        </StackPanel>
                    </DockPanel>
                </Border>
            </StackPanel>
        </Border>

        <!-- AVISO SIN PAGOS -->
        <Border Grid.Row="1" x:Name="NoHistoryBox" Background="#FFF8E1" BorderBrush="#F9A825" BorderThickness="1"
                CornerRadius="4" Padding="10,6" Margin="0,0,0,8" Visibility="Collapsed">
            <StackPanel>
                <TextBlock Text="Aun no hay pagos de comision registrados para esta nota." FontSize="12" FontWeight="Bold" Foreground="#E65100"/>
            </StackPanel>
        </Border>

        <!-- DATAGRID DE PAGOS DE COMISION -->
        <DataGrid Grid.Row="2" x:Name="HistoryGrid" AutoGenerateColumns="False"
                  AlternatingRowBackground="#F7FAF5" RowBackground="White"
                  CanUserAddRows="False" IsReadOnly="True" GridLinesVisibility="Horizontal"
                  HorizontalGridLinesBrush="#E4EEDD"
                  BorderBrush="#C5D3E0" BorderThickness="1" FontSize="11" RowHeight="30"
                  EnableRowVirtualization="True">
            <DataGrid.Resources>
                <Style TargetType="DataGridColumnHeader">
                    <Setter Property="Background" Value="#2E7D32"/>
                    <Setter Property="Foreground" Value="White"/>
                    <Setter Property="FontWeight" Value="Bold"/>
                    <Setter Property="FontSize" Value="11"/>
                    <Setter Property="Padding" Value="4,0"/>
                </Style>
            </DataGrid.Resources>
            <DataGrid.Columns>
                <DataGridTextColumn Header="FECHA PAGO" Binding="{Binding payment_date, StringFormat={}{0:dd/MM/yyyy}}" Width="100"/>
                <DataGridTextColumn Header="MONTO USD" Binding="{Binding amount_usd, StringFormat={}{0:N2}}" Width="90">
                    <DataGridTextColumn.ElementStyle>
                        <Style TargetType="TextBlock">
                            <Setter Property="HorizontalAlignment" Value="Right"/>
                            <Setter Property="TextAlignment" Value="Right"/>
                            <Setter Property="FontWeight" Value="SemiBold"/>
                        </Style>
                    </DataGridTextColumn.ElementStyle>
                </DataGridTextColumn>
                <DataGridTextColumn Header="TASA" Binding="{Binding exchange_rate, StringFormat={}{0:N2}}" Width="70">
                    <DataGridTextColumn.ElementStyle>
                        <Style TargetType="TextBlock">
                            <Setter Property="HorizontalAlignment" Value="Right"/>
                            <Setter Property="TextAlignment" Value="Right"/>
                        </Style>
                    </DataGridTextColumn.ElementStyle>
                </DataGridTextColumn>
                <DataGridTextColumn Header="MONTO BS" Binding="{Binding amount_bs, StringFormat={}{0:N2}}" Width="90">
                    <DataGridTextColumn.ElementStyle>
                        <Style TargetType="TextBlock">
                            <Setter Property="HorizontalAlignment" Value="Right"/>
                            <Setter Property="TextAlignment" Value="Right"/>
                        </Style>
                    </DataGridTextColumn.ElementStyle>
                </DataGridTextColumn>
                <DataGridTextColumn Header="TIPO" Binding="{Binding payment_type}" Width="85"/>
                <DataGridTextColumn Header="BANCO" Binding="{Binding bank_name}" Width="90"/>
                <DataGridTextColumn Header="REFERENCIA" Binding="{Binding reference_number}" Width="100"/>
                <DataGridTextColumn Header="OBSERVACIONES" Binding="{Binding notes}" Width="*"/>
            </DataGrid.Columns>
        </DataGrid>

        <!-- PANEL DE ACCIONES -->
        <DockPanel Grid.Row="3" Margin="0,8,0,0" LastChildFill="False">
            <Button DockPanel.Dock="Left" Margin="8,0,0,0" Content="Cerrar" Background="#E0E0E0" Foreground="#424242"
                    FontSize="10" Padding="8,3" BorderThickness="0" Cursor="Hand" Click="CloseButton_Click"/>
        </DockPanel>
    </Grid>
</Window>