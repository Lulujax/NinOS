<Window x:Class="NinOS.UI.Views.DescargarPlantillaWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Descargar plantilla de inventario"
        Width="440" SizeToContent="Height"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        FontSize="13">
    <StackPanel Margin="20">
        <TextBlock Text="¿Qué desea cambiar?" FontWeight="Bold"/>
        <ComboBox x:Name="cmb_tipo" Margin="0,6,0,14" Height="28" SelectionChanged="on_tipo_changed">
            <ComboBoxItem Content="Cantidad" Tag="cantidad" IsSelected="True"/>
            <ComboBoxItem Content="Precio" Tag="precio"/>
        </ComboBox>

        <StackPanel x:Name="panel_lista" Visibility="Collapsed">
            <TextBlock Text="¿Qué lista?" FontWeight="Bold"/>
            <ComboBox x:Name="cmb_lista" DisplayMemberPath="name" Margin="0,6,0,14" Height="28"/>
        </StackPanel>

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button Content="Cancelar" IsCancel="True" Width="100" Height="30" Margin="0,0,8,0"/>
            <Button Content="Descargar" IsDefault="True" Width="120" Height="30" Click="on_descargar_click"/>
        </StackPanel>
    </StackPanel>
</Window>
