<UserControl x:Class="NinOS.UI.Views.PaymentsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d" Background="White">
    <UserControl.Resources>
        <Style x:Key="TabItemStyle" TargetType="ListBoxItem">
            <Setter Property="Padding" Value="12,8"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Style.Triggers>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="#4CAF50"/>
                    <Setter Property="Foreground" Value="White"/>
                    <Setter Property="FontWeight" Value="Bold"/>
                </Trigger>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#C8E6C9"/>
                </Trigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="ActionBtn" TargetType="Button">
            <Setter Property="Padding" Value="8,4"/>
            <Setter Property="Margin" Value="2"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Background" Value="#F5F5F5"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush" Value="#E0E0E0"/>
            <Setter Property="Foreground" Value="#424242"/>
        </Style>
    </UserControl.Resources>
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="220"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        <Border Grid.Column="0" Background="#F5FBF5" CornerRadius="4" Margin="0,0,10,0" Padding="10">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <TextBlock Grid.Row="0" Text="PAGOS" FontWeight="Bold" FontSize="13" Foreground="#2E7D32" HorizontalAlignment="Center" Margin="0,0,0,8"/>
                <ListBox Grid.Row="1" ItemsSource="{Binding pending_months}" SelectedItem="{Binding selected_month}"
                         Background="Transparent" BorderThickness="0" ItemContainerStyle="{StaticResource TabItemStyle}">
                    <ListBox.ItemTemplate><DataTemplate><TextBlock Text="{Binding}"/></DataTemplate></ListBox.ItemTemplate>
                </ListBox>
                <TextBlock Grid.Row="2" Text="VENDEDORES" FontWeight="Bold" FontSize="11" Margin="0,8,0,5" Foreground="#888"/>
                <ListBox Grid.Row="3" ItemsSource="{Binding sellers}" SelectedItem="{Binding selected_seller}"
                         Background="Transparent" BorderThickness="0"
                         ItemContainerStyle="{StaticResource TabItemStyle}" DisplayMemberPath="full_name"/>
            </Grid>
        </Border>
        <Border Grid.Column="1" BorderBrush="#4CAF50" BorderThickness="2" Padding="10" Background="White" CornerRadius="4">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="8"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0" Text="NOTAS" FontWeight="Bold" FontSize="14" Foreground="#2E7D32" Margin="0,0,0,6"/>

                <DataGrid Grid.Row="1" ItemsSource="{Binding notes}" AutoGenerateColumns="False"
                          AlternatingRowBackground="#E8F5E9" RowBackground="White"
                          CanUserAddRows="False" IsReadOnly="True" GridLinesVisibility="All"
                          HorizontalGridLinesBrush="#A5D6A7" VerticalGridLinesBrush="#A5D6A7"
                          BorderBrush="#4CAF50" BorderThickness="1" FontSize="13" RowHeight="36">
                    <DataGrid.Resources>
                        <Style TargetType="DataGridColumnHeader">
                            <Setter Property="Background" Value="#2E7D32"/>
                            <Setter Property="Foreground" Value="White"/>
                            <Setter Property="FontWeight" Value="Bold"/>
                            <Setter Property="FontSize" Value="12"/>
                            <Setter Property="Height" Value="30"/>
                            <Setter Property="HorizontalContentAlignment" Value="Center"/>
                        </Style>
                        <Style TargetType="DataGridCell">
                            <Setter Property="VerticalAlignment" Value="Center"/>
                            <Setter Property="Padding" Value="4,2"/>
                        </Style>
                    </DataGrid.Resources>
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="NOTA" Binding="{Binding note_number}" Width="90">
                            <DataGridTextColumn.ElementStyle><Style TargetType="TextBlock"><Setter Property="HorizontalAlignment" Value="Center"/></Style></DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>
                        <DataGridTextColumn Header="CLIENTE" Binding="{Binding customer_name}" Width="*"/>
                        <DataGridTextColumn Header="VENDEDOR" Binding="{Binding seller_name}" Width="110"/>
                        <DataGridTextColumn Header="TOTAL" Binding="{Binding total_amount_usd, StringFormat={}{0:N2}}" Width="90">
                            <DataGridTextColumn.ElementStyle><Style TargetType="TextBlock"><Setter Property="HorizontalAlignment" Value="Right"/></Style></DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>
                        <DataGridTextColumn Header="SALDO" Binding="{Binding balance_due_usd, StringFormat={}{0:N2}}" Width="90">
                            <DataGridTextColumn.ElementStyle><Style TargetType="TextBlock"><Setter Property="HorizontalAlignment" Value="Right"/><Setter Property="FontWeight" Value="Bold"/></Style></DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>
                        <DataGridTextColumn Header="ESTADO" Binding="{Binding status}" Width="80">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="HorizontalAlignment" Value="Center"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding status}" Value="Pagada">
                                            <Setter Property="Foreground" Value="#2E7D32"/>
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding status}" Value="Pendiente">
                                            <Setter Property="Foreground" Value="#E65100"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>
                        <DataGridTemplateColumn Header="ACCIONES" Width="160">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                        <Button Content="Abonar"
                                                Command="{Binding DataContext.open_payment_command, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                CommandParameter="{Binding}">
                                            <Button.Style>
                                                <Style TargetType="Button">
                                                    <Setter Property="Padding" Value="8,4"/>
                                                    <Setter Property="Margin" Value="2"/>
                                                    <Setter Property="FontSize" Value="11"/>
                                                    <Setter Property="Cursor" Value="Hand"/>
                                                    <Setter Property="Background" Value="#F5F5F5"/>
                                                    <Setter Property="BorderThickness" Value="1"/>
                                                    <Setter Property="BorderBrush" Value="#E0E0E0"/>
                                                    <Setter Property="Foreground" Value="#2E7D32"/>
                                                    <Setter Property="Visibility" Value="Visible"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding status}" Value="Pagada">
                                                            <Setter Property="Visibility" Value="Collapsed"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Button.Style>
                                        </Button>
                                        <Button Content="Historial" Style="{StaticResource ActionBtn}"
                                                Command="{Binding DataContext.open_note_history_command, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                CommandParameter="{Binding}"/>
                                    </StackPanel>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>

                <TextBlock Grid.Row="3" Text="PAGOS REGISTRADOS" FontWeight="Bold" FontSize="14" Foreground="#2E7D32" Margin="0,6,0,6"/>

                <DataGrid Grid.Row="4" ItemsSource="{Binding payments}" AutoGenerateColumns="False"
                          AlternatingRowBackground="#E8F5E9" RowBackground="White"
                          CanUserAddRows="False" IsReadOnly="True" GridLinesVisibility="All"
                          HorizontalGridLinesBrush="#A5D6A7" VerticalGridLinesBrush="#A5D6A7"
                          BorderBrush="#4CAF50" BorderThickness="1" FontSize="13" RowHeight="36">
                    <DataGrid.Resources>
                        <Style TargetType="DataGridColumnHeader">
                            <Setter Property="Background" Value="#1B5E20"/>
                            <Setter Property="Foreground" Value="White"/>
                            <Setter Property="FontWeight" Value="Bold"/>
                            <Setter Property="FontSize" Value="12"/>
                            <Setter Property="Height" Value="30"/>
                            <Setter Property="HorizontalContentAlignment" Value="Center"/>
                        </Style>
                        <Style TargetType="DataGridCell">
                            <Setter Property="VerticalAlignment" Value="Center"/>
                            <Setter Property="Padding" Value="4,2"/>
                        </Style>
                    </DataGrid.Resources>
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="NOTA" Binding="{Binding note_number}" Width="90">
                            <DataGridTextColumn.ElementStyle><Style TargetType="TextBlock"><Setter Property="HorizontalAlignment" Value="Center"/></Style></DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>
                        <DataGridTextColumn Header="CLIENTE" Binding="{Binding customer_name}" Width="*"/>
                        <DataGridTextColumn Header="VENDEDOR" Binding="{Binding seller_name}" Width="110"/>
                        <DataGridTextColumn Header="USD" Binding="{Binding amount_usd, StringFormat={}{0:N2}}" Width="85">
                            <DataGridTextColumn.ElementStyle><Style TargetType="TextBlock"><Setter Property="HorizontalAlignment" Value="Right"/></Style></DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>
                        <DataGridTextColumn Header="BS" Binding="{Binding amount_bs, StringFormat={}{0:N2}}" Width="85">
                            <DataGridTextColumn.ElementStyle><Style TargetType="TextBlock"><Setter Property="HorizontalAlignment" Value="Right"/></Style></DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>
                        <DataGridTextColumn Header="TASA" Binding="{Binding exchange_rate, StringFormat={}{0:N2}}" Width="65"/>
                        <DataGridTextColumn Header="TIPO" Binding="{Binding payment_type}" Width="85"/>
                        <DataGridTextColumn Header="REF" Binding="{Binding reference_number}" Width="80"/>
                        <DataGridTextColumn Header="FECHA" Binding="{Binding payment_date, StringFormat={}{0:dd/MM/yyyy}}" Width="85">
                            <DataGridTextColumn.ElementStyle><Style TargetType="TextBlock"><Setter Property="HorizontalAlignment" Value="Center"/></Style></DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>
                    </DataGrid.Columns>
                </DataGrid>

                <Border Grid.Row="5" Background="#2E7D32" BorderBrush="#1B5E20" BorderThickness="1" Margin="0,4,0,0" Padding="10,6" CornerRadius="4">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="TOTAL PAGOS MES:" FontWeight="Bold" FontSize="13" Foreground="White" VerticalAlignment="Center"/>
                        <TextBlock Text="{Binding total_payments_usd, StringFormat={}{0:N2}}" FontWeight="Bold" FontSize="15" Foreground="White" Margin="10,0,0,0" VerticalAlignment="Center"/>
                    </StackPanel>
                </Border>
            </Grid>
        </Border>
    </Grid>
</UserControl>
