<Window x:Class="NinOS.UI.Views.PromotionSalesHistoryWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Historial de la Promocion"
        Width="1000" Height="560"
        WindowStartupLocation="CenterOwner"
        WindowState="Maximized"
        ResizeMode="CanResizeWithGrip"
        Background="White"
        PreviewKeyDown="Window_PreviewKeyDown">
    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- TARJETA DE PROMOCION -->
        <Border Grid.Row="0" Background="#F0F6FC" BorderBrush="#0D62B5" BorderThickness="1"
                CornerRadius="4" Padding="12" Margin="0,0,0,8">
            <StackPanel>
                <DockPanel LastChildFill="True">
                    <StackPanel Orientation="Horizontal" DockPanel.Dock="Left">
                        <TextBlock Text="Promocion:" FontSize="15" FontWeight="Bold" Foreground="#0D62B5" VerticalAlignment="Center"/>
                        <TextBlock x:Name="PromoNameText" FontSize="17" FontWeight="Bold" Foreground="#1565C0" Margin="6,0,18,0" VerticalAlignment="Center"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" DockPanel.Dock="Left">
                        <TextBlock Text="Codigo:" FontSize="15" FontWeight="Bold" Foreground="#0D62B5" VerticalAlignment="Center"/>
                        <TextBlock x:Name="PromoCodeText" FontSize="15" Foreground="#424242" Margin="6,0,18,0" VerticalAlignment="Center"/>
                    </StackPanel>
                </DockPanel>

                <Border Background="White" BorderBrush="#DEE5EB" BorderThickness="1" CornerRadius="4" Margin="0,8,0,0" Padding="8,6">
                    <DockPanel LastChildFill="False">
                        <StackPanel Orientation="Horizontal" DockPanel.Dock="Left" Margin="0,0,24,0">
                            <TextBlock Text="CATEGORÍA:" FontSize="15" FontWeight="Bold" Foreground="#424242" VerticalAlignment="Center"/>
                            <TextBlock x:Name="PromoCategoryText" FontSize="16" FontWeight="Bold" Foreground="#0D62B5" Margin="6,0,0,0" VerticalAlignment="Center"/>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" DockPanel.Dock="Left" Margin="0,0,24,0">
                            <TextBlock Text="TIPO:" FontSize="15" FontWeight="Bold" Foreground="#424242" VerticalAlignment="Center"/>
                            <TextBlock x:Name="PromoTypeText" FontSize="16" FontWeight="Bold" Foreground="#6A1B9A" Margin="6,0,0,0" VerticalAlignment="Center"/>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" DockPanel.Dock="Left" Margin="0,0,24,0">
                            <TextBlock Text="PRECIO ($):" FontSize="15" FontWeight="Bold" Foreground="#424242" VerticalAlignment="Center"/>
                            <TextBlock x:Name="PromoPriceText" FontSize="16" FontWeight="Bold" Foreground="#2E7D32" Margin="6,0,0,0" VerticalAlignment="Center"/>
                        </StackPanel>
                    </DockPanel>
                </Border>
            </StackPanel>
        </Border>

        <!-- COMPOSICION DE LA PROMOCION -->
        <Border Grid.Row="1" Background="#F5F9FD" BorderBrush="#C5D3E0" BorderThickness="1"
                CornerRadius="4" Padding="12" Margin="0,0,0,8">
            <StackPanel>
                <TextBlock Text="ESTÁ COMPUESTA POR:" FontSize="14" FontWeight="Bold" Foreground="#0D62B5" Margin="0,0,0,6"/>
                <ItemsControl x:Name="CompositionItems">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel Orientation="Vertical" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Background="White" BorderBrush="#C5D3E0" BorderThickness="1"
                                    CornerRadius="3" Padding="8,3" Margin="0,0,0,4">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="{Binding}" FontSize="14" Foreground="#37474F"/>
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                <TextBlock x:Name="CompositionEmptyText"
                           Text="Esta promoción no tiene productos cargados."
                           FontSize="14" FontStyle="Italic" Foreground="#8A6D3B"
                           Visibility="Collapsed" />
            </StackPanel>
        </Border>

        <!-- DATAGRID DE HISTORIAL -->
        <DataGrid Grid.Row="2" x:Name="HistoryGrid" AutoGenerateColumns="False"
                  AlternatingRowBackground="#F5F9FD" RowBackground="White"
                  CanUserAddRows="False" IsReadOnly="True" GridLinesVisibility="Horizontal"
                  HorizontalGridLinesBrush="#E0E7EE"
                  BorderBrush="#C5D3E0" BorderThickness="1" FontSize="14" RowHeight="35"
                  EnableRowVirtualization="True"
                  ScrollViewer.HorizontalScrollBarVisibility="Auto">
            <DataGrid.Resources>
                <Style TargetType="DataGridColumnHeader">
                    <Setter Property="Background" Value="#0D62B5"/>
                    <Setter Property="Foreground" Value="White"/>
                    <Setter Property="FontWeight" Value="Bold"/>
                    <Setter Property="FontSize" Value="13.5"/>
                    <Setter Property="Height" Value="34"/>
                    <Setter Property="Padding" Value="6,0"/>
                    <Setter Property="HorizontalContentAlignment" Value="Center"/>
                    <Setter Property="VerticalContentAlignment" Value="Center"/>
                </Style>
            </DataGrid.Resources>
            <DataGrid.Columns>
                <DataGridTextColumn Header="NOTA" Binding="{Binding note_number}" Width="100"/>
                <DataGridTextColumn Header="FECHA" Binding="{Binding fecha_display}" Width="100" MinWidth="95"/>
                <DataGridTextColumn Header="DOCUMENTO" Binding="{Binding documento_display}" Width="120"/>
                <DataGridTextColumn Header="MOTIVO" Binding="{Binding motivo_display}" Width="130"/>
                <DataGridTextColumn Header="CLIENTE" Binding="{Binding customer_name}" Width="*" MinWidth="180"/>
                <DataGridTextColumn Header="VENDEDOR" Binding="{Binding seller_name}" Width="120"/>
                <DataGridTextColumn Header="MOVIMIENTO" Binding="{Binding movement_type}" Width="120">
                    <DataGridTextColumn.ElementStyle>
                        <Style TargetType="TextBlock">
                            <Setter Property="HorizontalAlignment" Value="Center"/>
                            <Setter Property="FontWeight" Value="Bold"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding movement_type}" Value="ENTRADA">
                                    <Setter Property="Foreground" Value="#2E7D32"/>
                                </DataTrigger>
                                <DataTrigger Binding="{Binding movement_type}" Value="SALIDA">
                                    <Setter Property="Foreground" Value="#C62828"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </DataGridTextColumn.ElementStyle>
                </DataGridTextColumn>
                <DataGridTextColumn Header="UNIDADES" Binding="{Binding unidades_display}" Width="90">
                    <DataGridTextColumn.ElementStyle>
                        <Style TargetType="TextBlock">
                            <Setter Property="HorizontalAlignment" Value="Right"/>
                            <Setter Property="FontWeight" Value="Bold"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding movement_type}" Value="ENTRADA">
                                    <Setter Property="Foreground" Value="#2E7D32"/>
                                </DataTrigger>
                                <DataTrigger Binding="{Binding movement_type}" Value="SALIDA">
                                    <Setter Property="Foreground" Value="#C62828"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </DataGridTextColumn.ElementStyle>
                </DataGridTextColumn>
                <DataGridTextColumn Header="PRECIO" Binding="{Binding precio_display}" Width="95">
                    <DataGridTextColumn.ElementStyle>
                        <Style TargetType="TextBlock">
                            <Setter Property="HorizontalAlignment" Value="Right"/>
                            <Setter Property="TextAlignment" Value="Right"/>
                        </Style>
                    </DataGridTextColumn.ElementStyle>
                </DataGridTextColumn>
                <DataGridTextColumn Header="SUB TOTAL" Binding="{Binding subtotal_display}" Width="110">
                    <DataGridTextColumn.ElementStyle>
                        <Style TargetType="TextBlock">
                            <Setter Property="HorizontalAlignment" Value="Right"/>
                            <Setter Property="TextAlignment" Value="Right"/>
                        </Style>
                    </DataGridTextColumn.ElementStyle>
                </DataGridTextColumn>
                <DataGridTextColumn Header="ESTADO" Binding="{Binding status}" Width="100">
                    <DataGridTextColumn.ElementStyle>
                        <Style TargetType="TextBlock">
                            <Setter Property="HorizontalAlignment" Value="Center"/>
                            <Setter Property="FontWeight" Value="SemiBold"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding status}" Value="Anulada">
                                    <Setter Property="Foreground" Value="#2E7D32"/>
                                </DataTrigger>
                                <DataTrigger Binding="{Binding status}" Value="Pendiente">
                                    <Setter Property="Foreground" Value="#C62828"/>
                                </DataTrigger>
                                <DataTrigger Binding="{Binding status}" Value="Pagada">
                                    <Setter Property="Foreground" Value="#1565C0"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </DataGridTextColumn.ElementStyle>
                </DataGridTextColumn>
            </DataGrid.Columns>
        </DataGrid>

        <!-- PANEL DE ACCIONES -->
        <DockPanel Grid.Row="3" Margin="0,8,0,0" LastChildFill="False">
            <Button DockPanel.Dock="Left" Content="Cerrar" Background="#E0E0E0" Foreground="#424242"
                    FontSize="13" Padding="8,3" BorderThickness="0" Cursor="Hand" Click="CloseButton_Click"/>
        </DockPanel>
    </Grid>
</Window>