<Window x:Class="NinOS.UI.Views.AddCreditNoteWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Nota de Credito" Height="620" Width="960"
        WindowStartupLocation="CenterOwner" Background="#F5F5F5"
        ResizeMode="CanResizeWithGrip" FontSize="12" MinHeight="520" MinWidth="840">
    <Grid Margin="14">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="Nota de Credito" FontSize="14" FontWeight="Bold"
                   Foreground="#C62828" Margin="0,0,0,8"/>

        <!-- CATEGORIA: Devolucion (anclada a nota de entrega) u Obsequio (regala producto) -->
        <Grid Grid.Row="1" Margin="0,0,0,6">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="170"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0" VerticalAlignment="Center"><Run Text="Categoria:"/><Run Text="*" Foreground="Red"/></TextBlock>
            <ComboBox x:Name="CmbCategory" Grid.Column="1" FontSize="11" Width="150" HorizontalAlignment="Left" Height="26"
                      HorizontalContentAlignment="Center" ToolTip="Tipo de nota de credito"
                      SelectionChanged="OnCategoryChanged">
                <ComboBoxItem Content="Devolucion" Tag="Devolucion" IsSelected="True"/>
                <ComboBoxItem Content="Obsequio" Tag="Obsequio"/>
            </ComboBox>
        </Grid>

        <!-- VENDEDOR: se elige primero en ambas categorias (filtra notas en Devolucion o clientes en Obsequio) -->
        <Grid Grid.Row="2" x:Name="SellerRow" Margin="0,0,0,6">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="170"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0" VerticalAlignment="Center"><Run Text="Vendedor:"/><Run Text="*" Foreground="Red"/></TextBlock>
            <ComboBox x:Name="CmbSeller" Grid.Column="1" FontSize="11" Width="240" HorizontalAlignment="Left" Height="26"
                      DisplayMemberPath="full_name" SelectedValuePath="id_seller"
                      HorizontalContentAlignment="Left" ToolTip="Seleccione el vendedor"
                      SelectionChanged="OnSellerChanged"/>
        </Grid>

        <!-- FECHA DE LA NOTA DE ENTREGA: desplegable de meses (solo devolucion) -->
        <Grid Grid.Row="3" x:Name="FechaRow" Margin="0,0,0,6">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="170"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0" VerticalAlignment="Center"><Run Text="Mes de la Nota:"/><Run Text="*" Foreground="Red"/></TextBlock>
            <ComboBox x:Name="CmbMonth" Grid.Column="1" FontSize="11" Width="150" HorizontalAlignment="Left" Height="26"
                      HorizontalContentAlignment="Center" ToolTip="Seleccione primero un vendedor..."
                      IsEnabled="False"
                      SelectionChanged="OnMonthSelected"/>
        </Grid>

        <!-- BUSCADOR DE NOTA: busca entre las notas del vendedor seleccionado (solo devolucion) -->
        <Grid Grid.Row="4" x:Name="BuscadorRow" Margin="0,0,0,6">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="170"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0" VerticalAlignment="Center"><Run Text="Nota de Entrega:"/><Run Text="*" Foreground="Red"/></TextBlock>
            <Grid Grid.Column="1" Margin="0,0,8,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBox x:Name="NoteTextBox" Grid.Column="0" Height="26" FontSize="11" VerticalContentAlignment="Center"
                         IsEnabled="False" TextChanged="OnNoteSearchChanged" ToolTip="Seleccione primero un mes para buscar notas..."/>
                <Button x:Name="BtnToggleDropdown" Grid.Column="1" Content="&#x25BC;" Width="24" Height="26"
                        FontSize="9" Cursor="Hand" Click="OnToggleDropdown" IsEnabled="False"
                        Background="#F5F5F5" Foreground="#757575" BorderBrush="#BDBDBD" BorderThickness="1,0,0,0"
                        VerticalAlignment="Center" ToolTip="Ver notas del mes seleccionado">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="bd" Background="{TemplateBinding Background}" Padding="0"
                                    BorderThickness="{TemplateBinding BorderThickness}" BorderBrush="{TemplateBinding BorderBrush}">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="bd" Property="Background" Value="#E0E0E0"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Button.Template>
                </Button>
                <Button x:Name="BtnClearNote" Grid.Column="2" Content="&#x2715;" Width="24" Height="26"
                        FontSize="9" Cursor="Hand" Click="OnClearNoteClick" Visibility="Collapsed"
                        Background="#F5F5F5" Foreground="#C62828" BorderBrush="#BDBDBD" BorderThickness="1,0,0,0"
                        VerticalAlignment="Center" ToolTip="Limpiar nota seleccionada">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="bd" Background="{TemplateBinding Background}" Padding="0"
                                    BorderThickness="{TemplateBinding BorderThickness}" BorderBrush="{TemplateBinding BorderBrush}">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="bd" Property="Background" Value="#FFCDD2"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Button.Template>
                </Button>
                <Popup x:Name="NotePopup" IsOpen="False" AllowsTransparency="True"
                       PlacementTarget="{Binding ElementName=NoteTextBox}" Placement="Bottom"
                       MaxHeight="220" PopupAnimation="Fade" StaysOpen="False"
                       HorizontalOffset="0">
                    <Border Background="White" BorderBrush="#BDBDBD" BorderThickness="1"
                            Width="{Binding ActualWidth, ElementName=NoteTextBox}">
                        <ListBox x:Name="NoteListBox" BorderThickness="0"
                                 SelectionChanged="OnNoteListSelected"
                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="4,2">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="85"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="{Binding note_number}" FontWeight="Bold" FontSize="11" Foreground="#C62828"/>
                                        <TextBlock Grid.Column="1" Text="{Binding customer_name}" FontSize="11" TextTrimming="CharacterEllipsis"/>
                                        <Border Grid.Column="2" Background="#ECEFF1" CornerRadius="3" Padding="5,1" Margin="6,0,0,0">
                                            <TextBlock Text="{Binding note_type}" FontSize="10" Foreground="#37474F" FontWeight="SemiBold"/>
                                        </Border>
                                    </Grid>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </Border>
                </Popup>
            </Grid>
        </Grid>

        <!-- CLIENTE: solo obsequio (buscador por nombre, codigo o rif de los clientes del vendedor) -->
        <Grid Grid.Row="5" x:Name="ClienteRow" Visibility="Collapsed" Margin="0,0,0,6">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="170"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0" VerticalAlignment="Center"><Run Text="Cliente:"/><Run Text="*" Foreground="Red"/></TextBlock>
            <Grid Grid.Column="1" Margin="0,0,8,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBox x:Name="CustomerTextBox" Grid.Column="0" Height="26" FontSize="11" VerticalContentAlignment="Center"
                         IsEnabled="False" TextChanged="OnCustomerSearchChanged" ToolTip="Escriba el nombre o codigo del cliente..."/>
                <Button x:Name="BtnToggleCustomerDropdown" Grid.Column="1" Content="&#x25BC;" Width="24" Height="26"
                        FontSize="9" Cursor="Hand" Click="OnToggleCustomerDropdown"
                        Background="#F5F5F5" Foreground="#757575" BorderBrush="#BDBDBD" BorderThickness="1,0,0,0"
                        VerticalAlignment="Center" ToolTip="Ver clientes del vendedor">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="bd" Background="{TemplateBinding Background}" Padding="0"
                                    BorderThickness="{TemplateBinding BorderThickness}" BorderBrush="{TemplateBinding BorderBrush}">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="bd" Property="Background" Value="#E0E0E0"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Button.Template>
                </Button>
                <Button x:Name="BtnClearCustomer" Grid.Column="2" Content="&#x2715;" Width="24" Height="26"
                        FontSize="9" Cursor="Hand" Click="OnClearCustomerClick" Visibility="Collapsed"
                        Background="#F5F5F5" Foreground="#C62828" BorderBrush="#BDBDBD" BorderThickness="1,0,0,0"
                        VerticalAlignment="Center" ToolTip="Quitar cliente seleccionado">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="bd" Background="{TemplateBinding Background}" Padding="0"
                                    BorderThickness="{TemplateBinding BorderThickness}" BorderBrush="{TemplateBinding BorderBrush}">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="bd" Property="Background" Value="#FFCDD2"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Button.Template>
                </Button>
                <Popup x:Name="CustomerPopup" IsOpen="False" AllowsTransparency="True"
                       PlacementTarget="{Binding ElementName=CustomerTextBox}" Placement="Bottom"
                       MaxHeight="220" PopupAnimation="Fade" StaysOpen="False"
                       HorizontalOffset="0">
                    <Border Background="White" BorderBrush="#BDBDBD" BorderThickness="1"
                            Width="{Binding ActualWidth, ElementName=CustomerTextBox}">
                        <ListBox x:Name="CustomerListBox" BorderThickness="0"
                                 SelectionChanged="OnCustomerSelected"
                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="4,2">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="80"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="{Binding customer_code}" FontWeight="Bold" FontSize="11" Foreground="#C62828"/>
                                        <TextBlock Grid.Column="1" Text="{Binding business_name}" FontSize="11" TextTrimming="CharacterEllipsis"/>
                                        <TextBlock Grid.Column="2" Text="{Binding rif}" FontSize="10" Foreground="#757575" Margin="8,0,0,0"/>
                                    </Grid>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </Border>
                </Popup>
            </Grid>
        </Grid>

        <!-- PRODUCTO: solo obsequio (buscador para agregar productos individualmente) -->
        <Grid Grid.Row="6" x:Name="ProductSearchRow" Visibility="Collapsed" Margin="0,0,0,6">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="170"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0" VerticalAlignment="Center">
                <Run Text="Buscar Producto a Obsequiar:"/>
            </TextBlock>
            <Grid Grid.Column="1" Margin="0,0,8,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBox x:Name="ProductSearchTextBox" Grid.Column="0" Height="26" FontSize="11" VerticalContentAlignment="Center"
                         TextChanged="OnProductSearchChanged" ToolTip="Escriba codigo o nombre del producto para agregarlo..."/>
                <Button x:Name="BtnToggleProductDropdown" Grid.Column="1" Content="&#x25BC;" Width="24" Height="26"
                        FontSize="9" Cursor="Hand" Click="OnToggleProductDropdown"
                        Background="#F5F5F5" Foreground="#757575" BorderBrush="#BDBDBD" BorderThickness="1,0,0,0"
                        VerticalAlignment="Center" ToolTip="Ver todos los productos disponibles con stock">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="bd" Background="{TemplateBinding Background}" Padding="0"
                                    BorderThickness="{TemplateBinding BorderThickness}" BorderBrush="{TemplateBinding BorderBrush}">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="bd" Property="Background" Value="#E0E0E0"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Button.Template>
                </Button>
                <Popup x:Name="ProductPopup" IsOpen="False" AllowsTransparency="True"
                       PlacementTarget="{Binding ElementName=ProductSearchTextBox}" Placement="Bottom"
                       MaxHeight="220" PopupAnimation="Fade" StaysOpen="False"
                       HorizontalOffset="0">
                    <Border Background="White" BorderBrush="#BDBDBD" BorderThickness="1"
                            Width="{Binding ActualWidth, ElementName=ProductSearchTextBox}">
                        <ListBox x:Name="ProductListBox" BorderThickness="0"
                                 SelectionChanged="OnProductSelected"
                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="4,2">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="90"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="80"/>
                                            <ColumnDefinition Width="80"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="{Binding product_code}" FontWeight="Bold" FontSize="11" Foreground="#1565C0"/>
                                        <TextBlock Grid.Column="1" Text="{Binding name}" FontSize="11" TextTrimming="CharacterEllipsis"/>
                                        <StackPanel Grid.Column="2" Orientation="Horizontal" HorizontalAlignment="Right">
                                            <TextBlock Text="Stock: " FontSize="10" Foreground="#757575"/>
                                            <TextBlock Text="{Binding stock_quantity}" FontWeight="Bold" FontSize="10.5" Foreground="#2E7D32"/>
                                        </StackPanel>
                                        <TextBlock Grid.Column="3" Text="{Binding unit_price_usd, StringFormat={}{0:N2} USD}"
                                                   FontSize="10" Foreground="#616161" HorizontalAlignment="Right" Margin="8,0,4,0"/>
                                    </Grid>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </Border>
                </Popup>
            </Grid>
        </Grid>

        <!-- INFO DE NOTA DE ENTREGA (solo devolucion) -->
        <Border Grid.Row="7" x:Name="NoteInfoBorder" Background="#FDECEA" CornerRadius="3" Padding="8" Margin="0,0,0,6">
            <StackPanel>
                <TextBlock x:Name="CustomerText" FontSize="11" Foreground="#C62828" FontWeight="SemiBold"/>
                <TextBlock x:Name="SellerText" FontSize="11" Foreground="#424242" Margin="0,2,0,0"/>
                <TextBlock x:Name="NoteInfoText" FontSize="11" Foreground="#424242" Margin="0,2,0,0" FontWeight="SemiBold"/>
            </StackPanel>
        </Border>

        <!-- BANDA DE GRUPOS DE COLUMNAS -->
        <Grid Grid.Row="8" x:Name="BandGrid" Height="22" Margin="0,0,0,2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="90"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="90"/>
                <ColumnDefinition Width="70"/>
                <ColumnDefinition Width="70"/>
                <ColumnDefinition Width="70"/>
                <ColumnDefinition Width="85"/>
                <ColumnDefinition Width="95"/>
            </Grid.ColumnDefinitions>
            <Border Grid.Column="0" Grid.ColumnSpan="2" Background="#EEEEEE" BorderBrush="#BDBDBD" BorderThickness="1,1,0,0">
                <TextBlock Text="INFORMACION DEL PRODUCTO" FontSize="9" FontWeight="SemiBold" Foreground="#616161"
                           VerticalAlignment="Center" HorizontalAlignment="Center"/>
            </Border>
            <Border Grid.Column="2" Background="#EF6C00" BorderBrush="#EF6C00" BorderThickness="1">
                <TextBlock x:Name="BandReturnText" Text="A DEVOLVER" FontSize="9" FontWeight="Bold" Foreground="White"
                           VerticalAlignment="Center" HorizontalAlignment="Center"/>
            </Border>
            <Border Grid.Column="3" Grid.ColumnSpan="3" Background="#1976D2" BorderBrush="#1976D2" BorderThickness="1">
                <TextBlock x:Name="BandQuantitiesText" Text="CANTIDADES DE LA NOTA" FontSize="9" FontWeight="Bold" Foreground="White"
                           VerticalAlignment="Center" HorizontalAlignment="Center"/>
            </Border>
            <Border Grid.Column="6" Grid.ColumnSpan="2" Background="#2E7D32" BorderBrush="#2E7D32" BorderThickness="1">
                <TextBlock Text="IMPORTES" FontSize="9" FontWeight="Bold" Foreground="White"
                           VerticalAlignment="Center" HorizontalAlignment="Center"/>
            </Border>
        </Grid>

        <!-- TABLA DE ITEMS -->
        <DataGrid Grid.Row="9" x:Name="ItemsGrid" AutoGenerateColumns="False" IsReadOnly="False"
                  HeadersVisibility="Column" GridLinesVisibility="Horizontal"
                  Background="White" BorderThickness="1" BorderBrush="#BDBDBD"
                  RowHeight="28" FontSize="11" SelectionMode="Single"
                  CanUserResizeColumns="False" CanUserReorderColumns="False"
                  CellEditEnding="OnCellEditEnding">
            <DataGrid.Resources>
                <Style TargetType="DataGridColumnHeader">
                    <Setter Property="Background" Value="#C62828"/>
                    <Setter Property="Foreground" Value="White"/>
                    <Setter Property="FontWeight" Value="Bold"/>
                    <Setter Property="FontSize" Value="10.5"/>
                    <Setter Property="Padding" Value="3,0"/>
                    <Setter Property="BorderBrush" Value="#C62828"/>
                </Style>
                <Style x:Key="EditableHeaderStyle" TargetType="DataGridColumnHeader" BasedOn="{StaticResource {x:Type DataGridColumnHeader}}">
                    <Setter Property="Background" Value="#EF6C00"/>
                    <Setter Property="BorderBrush" Value="#EF6C00"/>
                </Style>
            </DataGrid.Resources>
            <DataGrid.Columns>
                <DataGridTextColumn Header="CODIGO" Binding="{Binding code}" Width="90" IsReadOnly="True">
                    <DataGridTextColumn.ElementStyle>
                        <Style TargetType="TextBlock">
                            <Setter Property="VerticalAlignment" Value="Center"/>
                            <Setter Property="FontSize" Value="10"/>
                            <Setter Property="Foreground" Value="#616161"/>
                        </Style>
                    </DataGridTextColumn.ElementStyle>
                </DataGridTextColumn>
                <DataGridTextColumn Header="DESCRIPCION" Binding="{Binding name}" Width="*" IsReadOnly="True">
                    <DataGridTextColumn.ElementStyle>
                        <Style TargetType="TextBlock">
                            <Setter Property="VerticalAlignment" Value="Center"/>
                            <Setter Property="Margin" Value="4,0,0,0"/>
                            <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
                        </Style>
                    </DataGridTextColumn.ElementStyle>
                </DataGridTextColumn>
                <DataGridTemplateColumn x:Name="ColReturn" Header="A DEVOLVER" Width="90" HeaderStyle="{StaticResource EditableHeaderStyle}">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <TextBox Text="{Binding return_quantity, UpdateSourceTrigger=PropertyChanged}"
                                     VerticalContentAlignment="Center" FontSize="11" FontWeight="SemiBold"
                                     HorizontalAlignment="Stretch" Margin="3,2"
                                     TextAlignment="Center" PreviewTextInput="OnQuantityPreviewTextInput"/>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTextColumn x:Name="ColDelivered" Header="ENTREGADO" Binding="{Binding delivered_quantity}" Width="70" IsReadOnly="True">
                    <DataGridTextColumn.ElementStyle>
                        <Style TargetType="TextBlock">
                            <Setter Property="VerticalAlignment" Value="Center"/>
                            <Setter Property="HorizontalAlignment" Value="Right"/>
                            <Setter Property="Margin" Value="0,0,6,0"/>
                            <Setter Property="FontSize" Value="10"/>
                        </Style>
                    </DataGridTextColumn.ElementStyle>
                </DataGridTextColumn>
                <DataGridTextColumn x:Name="ColReturned" Header="DEVUELTO" Binding="{Binding already_returned_quantity}" Width="70" IsReadOnly="True">
                    <DataGridTextColumn.ElementStyle>
                        <Style TargetType="TextBlock">
                            <Setter Property="VerticalAlignment" Value="Center"/>
                            <Setter Property="HorizontalAlignment" Value="Right"/>
                            <Setter Property="Margin" Value="0,0,6,0"/>
                            <Setter Property="FontSize" Value="10"/>
                        </Style>
                    </DataGridTextColumn.ElementStyle>
                </DataGridTextColumn>
                <DataGridTextColumn Header="DISPONIBLE" Binding="{Binding remaining_quantity}" Width="70" IsReadOnly="True">
                    <DataGridTextColumn.ElementStyle>
                        <Style TargetType="TextBlock">
                            <Setter Property="VerticalAlignment" Value="Center"/>
                            <Setter Property="HorizontalAlignment" Value="Right"/>
                            <Setter Property="Margin" Value="0,0,6,0"/>
                            <Setter Property="FontSize" Value="10"/>
                            <Setter Property="Foreground" Value="#2E7D32"/>
                            <Setter Property="FontWeight" Value="SemiBold"/>
                        </Style>
                    </DataGridTextColumn.ElementStyle>
                </DataGridTextColumn>
                <DataGridTextColumn Header="PRECIO U." Binding="{Binding unit_price_usd, StringFormat=N2}" Width="85" IsReadOnly="True">
                    <DataGridTextColumn.ElementStyle>
                        <Style TargetType="TextBlock">
                            <Setter Property="VerticalAlignment" Value="Center"/>
                            <Setter Property="HorizontalAlignment" Value="Right"/>
                            <Setter Property="Margin" Value="0,0,6,0"/>
                            <Setter Property="FontSize" Value="10"/>
                        </Style>
                    </DataGridTextColumn.ElementStyle>
                </DataGridTextColumn>
                <DataGridTextColumn Header="SUBTOTAL" Binding="{Binding subtotal_usd, StringFormat=N2}" Width="95" IsReadOnly="True">
                    <DataGridTextColumn.ElementStyle>
                        <Style TargetType="TextBlock">
                            <Setter Property="HorizontalAlignment" Value="Right"/>
                            <Setter Property="Margin" Value="0,0,6,0"/>
                            <Setter Property="FontSize" Value="10"/>
                            <Setter Property="FontWeight" Value="SemiBold"/>
                        </Style>
                    </DataGridTextColumn.ElementStyle>
                </DataGridTextColumn>
                <DataGridTemplateColumn x:Name="ColAction" Header="ACCION" Width="55" Visibility="Collapsed">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <Button Content="&#x2715;" Background="#FFCDD2" Foreground="#C62828"
                                    BorderThickness="0" Width="20" Height="20" Cursor="Hand"
                                    FontWeight="Bold" FontSize="10" HorizontalAlignment="Center"
                                    VerticalAlignment="Center" ToolTip="Quitar producto del obsequio"
                                    Click="OnRemoveGiftRowClick" Tag="{Binding}">
                                <Button.Template>
                                    <ControlTemplate TargetType="Button">
                                        <Border x:Name="bd" Background="{TemplateBinding Background}" CornerRadius="3">
                                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="bd" Property="Background" Value="#EF9A9A"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Button.Template>
                            </Button>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
            </DataGrid.Columns>
        </DataGrid>

        <TextBlock Grid.Row="10" x:Name="HintText" FontSize="9.5" Foreground="#757575" Margin="2,2,0,0"
                   Text="Escriba arriba la cantidad devuelta de cada producto. No puede superar la columna DISPONIBLE."/>

        <Grid Grid.Row="11" Margin="0,6,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0" x:Name="TotalLabel" FontSize="12" FontWeight="Bold" Foreground="#C62828"
                       VerticalAlignment="Center">
                <Run Text="TOTAL A DEVOLVER (USD):"/>
            </TextBlock>
            <Border Grid.Column="1" Background="#FDECEA" CornerRadius="3" Padding="12,4">
                <TextBlock x:Name="TotalText" FontSize="14" FontWeight="Bold" Foreground="#C62828"
                           HorizontalAlignment="Right" Text="0.00"/>
            </Border>
        </Grid>

        <Grid Grid.Row="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="110"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0" VerticalAlignment="Top" Margin="0,4,0,0" Text="Observaciones:"/>
            <TextBox x:Name="ObsBox" Grid.Column="1" Height="48" FontSize="11" TextWrapping="Wrap"
                     AcceptsReturn="True" VerticalContentAlignment="Top" VerticalScrollBarVisibility="Auto"/>
        </Grid>

        <StackPanel Grid.Row="13" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
            <Button x:Name="BtnSavePdf" Content="Guardar y PDF" Height="30" Padding="14,0" Margin="0,0,8,0"
                    Background="#C62828" Foreground="White" BorderThickness="0" Cursor="Hand"
                    FontWeight="SemiBold" Click="OnSavePdfClick"/>
            <Button x:Name="BtnSave" Content="Guardar" Height="30" Padding="14,0" Margin="0,0,8,0"
                    Background="#2E7D32" Foreground="White" BorderThickness="0" Cursor="Hand"
                    FontWeight="SemiBold" Click="OnSaveClick"/>
            <Button Content="Cancelar" Height="30" Padding="14,0"
