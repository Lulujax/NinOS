<Window x:Class="NinOS.UI.Views.AppDialogWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="NinOS"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ResizeMode="NoResize" ShowInTaskbar="False"
        SizeToContent="WidthAndHeight" MaxWidth="600">
    <Window.Resources>
        <Style x:Key="DialogButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#22282F" />
            <Setter Property="Foreground" Value="#E8EDEA" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Padding" Value="18,9" />
            <Setter Property="MinWidth" Value="90" />
            <Setter Property="Margin" Value="8,0,0,0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="BorderThickness" Value="0" />
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#2F3942" />
                </Trigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="DialogPrimaryStyle" TargetType="Button" BasedOn="{StaticResource DialogButtonStyle}">
            <Setter Property="Background" Value="#C9A227" />
            <Setter Property="Foreground" Value="#161A1F" />
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#D9B53B" />
                </Trigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <Border Background="#161A1F" CornerRadius="14" BorderBrush="#2A3138" BorderThickness="1" Margin="10">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="6" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Border Grid.Row="0" x:Name="AccentBar" Background="#C9A227" CornerRadius="14,14,0,0" />

            <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="22,18,22,0">
                <Border x:Name="IconBadge" Width="46" Height="46" CornerRadius="23" Background="#22282F"
                        VerticalAlignment="Top">
                    <TextBlock x:Name="IconGlyph" Text="!" FontSize="26" FontWeight="Bold"
                               Foreground="#C9A227" HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Border>
                <StackPanel Margin="16,0,0,0" VerticalAlignment="Center">
                    <TextBlock x:Name="TitleText" FontSize="16" FontWeight="SemiBold" Foreground="#FFFFFF"
                               TextWrapping="Wrap" />
                    <TextBlock x:Name="MessageText" FontSize="13" Foreground="#C9D6CF" TextWrapping="Wrap"
                               Margin="0,8,0,0" MaxWidth="420" />
                </StackPanel>
            </StackPanel>

            <StackPanel Grid.Row="2" x:Name="ButtonPanel" Orientation="Horizontal"
                        HorizontalAlignment="Right" Margin="0,24,22,18" />
        </Grid>
    </Border>
</Window>