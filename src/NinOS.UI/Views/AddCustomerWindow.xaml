<Window x:Class="NinOS.UI.Views.AddCustomerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{Binding AddOrEditTitle}" Width="520"
        Height="560" ResizeMode="CanResize"
        MinHeight="380" MinWidth="440" MaxWidth="900"
        WindowStartupLocation="CenterOwner">
    <!-- Scroll interno: si el usuario achica la ventana, el formulario se desplaza con la barra
         en vez de quedar recortado. CanContentScroll=False para que el arrastre sea por pixel. -->
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                  Focusable="False">
    <Grid Margin="16,12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" FontWeight="Bold" Margin="0,0,0,5"><Run Text="Codigo del Cliente"/><Run Text=" *" Foreground="Red"/></TextBlock>
        <TextBox Grid.Row="1" Text="{Binding NewCustomerCode}" IsReadOnly="True" Background="#F0F0F0" Padding="5" Margin="0,0,0,10"/>

        <TextBlock Grid.Row="2" FontWeight="Bold" Margin="0,0,0,5"><Run Text="Razon Social (Negocio/Nombre)"/><Run Text=" *" Foreground="Red"/></TextBlock>
        <TextBox Grid.Row="3" Text="{Binding NewBusinessName, UpdateSourceTrigger=PropertyChanged}" Padding="5" Margin="0,0,0,10"/>

        <TextBlock Grid.Row="4" FontWeight="Bold" Margin="0,0,0,5"><Run Text="Identificacion"/><Run Text=" *" Foreground="Red"/></TextBlock>
        <Grid Grid.Row="5" Margin="0,0,0,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="80"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <ComboBox Grid.Column="0" ItemsSource="{Binding RifTypeOptions}" SelectedItem="{Binding NewRifType}" Padding="5" Margin="0,0,5,0"/>
            <TextBox Grid.Column="1" Text="{Binding NewRifNumber, UpdateSourceTrigger=PropertyChanged}" Padding="5"/>
        </Grid>

        <TextBlock Grid.Row="6" Text="Nombre de Contacto" FontWeight="Bold" Margin="0,0,0,5"/>
        <TextBox Grid.Row="7" Text="{Binding NewContactName, UpdateSourceTrigger=PropertyChanged}" Padding="5" Margin="0,0,0,10"/>

        <TextBlock Grid.Row="8" Text="Telefono" FontWeight="Bold" Margin="0,0,0,5"/>
        <TextBox Grid.Row="9" Text="{Binding NewPhoneNumber, UpdateSourceTrigger=PropertyChanged}" Padding="5" Margin="0,0,0,10"/>

        <TextBlock Grid.Row="10" Text="Direccion Fiscal" FontWeight="Bold" Margin="0,0,0,5"/>
            <TextBox Grid.Row="11" Text="{Binding NewFiscalAddress, UpdateSourceTrigger=PropertyChanged}" Padding="5" Margin="0,0,0,8" TextWrapping="Wrap" Height="42" AcceptsReturn="True"/>

        <TextBlock Grid.Row="12" Text="Direccion de Entrega" FontWeight="Bold" Margin="0,0,0,5"/>
            <TextBox Grid.Row="13" Text="{Binding NewDeliveryAddress, UpdateSourceTrigger=PropertyChanged}" Padding="5" Margin="0,0,0,8" TextWrapping="Wrap" Height="42" AcceptsReturn="True"/>

        <TextBlock Grid.Row="14" Text="Zona *" FontWeight="Bold" Margin="0,0,0,5"/>
            <ComboBox Grid.Row="15" ItemsSource="{Binding ZonasOptions}" SelectedValuePath="id_zona" SelectedValue="{Binding NewZonaId}" DisplayMemberPath="name"  Padding="5" Margin="0,0,0,12"/>

        <TextBlock Grid.Row="16" Text="{Binding ErrorMessage}" Foreground="Red" FontWeight="Bold" Margin="0,0,0,5" Visibility="{Binding ErrorMessage, Converter={StaticResource StringToVisibilityConverter}}"/>

        <StackPanel Grid.Row="17" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,0,0,0">
            <Button Content="{Binding SaveButtonText}" Command="{Binding SaveCustomerCommand}" Background="#0078D7" Foreground="White" FontWeight="Bold" Padding="15,8" Cursor="Hand" Margin="0,0,10,0"/>
            <Button Content="Cancelar" Click="CancelButton_Click" Background="#6C757D" Foreground="White" Padding="15,8" Cursor="Hand"/>
        </StackPanel>
    </Grid>
    </ScrollViewer>
</Window>
