<Window x:Class="NinOS.UI.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:NinOS.UI.Views"
        Title="NinOS v1.0.10 - Sistema Administrativo" Height="720" Width="1280" WindowState="Maximized" WindowStartupLocation="CenterScreen"
        Icon="/Assets/ninOS_logo.png"
        PreviewKeyDown="Window_PreviewKeyDown">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Border x:Name="TitleBar" Grid.Row="0" Background="#1B3A2D" Padding="8,4" MouseLeftButtonUp="TitleBar_MouseLeftButtonUp">
            <TextBlock Text="NinOS v1.0.10" FontSize="13" FontWeight="Bold"
                       Foreground="White" VerticalAlignment="Center" />
        </Border>

        <Border x:Name="UpdateBanner" Grid.Row="1" Background="#FFF3E0" BorderBrush="#E65100" BorderThickness="0,0,0,1" Padding="10,6"
                Visibility="{Binding update_banner_visible, Converter={StaticResource BooleanToVisibilityConverter}}">
            <DockPanel>
                <Button DockPanel.Dock="Right" Content="Actualizar ahora" Click="OnUpdateNowClick" Padding="12,3" Margin="8,0,0,0"
                        Background="#E65100" Foreground="White" BorderThickness="0" Cursor="Hand" FontWeight="SemiBold"/>
                <TextBlock Text="{Binding update_banner_text}" VerticalAlignment="Center" TextWrapping="Wrap"
                           Foreground="#4E342E" FontWeight="SemiBold"/>
            </DockPanel>
        </Border>

        <TabControl x:Name="MainTabControl" Grid.Row="2" Margin="10" IsEnabled="{Binding work_allowed}" SelectionChanged="TabControl_SelectionChanged"
                    PreviewMouseLeftButtonDown="MainTabControl_PreviewMouseLeftButtonDown"
                    PreviewKeyDown="MainTabControl_PreviewKeyDown">
<TabItem Header="Notas de Entrega">
                <views:DeliveryNotesView DataContext="{Binding delivery_notes_vm}" />
            </TabItem>
            <TabItem Header="Vendedores">
                <views:SellersView DataContext="{Binding sellers_vm}" />
            </TabItem>
            <TabItem Header="Clientes">
                <views:CustomerView DataContext="{Binding customer_vm}" />
            </TabItem>
            <TabItem Header="Ventas">
                <views:SalesView DataContext="{Binding sales_vm}" />
            </TabItem>
            <TabItem Header="Cuentas por Cobrar">
                <views:AccountsReceivableView DataContext="{Binding accounts_receivable_vm}"
                                               PaymentsContext="{Binding DataContext.payments_vm, RelativeSource={RelativeSource AncestorType=Window}}" />
            </TabItem>
            <TabItem Header="Pagos">
                <views:PaymentsView DataContext="{Binding payments_vm}" />
            </TabItem>
            <TabItem Header="Comisiones">
                <views:CommissionsView DataContext="{Binding commissions_vm}"
                                        PaymentsContext="{Binding DataContext.payments_vm, RelativeSource={RelativeSource AncestorType=Window}}" />
            </TabItem>
            <TabItem Header="Inventario">
                <views:InventoryView DataContext="{Binding inventory_vm}" />
            </TabItem>
            <TabItem Header="Notas de Credito">
                <views:CreditNotesView DataContext="{Binding credit_notes_vm}" />
            </TabItem>
            <TabItem Header="Pro Venta">
                <views:ProVentaView DataContext="{Binding pro_venta_vm}" />
            </TabItem>
        </TabControl>
    </Grid>
</Window>