<Window x:Class="NinOS.UI.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:NinOS.UI.Views"
        Title="NinOS - Sistema Administrativo" Height="720" Width="1280" WindowStartupLocation="CenterScreen">
    
    <Grid>
        <TabControl x:Name="MainTabControl" Margin="10" SelectionChanged="TabControl_SelectionChanged">
            <TabItem Header="Notas de Entrega">
                <views:DeliveryNotesView DataContext="{Binding delivery_notes_vm}" />
            </TabItem>
            <TabItem Header="Cuentas por Cobrar">
                <views:AccountsReceivableView DataContext="{Binding accounts_receivable_vm}" />
            </TabItem>
            <TabItem Header="Ventas">
                <views:SalesView DataContext="{Binding sales_vm}" />
            </TabItem>
            <TabItem Header="Pagos">
                <views:PaymentsView DataContext="{Binding payments_vm}" />
            </TabItem>
            <TabItem Header="Comisiones">
                <views:CommissionsView DataContext="{Binding commissions_vm}" />
            </TabItem>
            <TabItem Header="Clientes">
                <views:CustomerView DataContext="{Binding customer_vm}" />
            </TabItem>
            <TabItem Header="Inventario">
                <views:InventoryView DataContext="{Binding inventory_vm}" />
            </TabItem>
        </TabControl>
    </Grid>
</Window>