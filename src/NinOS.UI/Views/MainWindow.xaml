<Window x:Class="NinOS.UI.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:NinOS.UI.Views"
        xmlns:common_viewmodels="clr-namespace:NinOS.UI.Common.ViewModels"
        Title="NinOS - Sistema Administrativo" Height="720" Width="1280" WindowStartupLocation="CenterScreen">
    
    <Window.Resources>
        <DataTemplate DataType="{x:Type common_viewmodels:DeliveryNotesViewModel}">
            <views:DeliveryNotesView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type common_viewmodels:AccountsReceivableViewModel}">
            <views:AccountsReceivableView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type common_viewmodels:SalesViewModel}">
            <views:SalesView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type common_viewmodels:PaymentsViewModel}">
            <views:PaymentsView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type common_viewmodels:CommissionsViewModel}">
            <views:CommissionsView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type common_viewmodels:CustomerViewModel}">
            <views:CustomerView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type common_viewmodels:InventoryViewModel}">
            <views:InventoryView />
        </DataTemplate>
    </Window.Resources>

    <Grid>
        <TabControl Margin="10">
            <TabItem Header="Notas de Entrega" Content="{Binding delivery_notes_vm}" />
            <TabItem Header="Cuentas por Cobrar" Content="{Binding accounts_receivable_vm}" />
            <TabItem Header="Ventas" Content="{Binding sales_vm}" />
            <TabItem Header="Pagos" Content="{Binding payments_vm}" />
            <TabItem Header="Comisiones" Content="{Binding commissions_vm}" />
            <TabItem Header="Clientes" Content="{Binding customer_vm}" />
            <TabItem Header="Inventario" Content="{Binding inventory_vm}" />
        </TabControl>
    </Grid>
</Window>