<Window x:Class="NinOS.UI.Views.StockSearchWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Buscar Producto" Height="500" Width="650"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        Background="#F5F5F5">
    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <TextBlock Grid.Row="0" Text="BUSCAR PRODUCTO PARA AJUSTAR STOCK" FontWeight="Bold" FontSize="13" Foreground="#1B3A2D" Margin="0,0,0,8"/>
        <Border Grid.Row="1" Background="White" CornerRadius="4" BorderBrush="#E0E0E0" BorderThickness="1" Margin="0,0,0,8">
            <Grid>
                <TextBlock Text="🔍" Margin="8,0,0,0" VerticalAlignment="Center" FontSize="13" Foreground="#9E9E9E"/>
                <TextBox x:Name="SearchBox" Margin="28,4,8,4" BorderThickness="0" Background="Transparent" VerticalContentAlignment="Center" FontSize="12" TextChanged="SearchBox_TextChanged"/>
            </Grid>
        </Border>
        <DataGrid Grid.Row="2" x:Name="ProductsGrid" AutoGenerateColumns="False" IsReadOnly="True" SelectionMode="Single" GridLinesVisibility="Horizontal" HeadersVisibility="Column" MouseDoubleClick="ProductsGrid_MouseDoubleClick">
            <DataGrid.Columns>
                <DataGridTextColumn Header="CÓDIGO" Binding="{Binding product_code}" Width="100"/>
                <DataGridTextColumn Header="NOMBRE" Binding="{Binding name}" Width="*"/>
                <DataGridTextColumn Header="MARCA" Binding="{Binding category}" Width="120"/>
                <DataGridTextColumn Header="STOCK ACTUAL" Binding="{Binding stock_quantity}" Width="110"/>
                <DataGridTextColumn Header="PRECIO" Binding="{Binding unit_price_usd, StringFormat=N2}" Width="90"/>
            </DataGrid.Columns>
        </DataGrid>
        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
            <Button Content="Seleccionar" Height="30" Padding="18,0" Margin="0,0,8,0" Background="#2E7D32" Foreground="White" BorderThickness="0" Click="Select_Click"/>
            <Button Content="Cancelar" Height="30" Padding="18,0" Click="Cancel_Click" Background="#E0E0E0" Foreground="#424242" BorderThickness="1" BorderBrush="#BDBDBD"/>
        </StackPanel>
    </Grid>
</Window>
